{
  "name": "RedlineCounty",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 196.2,
        "StreamingEnabled": true,
        "StreamingMinRadius": 256,
        "StreamingTargetRadius": 1536
      },
      "HopedaleGenerated": {
        "$path": "assets/generated/Hopedale.rbxmx"
      },
      "HopedaleLandmarks": {
        "$path": "assets/generated/HopedaleLandmarks.rbxmx"
      },
      "Handcrafted": {
        "$path": "assets/handcrafted"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 16,
        "Brightness": 2,
        "Ambient": [
          0.35,
          0.36,
          0.37
        ],
        "OutdoorAmbient": [
          0.5,
          0.51,
          0.52
        ],
        "GlobalShadows": true,
        "ExposureCompensation": 0.1,
        "FogColor": [
          0.05,
          0.06,
          0.09
        ],
        "FogStart": 4000,
        "FogEnd": 12000,
        "ExtendLightRangeTo120": "Enabled",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      },
      "NightBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.12,
          "Size": 20,
          "Threshold": 1.5
        }
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "AssetService": {
      "$className": "AssetService",
      "$properties": {
        "AllowInsertFreeAssets": true
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "VehicleAssets": {
        "$path": "assets/vehicles"
      }
    }
  }
}
