# Keep the playable place files; ignore other generated build output.
/build/*
!/build/redline-county.rbxlx
!/build/smoke.rbxlx

# Generated sourcemap and Studio lock files.
/sourcemap.json
*.rbxl.lock
*.rbxlx.lock

# Downloaded development tools and dependency installations.
/.tools/
node_modules/
/Packages/
/ServerPackages/

# Local credentials and environment overrides.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Local agent state, logs, editor recovery files and OS metadata.
/.agents/
/.codex/
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Keep shared .vscode configuration, Roblox source assets, roblox.yml,
# toolchain pins, project manifests and future dependency lockfiles tracked.

# Python GIS caches and interrupted geographic downloads.
__pycache__/
*.pyc
*.download
