      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CrashMath</string>
          <string name="Source"><![CDATA[--!strict
local CrashMath = {}

-- Intersect entry/exit times on separating axes. Used for a moving oriented car
-- against axis-aligned lane traffic, including vertical separation.
function CrashMath.sweep(start: { number }, finish: { number }, halfExtents: { number }): number?
	local first, last = 0, 1
	for axis, extent in halfExtents do
		local origin, delta = start[axis], finish[axis] - start[axis]
		if math.abs(delta) < 1e-8 then
			if math.abs(origin) > extent then
				return nil
			end
		else
			local a, b = (-extent - origin) / delta, (extent - origin) / delta
			if a > b then
				a, b = b, a
			end
			first, last = math.max(first, a), math.min(last, b)
			if first > last then
				return nil
			end
		end
	end
	return first
end

function CrashMath.canBegin(crashed: boolean, contact: boolean): boolean
	return contact and not crashed
end

return CrashMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Driving</string>
          <string name="Source"><![CDATA[--!strict
-- Engine-independent handling math: tested in the standalone Luau runtime.
local Driving = {}
export type Tuning = {
	TopSpeed: number,
	BoostSpeed: number,
	BoostAcceleration: number,
	ReverseSpeed: number,
	Acceleration: number,
	Brake: number,
	Grip: number,
	DriftGrip: number,
	DriftTurn: number,
	DriftMinSpeed: number,
	DriftDrag: number,
	Turn: number,
}

function Driving.finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Driving.validInput(throttle: any, steer: any, drift: any): boolean
	return Driving.finite(throttle)
		and Driving.finite(steer)
		and math.abs(throttle) <= 1
		and math.abs(steer) <= 1
		and type(drift) == "boolean"
end

function Driving.forces(
	speed: number,
	lateral: number,
	throttle: number,
	steer: number,
	drift: boolean,
	tune: Tuning,
	boost: number?
): (number, number, number)
	local pressure = math.clamp(boost or 0, 0, 1)
	local acceleration: number
	if throttle * speed < -3 then
		acceleration = throttle * tune.Brake
	elseif math.abs(throttle) < 0.01 then
		acceleration = -speed * 0.65
	else
		local limit = if throttle > 0 then tune.TopSpeed + pressure * tune.BoostSpeed else tune.ReverseSpeed
		local powerFade = if throttle > 0 then 1 / (1 + (math.abs(speed) / (limit * 0.55)) ^ 2) else 1
		acceleration = throttle
			* powerFade
			* tune.Acceleration
			* (1 + pressure * (tune.BoostAcceleration - 1))
			* math.clamp((limit - math.abs(speed)) / 15, 0, 1)
		-- Aerodynamic slowdown above the available power limit, including turbo cooldown.
		acceleration -= math.sign(speed) * math.max(0, math.abs(speed) - limit) * 0.65
	end
	-- Blend in only while moving forward: parking and reversing stay predictable.
	local slide = if drift then math.clamp((speed - tune.DriftMinSpeed) / 15, 0, 1) else 0
	acceleration -= speed * tune.DriftDrag * slide
	-- Steering tapers at speed, and reverses while backing up. No pivoting at rest.
	local turn = -steer * tune.Turn * math.clamp(speed / 18, -1, 1) / (1 + math.abs(speed) / 130)
	turn *= 1 + (tune.DriftTurn - 1) * slide
	local grip = tune.Grip + (tune.DriftGrip - tune.Grip) * slide
	return acceleration, -lateral * grip, turn
end

function Driving.approach(current: number, target: number, response: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-response * dt))
end

return Driving
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">HeadlightMath</string>
          <string name="Source"><![CDATA[--!strict
local HeadlightMath = {}
export type Tuning = {
	LowRange: number,
	HighRange: number,
	Angle: number,
	Brightness: number,
	FullBeamKmh: number,
}

function HeadlightMath.beam(kmh: number, tune: Tuning): (number, number, number)
	local blend = math.clamp(kmh / tune.FullBeamKmh, 0, 1)
	-- Smoothstep avoids sudden visible changes near the endpoints.
	blend = blend * blend * (3 - 2 * blend)
	return tune.LowRange + (tune.HighRange - tune.LowRange) * blend, tune.Angle, tune.Brightness
end

return HeadlightMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">HighwayMath</string>
          <string name="Source"><![CDATA[--!strict
local HighwayMath = {}

function HighwayMath.wrap(z: number, halfLength: number): number
	return (z + halfLength) % (2 * halfLength) - halfLength
end

function HighwayMath.needed(
	positions: { number },
	length: number,
	radius: number,
	halfLength: number
): { [number]: boolean }
	local result: { [number]: boolean } = {}
	local function add(z: number)
		local center = math.floor(-z / length)
		for index = center - radius, center + radius do
			result[index] = true
		end
	end
	for _, z in positions do
		z = HighwayMath.wrap(z, halfLength)
		add(z)
		-- Prefetch the other side of the recycle point BEFORE a car reaches it.
		if z < -halfLength + length * radius then
			add(z + 2 * halfLength)
		end
		if z > halfLength - length * radius then
			add(z - 2 * halfLength)
		end
	end
	return result
end

function HighwayMath.travel(previousZ: number, nextZ: number, halfLength: number, maxTravel: number): number
	local delta = math.abs(HighwayMath.wrap(nextZ - previousZ, halfLength))
	return if delta <= maxTravel then delta else 0
end

return HighwayMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">ModelFit</string>
          <string name="Source"><![CDATA[--!strict
local ModelFit = {}

-- ScaleTo scales positions about the model pivot, not about the world origin.
-- Apply exactly that transform before the final chassis-centering translation.
function ModelFit.coordinate(position: number, pivot: number, scale: number, offset: number): number
	return pivot + (position - pivot) * scale - offset
end

return ModelFit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure lifecycle decisions shared by server checks and command-line tests.
local Rules = {}
export type Limits = {
	GarageRadius: number,
	StopSpeed: number,
	ResetReach: number,
	FlippedUp: number,
	FlippedSpeed: number,
}
export type Bucket = { tokens: number, updated: number }

function Rules.consume(bucket: Bucket, now: number, rate: number, burst: number): boolean
	bucket.tokens = math.min(burst, bucket.tokens + math.max(0, now - bucket.updated) * rate)
	bucket.updated = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function Rules.canReset(
	speed: number,
	up: number,
	driving: boolean,
	distance: number,
	limits: Limits
): boolean
	return (driving or distance <= limits.ResetReach)
		and (speed <= limits.StopSpeed or (up < limits.FlippedUp and speed <= limits.FlippedSpeed))
end

function Rules.canSpawn(
	distance: number,
	speed: number,
	occupiedByOther: boolean,
	now: number,
	nextSpawn: number,
	limits: Limits
): boolean
	return distance <= limits.GarageRadius
		and speed <= limits.StopSpeed
		and not occupiedByOther
		and now >= nextSpawn
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">TrafficMath</string>
          <string name="Source"><![CDATA[--!strict
local TrafficMath = {}

-- Three lanes each way. Equal speeds within a lane preserve spacing indefinitely.
function TrafficMath.position(
	lane: number,
	slot: number,
	elapsed: number,
	half: number,
	perLane: number
): (number, number, number)
	local direction = if lane <= 3 then -1 else 1
	local offset = (lane - 1) % 3
	local x = (15 + offset * 18) * -direction
	local speed = (90 - offset * 15) * direction
	local start = -180 - lane * 35 + slot * (half * 2 / perLane)
	local z = (start + elapsed * speed + half) % (half * 2) - half
	return x, z, direction
end

return TrafficMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Turbo</string>
          <string name="Source"><![CDATA[--!strict
local Turbo = {}
export type State = { boost: number, heat: number, overheated: boolean }
export type Tuning = {
	SpoolSeconds: number,
	DecaySeconds: number,
	HeatRate: number,
	CoolRate: number,
	RestartHeat: number,
	MinSpeed: number,
}

function Turbo.step(
	state: State,
	dt: number,
	enabled: boolean,
	throttle: number,
	speed: number,
	drift: boolean,
	tune: Tuning
)
	dt = math.clamp(dt, 0, 0.1)
	if state.overheated and state.heat <= tune.RestartHeat then
		state.overheated = false
	end
	local loaded = enabled and not state.overheated and throttle > 0.8 and speed > tune.MinSpeed and not drift
	local target = if loaded then 1 else 0
	local rate = if loaded then 1 / tune.SpoolSeconds else 1 / tune.DecaySeconds
	state.boost += math.clamp(target - state.boost, -dt * rate, dt * rate)
	state.heat =
		math.clamp(state.heat + dt * (if loaded then state.boost * tune.HeatRate else -tune.CoolRate), 0, 1)
	if state.heat >= 1 then
		state.overheated = true
	end
	-- Residual spool is displayed, but supplies no power after disabling, lifting or overheating.
	return if loaded and not state.overheated then state.boost else 0
end

return Turbo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Units</string>
          <string name="Source"><![CDATA[--!strict
-- Roblox standard scale: one stud = 0.28 metres.
local Units = {}
function Units.kmh(studsPerSecond: number): number
	return math.abs(studsPerSecond) * 0.28 * 3.6
end
function Units.mph(studsPerSecond: number): number
	return Units.kmh(studsPerSecond) / 1.609344
end
function Units.fromKmh(kmh: number): number
	return kmh / (0.28 * 3.6)
end
function Units.kilometres(studs: number): number
	return studs * 0.28 / 1000
end
return Units
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
