      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">TownTrafficMath</string>
          <string name="Source"><![CDATA[--!strict
local Nav = require("./RoadNavigation")
local Traffic = {}
export type Route = { points: { Nav.Point }, lengths: { number }, length: number }
function Traffic.route(center: { Nav.Point }, reverse: boolean): Route
	local raw: { Nav.Point } = {}
	for i = 1, #center - 1 do
		table.insert(raw, center[if reverse then #center - i else i])
	end
	local points: { Nav.Point } = {}
	for i, p in raw do
		local before, after = raw[if i == 1 then #raw else i - 1], raw[if i == #raw then 1 else i + 1]
		local l1, l2 = Nav.distance(before, p), Nav.distance(p, after)
		local n1x, n1z = -(p.z - before.z) / l1, (p.x - before.x) / l1
		local n2x, n2z = -(after.z - p.z) / l2, (after.x - p.x) / l2
		local nx, nz = n1x + n2x, n1z + n2z
		local m = math.sqrt(nx * nx + nz * nz)
		if m < 0.01 then
			nx, nz = n2x, n2z
		else
			nx, nz = nx / m, nz / m
		end
		local scale = math.min(9, (1.8 / 0.28) / math.max(0.5, nx * n2x + nz * n2z))
		table.insert(points, { x = p.x + nx * scale, z = p.z + nz * scale })
	end
	table.insert(points, points[1])
	local lengths = { 0 }
	local total = 0
	for i = 1, #points - 1 do
		total += Nav.distance(points[i], points[i + 1])
		table.insert(lengths, total)
	end
	return { points = points, lengths = lengths, length = total }
end
function Traffic.sample(route: Route, progress: number): Nav.Point
	progress %= route.length
	for i = 1, #route.points - 1 do
		if progress <= route.lengths[i + 1] then
			local a, b = route.points[i], route.points[i + 1]
			local t = (progress - route.lengths[i]) / (route.lengths[i + 1] - route.lengths[i])
			return { x = a.x + (b.x - a.x) * t, z = a.z + (b.z - a.z) * t }
		end
	end
	return route.points[1]
end
function Traffic.project(route: Route, p: Nav.Point): number
	local best, progress = math.huge, 0
	for i = 1, #route.points - 1 do
		local a, b = route.points[i], route.points[i + 1]
		local dx, dz = b.x - a.x, b.z - a.z
		local t = math.clamp(((p.x - a.x) * dx + (p.z - a.z) * dz) / (dx * dx + dz * dz), 0, 1)
		local d = (p.x - a.x - dx * t) ^ 2 + (p.z - a.z - dz * t) ^ 2
		if d < best then
			best = d
			progress = route.lengths[i] + (route.lengths[i + 1] - route.lengths[i]) * t
		end
	end
	return progress % route.length
end
function Traffic.path(route: Route, progress: number): { Nav.Point }
	local path = { Traffic.sample(route, progress) }
	for round = 0, 1 do
		for i = 2, #route.points do
			local d = route.lengths[i] + round * route.length - progress
			if d > 0 then
				table.insert(path, route.points[i])
				if d > 180 then
					return path
				end
			end
		end
	end
	return path
end
function Traffic.lookahead(speed: number): number
	return math.clamp(22 + math.abs(speed) * 0.2, 22, 30)
end
function Traffic.cornerSpeed(path: { Nav.Point }, cruise: number?): number
	local limit = cruise or 42
	for _, distance in { 4, 10, 18, 30, 45, 65 } do
		local a, b, c =
			Nav.ahead(path, math.max(0, distance - 8)),
			Nav.ahead(path, distance),
			Nav.ahead(path, distance + 8)
		if a and b and c then
			local ab, bc = Nav.distance(a, b), Nav.distance(b, c)
			if ab > 0.1 and bc > 0.1 then
				local angle = math.acos(
					math.clamp(((b.x - a.x) * (c.x - b.x) + (b.z - a.z) * (c.z - b.z)) / (ab * bc), -1, 1)
				)
				if angle > 0.08 then
					local bend = math.clamp(math.sqrt(9 * 8 / angle), 6, 42)
					limit = math.min(limit, math.sqrt(bend * bend + 2 * 14 * math.max(0, distance - 24)))
				end
			end
		end
	end
	return limit
end
function Traffic.followSpeed(gap: number, cruise: number?): number
	return math.clamp((gap - 28) / 1.5, 0, cruise or 42)
end
function Traffic.stopSpeed(distance: number): number
	return math.sqrt(2 * 24 * math.max(0, distance - 20))
end
return Traffic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">TrafficMath</string>
          <string name="Source"><![CDATA[--!strict
local TrafficMath = {}

-- Three lanes each way. Equal speeds within a lane preserve spacing indefinitely.
function TrafficMath.position(
	lane: number,
	slot: number,
	elapsed: number,
	half: number,
	perLane: number
): (number, number, number)
	local direction = if lane <= 3 then -1 else 1
	local offset = (lane - 1) % 3
	local x = (15 + offset * 18) * -direction
	local speed = (90 - offset * 15) * direction
	local start = -180 - lane * 35 + slot * (half * 2 / perLane)
	local z = (start + elapsed * speed + half) % (half * 2) - half
	return x, z, direction
end

return TrafficMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Turbo</string>
          <string name="Source"><![CDATA[--!strict
local Turbo = {}
export type State = { boost: number, heat: number, overheated: boolean }
export type Tuning = {
	SpoolSeconds: number,
	DecaySeconds: number,
	HeatRate: number,
	CoolRate: number,
	RestartHeat: number,
	MinSpeed: number,
}

function Turbo.step(
	state: State,
	dt: number,
	enabled: boolean,
	throttle: number,
	speed: number,
	drift: boolean,
	tune: Tuning
)
	dt = math.clamp(dt, 0, 0.1)
	if state.overheated and state.heat <= tune.RestartHeat then
		state.overheated = false
	end
	local loaded = enabled and not state.overheated and throttle > 0.8 and speed > tune.MinSpeed and not drift
	local target = if loaded then 1 else 0
	local rate = if loaded then 1 / tune.SpoolSeconds else 1 / tune.DecaySeconds
	state.boost += math.clamp(target - state.boost, -dt * rate, dt * rate)
	state.heat =
		math.clamp(state.heat + dt * (if loaded then state.boost * tune.HeatRate else -tune.CoolRate), 0, 1)
	if state.heat >= 1 then
		state.overheated = true
	end
	-- Residual spool is displayed, but supplies no power after disabling, lifting or overheating.
	return if loaded and not state.overheated then state.boost else 0
end

return Turbo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Units</string>
          <string name="Source"><![CDATA[--!strict
-- Roblox standard scale: one stud = 0.28 metres.
local Units = {}
function Units.kmh(studsPerSecond: number): number
	return math.abs(studsPerSecond) * 0.28 * 3.6
end
function Units.mph(studsPerSecond: number): number
	return Units.kmh(studsPerSecond) / 1.609344
end
function Units.fromKmh(kmh: number): number
	return kmh / (0.28 * 3.6)
end
function Units.kilometres(studs: number): number
	return studs * 0.28 / 1000
end
return Units
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">VehicleMaterials</string>
          <string name="Source"><![CDATA[--!strict
local Materials = {}
function Materials.slot(name: string): string?
	local n = string.lower(name)
	if n == "interior" or n:match("_door_int$") then
		return "Interior"
	end
	if n:match("_wheel$") or n:match("_wheel_trim$") then
		return "Wheels"
	end
	if
		n:find("glass", 1, true)
		or n:find("light", 1, true)
		or n:find("trim", 1, true)
		or n:find("tire", 1, true)
		or n:find("grill", 1, true)
	then
		return nil
	end
	if
		n == "body"
		or n == "trrunk"
		or n:find("fender", 1, true)
		or n:find("bumper", 1, true)
		or n:find("hood", 1, true)
		or n:find("roof", 1, true)
		or n:match("_door$")
		or n:match("_door_mirror$")
	then
		return "Paint"
	end
	return nil
end
return Materials
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="35">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="36">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">BundledVehicles</string>
          <string name="Source"><![CDATA[--!strict
-- Reviewed geometry from Roblox's free endorsed vehicle pack, bundled in the place.
local Storage = game:GetService("ServerStorage")
local Cockpit = require(script.Parent.Cockpit)
local Finish = require(script.Parent.VehicleFinish)
local Bundled = {}
export type Wheel = { motor: Motor6D, rest: CFrame, front: boolean }
function Bundled.attach(model: Model, body: Part, key: string, wheels: { Wheel }, driver: boolean): Model?
	local folder = Storage:FindFirstChild("VehicleAssets")
	local template = if folder then folder:FindFirstChild(key) else nil
	if not template or not template:IsA("Model") then
		return nil
	end
	local visual = template:Clone()
	-- Capture chassis-local glass bounds before the visual is moved into the world.
	local glass = visual:FindFirstChild("glass")
	local windowY = if glass and glass:IsA("BasePart") then glass.Position.Y else nil
	local windowHeight = if glass and glass:IsA("BasePart") then glass.Size.Y else nil
	for _, item in model:GetChildren() do
		if item:IsA("BasePart") and item ~= body and item.Name ~= "DriverSeat" then
			item:Destroy()
		end
	end
	body.Transparency = 1
	table.clear(wheels)
	for _, item in visual:GetChildren() do
		if not item:IsA("BasePart") then
			continue
		end
		local rest = item.CFrame
		item.CFrame = body.CFrame * rest
		item.Anchored = false
		item.Massless = true
		item.CanCollide = false
		item.CanTouch = false
		item.CanQuery = false
		local corner = item:GetAttribute("WheelCorner")
		if typeof(corner) == "string" then
			local center = CFrame.new(visual:GetAttribute("Wheel_" .. corner) :: Vector3)
			local motor = Instance.new("Motor6D")
			motor.Part0 = body
			motor.Part1 = item
			motor.C0 = center
			motor.C1 = rest:Inverse() * center
			motor.Parent = item
			table.insert(wheels, { motor = motor, rest = center, front = corner:sub(1, 1) == "F" })
		else
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = body
			weld.Part1 = item
			weld.Parent = item
		end
		if key == "Police" and item.Name == "light_rack_red" then
			item.Name = "PoliceRed"
			item.Material = Enum.Material.Neon
		end
		if key == "Police" and item.Name == "light_rack_blue" then
			item.Name = "PoliceBlue"
			item.Material = Enum.Material.Neon
		end
	end
	visual.Name = "ImportedCarAppearance"
	visual.Parent = model
	Finish.prepare(visual, key == "Police")
	Finish.apply(visual, "Paint", body.Color)
	Finish.apply(visual, "Wheels", Color3.fromRGB(139, 145, 150))
	Finish.apply(visual, "Interior", Color3.fromRGB(42, 43, 45))
	body:GetPropertyChangedSignal("Color"):Connect(function()
		Finish.apply(visual, "Paint", body.Color)
	end)
	local corners = {
		visual:GetAttribute("Wheel_FL"),
		visual:GetAttribute("Wheel_FR"),
		visual:GetAttribute("Wheel_RL"),
		visual:GetAttribute("Wheel_RR"),
	}
	local springs = {}
	for _, item in body:GetChildren() do
		if item:IsA("VectorForce") and item.Name == "Suspension" then
			table.insert(springs, item)
		end
	end
	for i, spring in springs do
		local p = corners[i]
		if typeof(p) == "Vector3" and spring.Attachment0 then
			spring.Attachment0.Position = Vector3.new(p.X, 0, p.Z)
		end
	end
	if driver then
		Cockpit.install(model, body, visual:GetAttribute("DriverOffset") :: Vector3, windowY, windowHeight)
	end
	model:SetAttribute("AppearanceAssetId", visual:GetAttribute("AppearanceAssetId"))
	model:SetAttribute("AppearanceStatus", "Bundled Roblox model")
	model:SetAttribute("BundledVehicle", true)
	return visual
end
return Bundled
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Circuit</string>
          <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Map = require(Shared.TownMap)
local Math = require(Shared.TownTrafficMath)
local Nav = require(Shared.RoadNavigation)
local Rules = require(Shared.LapRules)
local Workshop = require(script.Parent.Workshop)
local Vehicle = require(script.Parent.Vehicle)
local Circuit = {}
local route: Math.Route = { points = {}, lengths = { 0 }, length = 0 }
for _, p in Map.Course do
	table.insert(route.points, { x = p.X, z = p.Z })
end
for i = 2, #route.points do
	route.length += Nav.distance(route.points[i - 1], route.points[i])
	table.insert(route.lengths, route.length)
end
local states: { [Player]: Rules.State } = {}
function Circuit.remove(player: Player)
	states[player] = nil
end
function Circuit.step(player: Player, car: Vehicle.Car?, dt: number, occupied: boolean): string?
	local s = states[player] or Rules.new()
	states[player] = s
	local p = if car then { x = car.Body.Position.X, z = car.Body.Position.Z } else { x = 0, z = 0 }
	local along = Math.project(route, p)
	local valid = car ~= nil
		and occupied
		and not car.Model:GetAttribute("Highway")
		and ((car.Model:GetAttribute("GroundedWheels") :: number?) or 0) >= 2
		and ((car.Model:GetAttribute("Damage") :: number?) or 0) < 100
		and Nav.distance(p, Math.sample(route, along)) < 24
	local complete, seconds = Rules.step(s, along, route.length, dt, valid)
	if not car or car.TelemetryClock == 0 then
		player:SetAttribute("LapProgress", if valid then math.floor(s.travel / route.length * 100) else nil)
	end
	if complete then
		local reward = 100 + math.max(0, 150 - math.floor(seconds / 2))
		Workshop.credit(player, reward)
		Workshop.lap(player, seconds)
		return string.format(
			"LAP COMPLETE · %.1f s · +$%d · Keep driving for another lap",
			seconds,
			reward
		)
	end
	return nil
end
return Circuit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Cockpit</string>
          <string name="Source"><![CDATA[--!strict
local Fit = require(game:GetService("ReplicatedStorage").Shared.CockpitFit)
local Cockpit = {}

function Cockpit.install(
	model: Model,
	body: BasePart,
	seatOffset: Vector3,
	windowY: number?,
	windowHeight: number?
)
	local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat
	local occupant = seat.Occupant
	if occupant then
		occupant.Sit = false
		local riderWeld = seat:FindFirstChild("SeatWeld")
		if riderWeld then
			riderWeld:Destroy()
		end
	end
	for _, child in seat:GetChildren() do
		if child:IsA("WeldConstraint") then
			child:Destroy()
		end
	end
	seat.CFrame = body.CFrame * CFrame.new(seatOffset)
	local seatWeld = Instance.new("WeldConstraint")
	seatWeld.Part0, seatWeld.Part1, seatWeld.Parent = body, seat, seat
	-- Replacing an appearance must not leave a stale eye or a second steering wheel.
	for _, name in { "CockpitEye", "SteeringMotor" } do
		local old = body:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local oldWheel = model:FindFirstChild("SteeringWheel")
	if oldWheel then
		oldWheel:Destroy()
	end
	local height, minimum, maximum = Fit.height(seatOffset.Y, windowY, windowHeight)
	local eyeOffset = Vector3.new(seatOffset.X, height, seatOffset.Z - 0.15)
	local eye = Instance.new("Attachment")
	eye.Name = "CockpitEye"
	eye.Position = eyeOffset
	eye:SetAttribute("MinHeight", minimum)
	eye:SetAttribute("MaxHeight", maximum)
	eye.Parent = body

	local wheel = Instance.new("Model")
	wheel.Name = "SteeringWheel"
	local center = CFrame.new(eyeOffset + Vector3.new(0, -0.85, -1.8)) * CFrame.Angles(math.rad(-15), 0, 0)
	local function piece(name: string, size: Vector3, offset: CFrame): Part
		local part = Instance.new("Part")
		part.Name, part.Size = name, size
		part.CFrame = body.CFrame * center * offset
		part.Color = Color3.fromRGB(27, 31, 36)
		part.Material = Enum.Material.SmoothPlastic
		part.CanCollide, part.CanTouch, part.CanQuery, part.Massless = false, false, false, true
		part.Parent = wheel
		return part
	end
	local hub = piece("Hub", Vector3.new(0.35, 0.3, 0.18), CFrame.identity)
	local function weld(part: Part)
		local joint = Instance.new("WeldConstraint")
		joint.Part0, joint.Part1, joint.Parent = hub, part, part
	end
	for i = 0, 23 do
		local angle = i * math.pi * 2 / 24
		weld(
			piece(
				"Rim",
				Vector3.new(0.15, 0.1, 0.12),
				CFrame.new(math.sin(angle) * 0.52, math.cos(angle) * 0.52, 0) * CFrame.Angles(0, 0, -angle)
			)
		)
	end
	for _, angle in { math.pi / 2, -math.pi / 2, math.pi } do
		weld(piece("Spoke", Vector3.new(0.1, 0.48, 0.1), CFrame.Angles(0, 0, angle) * CFrame.new(0, 0.24, 0)))
	end
	local motor = Instance.new("Motor6D")
	motor.Name = "SteeringMotor"
	motor.Part0, motor.Part1, motor.C0 = body, hub, center
	motor:SetAttribute("Rest", center)
	motor.Parent = body
	wheel.Parent = model
	model:SetAttribute("CockpitReady", true)
	if occupant then
		task.defer(function()
			if
				seat.Parent
				and occupant.Parent
				and occupant.Health > 0
				and not model:GetAttribute("Crashed")
			then
				seat:Sit(occupant)
			end
		end)
	end
end

return Cockpit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Course</string>
          <string name="Source"><![CDATA[--!strict
local Course = {}
Course.Garage = Vector3.new(0, 0, 82)
Course.Pads = { CFrame.new(-36, 4, 60), CFrame.new(-12, 4, 60), CFrame.new(12, 4, 60), CFrame.new(36, 4, 60) }

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
	p.Anchored = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function sign(parent: Instance, title: string, subtitle: string, cf: CFrame, width: number)
	local board = part(parent, title, Vector3.new(width, 9, 1), cf, Color3.fromRGB(18, 28, 42))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = title .. "\n" .. subtitle
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(255, 180, 127)
	label.TextScaled = true
	label.Parent = gui
end

function Course.build(): Model
	local model = Instance.new("Model")
	model.Name = "HandlingCourse"
	model.Parent = workspace
	local asphalt = Color3.fromRGB(44, 53, 65)
	part(
		model,
		"CoastalShelf",
		Vector3.new(1600, 8, 1600),
		CFrame.new(0, -4.6, -210),
		Color3.fromRGB(149, 141, 114),
		Enum.Material.Sand
	)
	local ocean = part(
		model,
		"Ocean",
		Vector3.new(2200, 1, 2200),
		CFrame.new(0, -10, -200),
		Color3.fromRGB(32, 126, 157),
		Enum.Material.SmoothPlastic
	)
	ocean.CanCollide, ocean.CanQuery = false, false
	part(
		model,
		"HandlingPad",
		Vector3.new(510, 1, 620),
		CFrame.new(0, -0.5, -200),
		asphalt,
		Enum.Material.Asphalt
	)
	part(model, "GarageApron", Vector3.new(140, 1, 85), CFrame.new(0, 0, 83), Color3.fromRGB(57, 77, 87))
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "GarageSpawn"
	spawn.Size, spawn.CFrame = Vector3.new(12, 1, 10), CFrame.new(0, 1, 105)
	spawn.Anchored, spawn.Neutral = true, true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(84, 219, 206)
	spawn.Parent = model
	sign(model, "REDLINE COUNTY", "GARAGE / HANDLING LAB", CFrame.new(0, 13, 124), 64)
	part(
		model,
		"NeonHeader",
		Vector3.new(64, 0.5, 1.2),
		CFrame.new(0, 18, 124),
		Color3.fromRGB(255, 95, 126),
		Enum.Material.Neon
	)
	for i, pad in Course.Pads do
		part(
			model,
			"Bay" .. i,
			Vector3.new(15, 0.15, 24),
			CFrame.new(pad.Position.X, 0.58, pad.Position.Z),
			Color3.fromRGB(77, 112, 119)
		)
	end
	-- Wide rectangular loop with escape room; central infield is deliberately open.
	for _, x in { -210, 210 } do
		for z = -460, 30, 25 do
			part(
				model,
				"LaneDash",
				Vector3.new(0.6, 0.08, 11),
				CFrame.new(x, 0.06, z),
				Color3.fromRGB(239, 216, 160)
			)
		end
	end
	for _, z in { -470, 20 } do
		for x = -180, 180, 25 do
			part(
				model,
				"LaneDash",
				Vector3.new(11, 0.08, 0.6),
				CFrame.new(x, 0.06, z),
				Color3.fromRGB(239, 216, 160)
			)
		end
	end
	-- Open edges connect the handling pad to the surrounding drivable land.
	for z = -70, -350, -40 do
		local x = if math.floor(-z / 40) % 2 == 0 then -22 else 22
		local cone = part(
			model,
			"SlalomBollard",
			Vector3.new(3, 4, 3),
			CFrame.new(x, 2, z),
			Color3.fromRGB(255, 130, 76)
		)
		cone.CanCollide = false
	end
	sign(model, "01 / SLALOM", "Predictable turns at 35–60 km/h", CFrame.new(0, 13, -45), 35)
	-- A low bridge provides a ramp, crest and descent without expanding into a full map.
	part(
		model,
		"RampUp",
		Vector3.new(35, 2, 85),
		CFrame.new(115, 6, -170) * CFrame.Angles(math.rad(8), 0, 0),
		asphalt
	)
	part(model, "Crest", Vector3.new(35, 2, 40), CFrame.new(115, 12, -232), asphalt)
	part(
		model,
		"RampDown",
		Vector3.new(35, 2, 85),
		CFrame.new(115, 6, -294) * CFrame.Angles(math.rad(-8), 0, 0),
		asphalt
	)
	sign(model, "02 / CREST", "Climb · landing · recovery", CFrame.new(115, 13, -115), 32)
	for i = 1, 28 do
		local angle = i * math.pi * 2 / 28
		part(
			model,
			"SkidCircle",
			Vector3.new(3, 0.08, 5),
			CFrame.new(-108 + math.cos(angle) * 51, 0.07, -240 + math.sin(angle) * 51),
			Color3.fromRGB(92, 204, 191)
		).CanCollide =
			false
	end
	sign(model, "03 / SKIDPAD", "Turn + Space / Shift at speed", CFrame.new(-110, 13, -155), 39)
	for _, pos in { Vector3.new(-280, 0, 25), Vector3.new(280, 0, -70), Vector3.new(-280, 0, -365) } do
		part(
			model,
			"PalmTrunk",
			Vector3.new(3, 24, 3),
			CFrame.new(pos + Vector3.new(0, 12, 0)),
			Color3.fromRGB(114, 95, 82)
		)
		for yaw = 0, 135, 45 do
			part(
				model,
				"PalmCrown",
				Vector3.new(32, 2, 6),
				CFrame.new(pos + Vector3.new(0, 24, 0)) * CFrame.Angles(0, math.rad(yaw), 0),
				Color3.fromRGB(47, 113, 103)
			)
		end
	end
	return model
end

return Course
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">CrashEffect</string>
          <string name="Source"><![CDATA[--!strict
local Debris = game:GetService("Debris")
local CrashEffect = {}

function CrashEffect.show(model: Model, body: BasePart)
	local explosion = Instance.new("Explosion")
	explosion.Position = body.Position
	explosion.BlastRadius = 14
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = workspace
	Debris:AddItem(explosion, 3)
	-- Explicitly destroy only the crashed car; the visual blast never damages bystanders or roads.
	for _, item in model:GetDescendants() do
		if item:IsA("Light") then
			item.Enabled = false
		end
		if item:IsA("BasePart") then
			item.Color = Color3.fromRGB(38, 34, 32)
		end
	end
	local fire = Instance.new("Fire")
	fire.Size, fire.Heat, fire.Parent = 10, 6, body
	local smoke = Instance.new("Smoke")
	smoke.Size, smoke.RiseVelocity, smoke.Opacity, smoke.Parent = 9, 12, 0.6, body
	for i = 1, 6 do
		local fragment = Instance.new("Part")
		fragment.Name, fragment.Size = "CrashFragment", Vector3.new(1.5, 0.5, 2)
		fragment.CFrame = body.CFrame * CFrame.new((i % 3 - 1) * 2, 2, math.floor(i / 3) * 2 - 2)
		fragment.Color = Color3.fromRGB(60, 66, 72)
		fragment.CanCollide, fragment.CanTouch, fragment.CanQuery = false, false, false
		fragment.Parent = workspace
		fragment:SetNetworkOwner(nil)
		fragment.AssemblyLinearVelocity = Vector3.new(math.cos(i) * 25, 25 + i * 3, math.sin(i) * 25)
		Debris:AddItem(fragment, 2)
	end
end

return CrashEffect
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Getaway</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vehicle = require(script.Parent.Vehicle)
local Nav = require(ReplicatedStorage.Shared.RoadNavigation)
local Graph = require(ReplicatedStorage.Shared.RoadGraph).Nodes
local Map = require(ReplicatedStorage.Shared.TownMap)
local Rules = require(ReplicatedStorage.Shared.GetawayRules)
local Contracts = require(ReplicatedStorage.Shared.Contracts)
local Workshop = require(script.Parent.Workshop)
local TownTraffic = require(script.Parent.TownTraffic)
local Progression = require(ReplicatedStorage.Shared.Progression)
local Variants = require(ReplicatedStorage.Shared.MissionVariants)
local Tactics = require(ReplicatedStorage.Shared.PoliceTactics)
local Roadblock = require(script.Parent.Roadblock)
local Metrics = require(script.Parent.PlaytestMetrics)
local Getaway = {}
type Contract = typeof(Contracts[1])
local function checkpoint(contract: Contract, index: number): Vector3
	return (if contract.Parkway then Map.Course else Map.Route)[contract.Checkpoints[index]]
end
type Unit = {
	car: Vehicle.Car,
	lastKnown: Vector3,
	plan: { Nav.Point },
	replan: number,
	stalled: number,
	reverseUntil: number,
	alertUntil: number,
	role: string,
	lastVelocity: Vector3,
	lastSeen: number,
	searchNode: number,
}
type Job = {
	owner: Player,
	difficulty: string,
	car: Vehicle.Car,
	contract: Contract,
	rules: Rules.State,
	cops: { Unit },
	nextSpawn: number,
	grace: number,
	clock: number,
	policeReady: boolean,
	free: boolean?,
	variant: Variants.State,
	started: number,
	dispatch: Vector3,
	block: Roadblock.Block?,
	blockTried: boolean,
}
local jobs: { [Player]: Job } = {}
local patrols = Instance.new("Folder")
patrols.Name = "PolicePatrols"
patrols.Parent = workspace
local function point(v: Vector3): Nav.Point
	return { x = v.X, z = v.Z }
end
local function vector(p: Nav.Point): Vector3
	return Vector3.new(p.x, 32, p.z)
end
local function distance(a: Vector3, b: Vector3): number
	return ((a - b) * Vector3.new(1, 0, 1)).Magnitude
end
local function dispose(job: Job)
	Roadblock.clear(job.owner, job.block)
	job.block = nil
	TownTraffic.demand(job.owner, nil)
	for _, unit in job.cops do
		TownTraffic.returnPatrol(unit.car)
	end
	table.clear(job.cops)
end
function Getaway.active(player: Player): boolean
	local job = jobs[player]
	return job ~= nil and Rules.active(job.rules)
end
-- Read the server's finished run, never a client-supplied contract or result.
function Getaway.retryInfo(player: Player): (string?, string?)
	local job = jobs[player]
	if not job or not Rules.recoverable(job.rules) then
		return nil, nil
	end
	return if job.free then "first" else job.contract.Id, job.difficulty
end
function Getaway.cancel(player: Player, reason: string)
	local job = jobs[player]
	if job then
		dispose(job)
		if Rules.active(job.rules) then
			job.rules.phase = "failed"
			player:SetAttribute("MissionPhase", "failed")
			player:SetAttribute("MissionMessage", reason)
			player:SetAttribute("Wanted", 0)
			player:SetAttribute("MissionTarget", nil)
			player:SetAttribute("MissionChoice", false)
		end
	end
end
function Getaway.remove(player: Player)
	Getaway.cancel(player, "Left game")
	jobs[player] = nil
end
local function visible(unit: Unit, target: Vehicle.Car, player: Player): boolean
	if distance(unit.car.Body.Position, target.Body.Position) > 260 then
		return false
	end
	local ray = RaycastParams.new()
	ray.FilterDescendantsInstances = { patrols, workspace.Vehicles, player.Character :: Model }
	ray.RespectCanCollide = true
	local origin = unit.car.Body.Position + Vector3.new(0, 2, 0)
	return workspace:Raycast(origin, target.Body.Position + Vector3.new(0, 2, 0) - origin, ray) == nil
end
local function spawnUnit(player: Player, job: Job): boolean
	local body = job.car.Body
	local patrol = TownTraffic.takePatrol(body.Position)
	if patrol then
		patrol.Model.Parent = patrols
		patrol.Model:SetAttribute("TargetUserId", player.UserId)
		patrol.Tune.TopSpeed = 125
		patrol.Tune.Acceleration = 18
		patrol.Ray.FilterDescendantsInstances = { patrols, workspace.Vehicles, workspace.TownTraffic }
		table.insert(job.cops, {
			car = patrol,
			lastKnown = job.dispatch,
			lastVelocity = Vector3.zero,
			lastSeen = os.clock(),
			searchNode = 0,
			role = if #job.cops == 0 then "follow" else "intercept",
			plan = {},
			replan = 0,
			stalled = 0,
			reverseUntil = 0,
			alertUntil = os.clock() + 1,
		})
		job.policeReady = true
		return true
	end
	if TownTraffic.policeCount() >= 8 then
		return false
	end
	local candidates: { { node: Nav.Node, score: number } } = {}
	for _, node in Graph do
		local v = vector(node)
		local dist = distance(v, body.Position)
		if dist > 180 and dist < 1100 and distance(v, Map.Garage) > 180 and #node.links > 0 then
			-- Prefer behind the driver and never create a roadblock directly in their path.
			local score = dist + math.max(0, (v - body.Position):Dot(body.CFrame.LookVector)) * 3
			table.insert(candidates, { node = node, score = score })
		end
	end
	table.sort(candidates, function(a, b)
		return a.score < b.score
	end)
	for _, candidate in candidates do
		local node = candidate.node
		local position = vector(node) + Vector3.new(0, 2.25, 0)
		local clear = true
		for _, other in workspace.Vehicles:GetChildren() do
			if
				other:IsA("Model")
				and other.PrimaryPart
				and distance(other.PrimaryPart.Position, position) < 100
			then
				clear = false
				break
			end
		end
		for _, cop in patrols:GetChildren() do
			if cop:IsA("Model") and cop.PrimaryPart and distance(cop.PrimaryPart.Position, position) < 70 then
				clear = false
				break
			end
		end
		local sight = RaycastParams.new()
		sight.FilterDescendantsInstances = { workspace.Vehicles, patrols, workspace.TownTraffic }
		sight.RespectCanCollide = true
		local inFront = (position - body.Position).Unit:Dot(body.CFrame.LookVector) > -0.3
		local visibleSpawn = (inFront or distance(position, body.Position) < 350)
			and workspace:Raycast(body.Position + Vector3.new(0, 3, 0), position - body.Position, sight)
				== nil
		if not Tactics.spawnSafe(distance(position, body.Position), visibleSpawn, not clear) then
			continue
		end
		local path = Nav.route(Graph, point(position), point(job.dispatch))
		local aim = Nav.ahead(path, 18)
		if not clear or not aim or #path < 2 then
			continue
		end
		local cf = CFrame.lookAt(position, Vector3.new(aim.x, position.Y, aim.z))
		local overlap = OverlapParams.new()
		overlap.RespectCanCollide = true
		if #workspace:GetPartBoundsInBox(cf + Vector3.new(0, 1.5, 0), Vector3.new(8, 3, 18), overlap) > 0 then
			continue
		end
		local car = Vehicle.create(patrols, nil, "Electric", cf)
		car.Model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
		car.Model.Name = "Patrol_" .. player.UserId .. "_" .. (#job.cops + 1)
		car.Model:SetAttribute("TargetUserId", player.UserId)
		car.Tune = table.clone(car.Tune)
		car.Tune.TopSpeed = 125
		car.Tune.Acceleration = 18
		car.Body.Color = Color3.fromRGB(25, 33, 48)
		for _, p in car.Model:GetDescendants() do
			if p:IsA("BasePart") then
				p.CollisionGroup = "Police"
			end
		end
		car.Ray.FilterDescendantsInstances =
			{ patrols, workspace.Vehicles, workspace.HighwayTraffic, workspace.TownTraffic }
		local lampPositions: { number } = if car.Model:GetAttribute("BundledVehicle")
			then {}
			else { -1.5, 1.5 }
		for _, x in lampPositions do
			local lamp = Instance.new("Part")
			lamp.Name = if x < 0 then "PoliceRed" else "PoliceBlue"
			lamp.Size = Vector3.new(2.6, 0.5, 1)
			lamp.CFrame = cf * CFrame.new(x, 2.9, 0)
			lamp.Color = if x < 0 then Color3.fromRGB(255, 55, 65) else Color3.fromRGB(65, 140, 255)
			lamp.Material = Enum.Material.Neon
			lamp.Massless, lamp.CanCollide, lamp.CanTouch, lamp.CanQuery = true, false, false, false
			lamp.Parent = car.Model
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = car.Body, lamp, lamp
		end
		local badge = Instance.new("BillboardGui")
		badge.Name = "PoliceBadge"
		badge.Size = UDim2.fromOffset(90, 25)
		badge.StudsOffset = Vector3.new(0, 5, 0)
		badge.MaxDistance = 160
		badge.Parent = car.Body
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 0.25
		label.BackgroundColor3 = Color3.fromRGB(18, 28, 48)
		label.Text = "POLICE"
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextSize = 14
		label.Parent = badge
		table.insert(job.cops, {
			car = car,
			lastKnown = job.dispatch,
			lastVelocity = Vector3.zero,
			lastSeen = os.clock(),
			searchNode = 0,
			role = if #job.cops == 0 then "follow" else "intercept",
			plan = path,
			replan = 0,
			stalled = 0,
			reverseUntil = 0,
			alertUntil = os.clock() + 3,
		})
		job.policeReady = true
		return true
	end
	return false
end
function Getaway.start(player: Player, car: Vehicle.Car, id: string, difficulty: string): boolean
	if Getaway.active(player) or not Progression.difficulty(difficulty) then
		return false
	end
	local contract: Contract? = nil
	for _, option in Contracts do
		if option.Id == id then
			contract = option
			break
		end
	end
	if not contract then
		return false
	end
	if jobs[player] then
		dispose(jobs[player])
	end
	Metrics.mark(player, "job", { id = id, difficulty = difficulty })
	if (player:GetAttribute("GetawayWins") :: number? or 0) > 0 then
		Metrics.mark(player, "second_job", nil, true)
	end
	TownTraffic.demand(player, difficulty)
	jobs[player] = {
		owner = player,
		difficulty = difficulty,
		car = car,
		contract = contract,
		rules = Rules.new(#contract.Checkpoints, contract.Seconds, contract.Heat),
		cops = {},
		nextSpawn = 0,
		grace = os.clock() + 3,
		clock = 0,
		policeReady = false,
		variant = Variants.new(
			contract.Mode,
			(car.Model:GetAttribute("Damage") :: number?) or 0,
			contract.Heat
		),
		started = os.clock(),
		dispatch = car.Body.Position,
		blockTried = false,
	}
	player:SetAttribute("MissionChoice", false)
	player:SetAttribute("CargoQuality", if contract.Mode == "cargo" then 100 else nil)
	player:SetAttribute("MissionDifficulty", difficulty)
	player:SetAttribute("MissionPhase", "pickup")
	player:SetAttribute("MissionName", contract.Name)
	player:SetAttribute(
		"MissionMessage",
		"Follow the cyan route to the gold pickup. Police respond when you collect it."
	)
	player:SetAttribute("MissionTarget", checkpoint(contract, 1))
	player:SetAttribute("Wanted", 0)
	player:SetAttribute("MissionRemaining", contract.Seconds)
	return true
end
function Getaway.choose(player: Player, choice: string)
	local job = jobs[player]
	if not job or not Rules.active(job.rules) or not Variants.choose(job.variant, choice) then
		return
	end
	job.rules.phase = if choice == "continue" then "run" else "escape"
	job.rules.escape = 0
	job.clock = 0
	player:SetAttribute("MissionChoice", false)
	player:SetAttribute(
		"MissionMessage",
		if choice == "continue"
			then "Another pickup. Police pressure increased!"
			else "Break sight, then bring your haul home."
	)
end
function Getaway.provoke(player: Player, car: Vehicle.Car)
	if not Getaway.start(player, car, "first", "light") then
		return
	end
	local job = jobs[player]
	job.free = true
	job.rules.phase = "escape"
	job.rules.remaining = 180
	player:SetAttribute("MissionPhase", "escape")
	player:SetAttribute("MissionName", "POLICE PURSUIT")
	player:SetAttribute("MissionMessage", "Reckless driving spotted. Break police sight for 10 seconds.")
	player:SetAttribute("MissionTarget", nil)
	player:SetAttribute("Wanted", 1)
end
local function steerUnit(unit: Unit, car: Vehicle.Car, seen: boolean, dt: number, now: number)
	local body = unit.car.Body
	if seen then
		unit.lastKnown = car.Body.Position
		unit.lastVelocity = car.Body.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
		unit.lastSeen = now
		unit.searchNode = 0
	end
	if now >= unit.replan then
		local target = Tactics.target(
			Graph,
			point(unit.lastKnown),
			point(unit.lastVelocity),
			if seen then unit.role else "follow"
		)
		if not seen and (distance(body.Position, unit.lastKnown) < 30 or unit.searchNode > 0) then
			-- Sweep the adjoining road branches at the last sighting; never query hidden driver position.
			local _, node = Nav.project(Graph, point(unit.lastKnown))
			local links = Graph[node].links
			if #links > 0 then
				unit.searchNode = if unit.searchNode == 0 then 1 else unit.searchNode
				local nextNode = Graph[links[unit.searchNode]]
				target = { x = nextNode.x, z = nextNode.z }
				if Nav.distance(point(body.Position), target) < 18 then
					unit.searchNode = unit.searchNode % #links + 1
				end
			end
		end
		unit.plan = Nav.route(Graph, point(body.Position), target)
		unit.replan = now + 0.5
	end
	local speed = body.AssemblyLinearVelocity:Dot(body.CFrame.LookVector)
	local remaining = Nav.remaining(unit.plan, point(body.Position))
	local aim = Nav.ahead(remaining, math.clamp(8 + math.abs(speed) * 0.45, 12, 60))
	local throttle, steer = 0, 0
	if aim then
		local target = Vector3.new(aim.x, body.Position.Y, aim.z)
		-- Direct interception only on nearby visible pavement, never through houses.
		if seen and distance(body.Position, car.Body.Position) < 45 then
			target = car.Body.Position
		end
		local localPoint = body.CFrame:PointToObjectSpace(target)
		throttle, steer = Nav.controls(
			localPoint.X,
			-localPoint.Z,
			speed,
			unit.car.Wheelbase or 10.4,
			Nav.cornerSpeed(remaining, if seen then 120 else 32)
		)
	end
	unit.stalled = if math.abs(speed) < 2
			and throttle > 0
			and now > unit.alertUntil
		then unit.stalled + dt
		else 0
	if unit.stalled > 3 then
		unit.reverseUntil = now + 1.5
		unit.stalled = 0
	end
	if now < unit.reverseUntil then
		local ray = RaycastParams.new()
		ray.FilterDescendantsInstances = { unit.car.Model }
		ray.RespectCanCollide = true
		ray.CollisionGroup = "Police"
		local behind = workspace:Blockcast(
			body.CFrame,
			Vector3.new(body.Size.X, 1, body.Size.Z),
			-body.CFrame.LookVector * 12,
			ray
		)
		throttle = if behind then 0 else -0.5
		steer = -steer
	end
	-- Home is protected: officers hold outside the driveway rather than entering bays.
	if distance(body.Position, Map.Garage) < 150 then
		throttle = if speed > 2 then -1 else 0
	end
	if now < unit.alertUntil then
		throttle, steer = 0, 0
	end
	Vehicle.step(unit.car, math.min(dt, 0.05), throttle, steer, false, false)
	unit.car.Model:SetAttribute("PoliceRole", if seen then unit.role else "search")
end
function Getaway.step(dt: number)
	local now = os.clock()
	for player, job in jobs do
		if not Rules.active(job.rules) then
			continue
		end
		local car = job.car
		local humanoid = if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
		local valid = car.Model.Parent ~= nil
			and humanoid ~= nil
			and humanoid.Health > 0
			and (car.Seat.Occupant == humanoid or now < job.grace)
		valid = valid
			and not car.Model:GetAttribute("Highway")
			and car.Body.Position.X > -2400
			and ((car.Model:GetAttribute("Damage") :: number?) or 0) < 100
		local seen, near = false, false
		if valid and job.rules.phase ~= "pickup" then
			if #job.cops < job.variant.heat and now >= job.nextSpawn then
				spawnUnit(player, job)
				job.nextSpawn = now + 4
			end
			for _, unit in job.cops do
				local canSee = visible(unit, car, player)
				if canSee then
					job.dispatch = car.Body.Position
				end
				seen = seen or canSee
				near = near or (canSee and distance(unit.car.Body.Position, car.Body.Position) < 24)
				steerUnit(unit, car, canSee, math.min(dt, 0.25), now)
			end
		end
		if seen and job.variant.heat >= 3 and not job.blockTried then
			job.block = Roadblock.deploy(player, job.dispatch, car.Body.AssemblyLinearVelocity)
			job.blockTried = job.block ~= nil
		end
		if job.block and now >= job.block.expires then
			Roadblock.clear(player, job.block)
			job.block = nil
		end
		Variants.damage(job.variant, (car.Model:GetAttribute("Damage") :: number?) or 0)
		if job.variant.choice and now >= job.variant.deadline then
			Getaway.choose(player, "bank")
		end
		local target = checkpoint(job.contract, math.min(job.rules.checkpoint, #job.contract.Checkpoints))
		local result = Rules.step(job.rules, dt, {
			valid = valid,
			atCheckpoint = distance(car.Body.Position, target) < 22
				and math.abs(car.Body.Position.Y - target.Y) < 12,
			atHome = distance(car.Body.Position, Map.Garage) < 35,
			seen = seen,
			nearCop = near,
			slow = car.Body.AssemblyLinearVelocity.Magnitude < 12,
			stopped = car.Body.AssemblyLinearVelocity.Magnitude < 2,
			policeReady = job.policeReady and not job.variant.choice,
		})
		if result == "alarm" or result == "checkpoint" then
			job.dispatch = target
			Variants.pickup(job.variant, job.rules.checkpoint <= #job.contract.Checkpoints, now)
			if job.contract.Mode == "heat" then
				job.rules.phase = "escape"
				player:SetAttribute("MissionChoice", job.variant.choice)
				player:SetAttribute("UnbankedHaul", Variants.base(job.variant, job.contract.Reward))
			end
		end
		if result then
			Metrics.mark(player, result, {
				damage = job.variant.damage,
				quality = job.variant.quality,
				remaining = job.rules.remaining,
			})
		end
		if result == "alarm" then
			player:SetAttribute("MissionMessage", "LOOT COLLECTED · Police alerted. Keep moving!")
		elseif result == "checkpoint" then
			player:SetAttribute("MissionMessage", "Stash collected. Keep moving to the next marker.")
		elseif result == "escaped" and job.free then
			job.rules.phase = "complete"
			player:SetAttribute("MissionMessage", "ESCAPED · Patrol lost you. Cool down before another run.")
		elseif result == "escaped" then
			player:SetAttribute(
				"MissionMessage",
				"ESCAPED · Return to the green home marker. Stop there for 2 seconds."
			)
		elseif result == "spotted" then
			player:SetAttribute("MissionMessage", "SPOTTED AGAIN · Break line of sight for 10 seconds.")
		elseif result == "reward" then
			local reward = Variants.payout(
				job.variant,
				Progression.payout(
					Variants.base(job.variant, job.contract.Reward),
					job.rules.remaining,
					job.difficulty,
					(car.Model:GetAttribute("Damage") :: number?) or 0
				)
			)
			local withoutClean = Variants.payout(
				job.variant,
				Progression.payout(
					Variants.base(job.variant, job.contract.Reward),
					job.rules.remaining,
					job.difficulty,
					1
				)
			)
			player:SetAttribute("LastCleanBonus", math.max(0, reward - withoutClean))
			player:SetAttribute("LastReward", reward)
			Metrics.mark(
				player,
				"bank",
				{ amount = reward, seconds = now - job.started, difficulty = job.difficulty }
			)
			Workshop.credit(player, reward)
			Workshop.win(player)
			player:SetAttribute(
				"MissionMessage",
				"DELIVERED! +$" .. reward .. " · Choose another contract at home."
			)
		elseif result == "busted" then
			player:SetAttribute(
				"MissionMessage",
				"BUSTED · Held by police for 5 seconds. R to return home and retry."
			)
		elseif result == "timeout" then
			player:SetAttribute("MissionMessage", "TIME UP · R to return home and retry.")
		elseif result == "vehicle_lost" then
			player:SetAttribute(
				"MissionMessage",
				"JOB LOST · Stay in a working car. R to recover, then retry at home."
			)
		end
		if result or job.clock <= 0 then
			player:SetAttribute(
				"CargoQuality",
				if job.contract.Mode == "cargo" then math.floor(job.variant.quality) else nil
			)
			player:SetAttribute("MissionPhase", job.rules.phase)
			player:SetAttribute("MissionRemaining", math.ceil(job.rules.remaining))
			player:SetAttribute("MissionEscape", math.floor(job.rules.escape))
			player:SetAttribute("MissionBusted", math.floor(job.rules.busted * 10) / 10)
			player:SetAttribute(
				"MissionCheckpoint",
				math.min(job.rules.checkpoint, #job.contract.Checkpoints)
			)
			player:SetAttribute("MissionCheckpointCount", #job.contract.Checkpoints)
			player:SetAttribute("PoliceSeeing", seen)
			player:SetAttribute(
				"Wanted",
				if job.rules.phase == "pickup" or not Rules.active(job.rules) then 0 else job.variant.heat
			)
			player:SetAttribute(
				"MissionTarget",
				if not Rules.active(job.rules) or job.rules.phase == "escape"
					then nil
					elseif job.rules.phase == "deliver" then Map.Garage
					else checkpoint(job.contract, job.rules.checkpoint)
			)
			job.clock = 0.2
		end
		job.clock -= dt
		if not Rules.active(job.rules) then
			player:SetAttribute("MissionChoice", false)
			player:SetAttribute("LastRunSeconds", math.floor(now - job.started))
			if result ~= "reward" then
				player:SetAttribute("LastReward", 0)
				player:SetAttribute("LastCleanBonus", 0)
			end
			player:SetAttribute(
				"ResultSequence",
				((player:GetAttribute("ResultSequence") :: number?) or 0) + 1
			)
			dispose(job)
		end
	end
end
return Getaway
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Highway</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local HighwayMath = require(ReplicatedStorage.Shared.HighwayMath)
local Driving = require(ReplicatedStorage.Shared.Driving)
local Traffic = require(script.Parent.Traffic)
local H = Config.Highway
local Highway = {}
local folder = Instance.new("Folder")
folder.Name, folder.Parent = "Autobahn", workspace
local chunks: { [number]: Model } = {}
local clock = 0

local function part(
	model: Model,
	name: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position, p.Color = name, size, position, color
	p.Anchored = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function downlight(lamp: BasePart)
	local light = Instance.new("SurfaceLight")
	light.Face, light.Range, light.Angle, light.Brightness = Enum.NormalId.Bottom, 60, 140, 1.8
	light.Color, light.Shadows, light.Parent = Color3.fromRGB(255, 214, 158), false, lamp
end

local function build(index: number)
	if chunks[index] then
		return
	end
	local model = Instance.new("Model")
	model.Name = "Section_" .. index
	local z = -(index + 0.5) * H.ChunkLength
	local road = Color3.fromRGB(39, 46, 57)
	local white = Color3.fromRGB(232, 233, 211)
	local variant = index % 4
	part(
		model,
		"Verge",
		Vector3.new(460, 8, H.ChunkLength),
		Vector3.new(H.X, H.Y - 4.5, z),
		if variant == 1 then Color3.fromRGB(157, 151, 116) else Color3.fromRGB(91, 120, 91),
		Enum.Material.Grass
	)
	part(
		model,
		"Road",
		Vector3.new(132, 1, H.ChunkLength),
		Vector3.new(H.X, H.Y - 0.5, z),
		road,
		Enum.Material.Asphalt
	)
	part(
		model,
		"Median",
		Vector3.new(5, 3, H.ChunkLength),
		Vector3.new(H.X, H.Y + 1.5, z),
		Color3.fromRGB(120, 137, 144)
	)
	for _, x in { -66, 66 } do
		if x == 66 and index == 0 then
			-- Real opening for the acceleration lane; all other guardrail sections remain intact.
			part(
				model,
				"Guardrail",
				Vector3.new(1, 3, 240),
				Vector3.new(H.X + x, H.Y + 1.5, -120),
				Color3.fromRGB(150, 174, 181)
			)
			part(
				model,
				"Guardrail",
				Vector3.new(1, 3, 92),
				Vector3.new(H.X + x, H.Y + 1.5, -466),
				Color3.fromRGB(150, 174, 181)
			)
		else
			part(
				model,
				"Guardrail",
				Vector3.new(1, 3, H.ChunkLength),
				Vector3.new(H.X + x, H.Y + 1.5, z),
				Color3.fromRGB(150, 174, 181)
			)
		end
	end
	for _, x in { -59, -7, 7, 59 } do
		part(
			model,
			"EdgeLine",
			Vector3.new(0.4, 0.04, H.ChunkLength),
			Vector3.new(H.X + x, H.Y + 0.025, z),
			white
		).CanCollide =
			false
	end
	for offset = 16, H.ChunkLength - 1, 64 do
		for _, x in { -60, 60 } do
			local reflector = part(
				model,
				"RoadReflector",
				Vector3.new(0.4, 0.6, 1.2),
				Vector3.new(H.X + x, H.Y + 0.4, -index * H.ChunkLength - offset),
				Color3.fromRGB(234, 222, 184),
				Enum.Material.Neon
			)
			reflector.CanCollide = false
		end
		for _, x in { -24, -42, 24, 42 } do
			part(
				model,
				"LaneDash",
				Vector3.new(0.4, 0.04, 28),
				Vector3.new(H.X + x, H.Y + 0.025, -index * H.ChunkLength - offset),
				white
			).CanCollide =
				false
		end
	end
	for _, x in { -88, if index == 0 then 148 else 88 } do
		part(
			model,
			"LampPost",
			Vector3.new(1, 26, 1),
			Vector3.new(H.X + x, H.Y + 13, z),
			Color3.fromRGB(67, 85, 99)
		)
		local lamp = part(
			model,
			"Lamp",
			Vector3.new(12, 0.4, 2),
			Vector3.new(H.X + x, H.Y + 26, z),
			Color3.fromRGB(255, 206, 133),
			Enum.Material.Neon
		)
		downlight(lamp)
		if variant == 2 then
			part(
				model,
				"Factory",
				Vector3.new(60, 35, 100),
				Vector3.new(H.X + x * 2, H.Y + 17, z),
				Color3.fromRGB(83, 102, 125)
			)
		else
			part(
				model,
				"Hill",
				Vector3.new(80, 45, 180),
				Vector3.new(H.X + x * 2, H.Y + 3, z),
				Color3.fromRGB(63, 94, 88)
			).Shape =
				Enum.PartType.Ball
		end
	end
	-- Gantries mark the repeating landscape without pretending physical coordinates are trip distance.
	local board = part(
		model,
		"AutobahnSign",
		Vector3.new(48, 9, 1),
		Vector3.new(H.X + 33, H.Y + 20, z),
		Color3.fromRGB(30, 85, 159)
	)
	part(
		model,
		"Gantry",
		Vector3.new(1, 25, 1),
		Vector3.new(H.X + 62, H.Y + 12, z),
		Color3.fromRGB(131, 152, 168)
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.PixelsPerStud = Enum.NormalId.Back, 24
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	label.Text = "A1  /  REDLINE AUTOBAHN\nKEEP RIGHT  •  PASS LEFT"
	label.TextColor3, label.Font, label.TextScaled = white, Enum.Font.GothamBold, true
	label.Parent = gui
	model.Parent = folder
	chunks[index] = model
end

function Highway.prepare(z: number)
	for index in HighwayMath.needed({ z }, H.ChunkLength, H.LoadRadius, H.HalfLength) do
		build(index)
	end
end

function Highway.entry(): CFrame
	Highway.prepare(Config.Ramp.StartZ)
	if not folder:FindFirstChild("OnRamp") then
		local ramp = Instance.new("Model")
		ramp.Name = "OnRamp"
		local asphalt = Color3.fromRGB(50, 62, 72)
		part(
			ramp,
			"AccelerationLane",
			Vector3.new(30, 1, 640),
			Vector3.new(H.X + Config.Ramp.XOffset, H.Y - 0.5, 192),
			asphalt,
			Enum.Material.Asphalt
		)
		for _, x in { 78, 130 } do
			part(
				ramp,
				"RampBarrier",
				Vector3.new(1.5, 3, 640),
				Vector3.new(H.X + x, H.Y + 1.5, 192),
				Color3.fromRGB(150, 174, 181)
			)
		end
		local from = Vector3.new(H.X + Config.Ramp.XOffset, H.Y - 0.5, -120)
		local to = Vector3.new(H.X + 59, H.Y - 0.5, -352)
		local merge = part(
			ramp,
			"MergeLane",
			Vector3.new(26, 1, (to - from).Magnitude + 12),
			(from + to) / 2,
			asphalt,
			Enum.Material.Asphalt
		)
		merge.CFrame = CFrame.lookAt((from + to) / 2, to)
		for z = -80, 460, 60 do
			part(
				ramp,
				"RampCenterDash",
				Vector3.new(0.5, 0.04, 20),
				Vector3.new(H.X + Config.Ramp.XOffset, H.Y + 0.025, z),
				Color3.fromRGB(255, 217, 121)
			).CanCollide =
				false
		end
		for _, z in { 0, 192, 384 } do
			part(
				ramp,
				"RampLightPost",
				Vector3.new(1, 24, 1),
				Vector3.new(H.X + 132, H.Y + 12, z),
				Color3.fromRGB(98, 121, 138)
			)
			local lamp = part(
				ramp,
				"RampLamp",
				Vector3.new(12, 0.5, 3),
				Vector3.new(H.X + 124, H.Y + 24, z),
				Color3.fromRGB(255, 214, 158),
				Enum.Material.Neon
			)
			downlight(lamp)
		end
		local board = part(
			ramp,
			"MergeSign",
			Vector3.new(30, 7, 1),
			Vector3.new(H.X + Config.Ramp.XOffset, H.Y + 13, -80),
			Color3.fromRGB(32, 96, 160)
		)
		local gui = Instance.new("SurfaceGui")
		gui.Face, gui.Parent = Enum.NormalId.Back, board
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.TextScaled, label.Font = "A1 AUTOBAHN\nMERGE LEFT AHEAD", true, Enum.Font.GothamBold
		label.TextColor3, label.Parent = Color3.new(1, 1, 1), gui
		ramp.Parent = folder
	end
	return CFrame.new(H.X + Config.Ramp.XOffset, H.Y + 3, Config.Ramp.StartZ)
end

function Highway.wrapCar(model: Model, body: BasePart)
	local z = body.Position.Z
	local wrapped = HighwayMath.wrap(z, H.HalfLength)
	if math.abs(wrapped - z) < 0.01 then
		return
	end
	Highway.prepare(wrapped)
	local linear, angular = body.AssemblyLinearVelocity, body.AssemblyAngularVelocity
	model:PivotTo(model:GetPivot() + Vector3.new(0, 0, wrapped - z))
	body.AssemblyLinearVelocity, body.AssemblyAngularVelocity = linear, angular
	-- Lets the local chase camera apply the same translation rather than lerp across the world.
	model:SetAttribute("HighwayWraps", ((model:GetAttribute("HighwayWraps") :: number?) or 0) + 1)
end

function Highway.update(dt: number, vehicles: Instance)
	clock += dt
	if clock < H.UpdateSeconds then
		return
	end
	clock = 0
	local positions = {}
	for _, model in vehicles:GetChildren() do
		if
			model:IsA("Model")
			and model:GetAttribute("Highway")
			and model.PrimaryPart
			and Driving.finite(model.PrimaryPart.Position.Z)
		then
			table.insert(positions, model.PrimaryPart.Position.Z)
		end
	end
	-- Keep road underneath passengers/drivers who get out of a car, too.
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
		if root and math.abs(root.Position.X - H.X) < 300 and Driving.finite(root.Position.Z) then
			local wrapped = HighwayMath.wrap(root.Position.Z, H.HalfLength)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid and not humanoid.SeatPart and math.abs(wrapped - root.Position.Z) > 0.01 then
				Highway.prepare(wrapped)
				character:PivotTo(character:GetPivot() + Vector3.new(0, 0, wrapped - root.Position.Z))
			end
			table.insert(positions, wrapped)
		end
	end
	local needed = HighwayMath.needed(positions, H.ChunkLength, H.LoadRadius, H.HalfLength)
	for index in needed do
		build(index)
	end
	for index, model in chunks do
		if not needed[index] then
			model:Destroy()
			chunks[index] = nil
		end
	end
	Traffic.update(needed)
	local count = 0
	for _ in chunks do
		count += 1
	end
	folder:SetAttribute("LoadedSections", count)
end

return Highway
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="44">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local Config = require(ReplicatedStorage.Shared.Config)
local Units = require(ReplicatedStorage.Shared.Units)
local Driving = require(ReplicatedStorage.Shared.Driving)
local DriftRules = require(ReplicatedStorage.Shared.DriftRules)
local Garage = require(script.Parent.TownGarage)
local TownTraffic = require(script.Parent.TownTraffic)
local Workshop = require(script.Parent.Workshop)
local Progression = require(ReplicatedStorage.Shared.Progression)
local Getaway = require(script.Parent.Getaway)
local Circuit = require(script.Parent.Circuit)
local GarageRules = require(ReplicatedStorage.Shared.GarageRules)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Course = require(script.Parent.Course)
local Vehicle = require(script.Parent.Vehicle)
local Highway = require(script.Parent.Highway)
local HighwayMath = require(ReplicatedStorage.Shared.HighwayMath)
local Traffic = require(script.Parent.Traffic)
local CrashEffect = require(script.Parent.CrashEffect)
local CrashMath = require(ReplicatedStorage.Shared.CrashMath)

-- This local handling lab must be deliberately redesigned before public release.
if Config.DevelopmentOnly and not RunService:IsStudio() then
	warn("[REDLINE COUNTY] Development build disabled outside Studio.")
	return
end

for _, name in { "Cars", "Characters", "Traffic", "Police", "Civilian", "Suspension" } do
	if not PhysicsService:IsCollisionGroupRegistered(name) then
		PhysicsService:RegisterCollisionGroup(name)
	end
end
-- Ghost vehicles while tuning. No ramming/pushing in garage or on the course.
PhysicsService:CollisionGroupSetCollidable("Cars", "Cars", false)
PhysicsService:CollisionGroupSetCollidable("Cars", "Characters", false)
PhysicsService:CollisionGroupSetCollidable("Cars", "Traffic", true)
PhysicsService:CollisionGroupSetCollidable("Characters", "Traffic", false)
PhysicsService:CollisionGroupSetCollidable("Traffic", "Traffic", false)
PhysicsService:CollisionGroupSetCollidable("Cars", "Police", true)
PhysicsService:CollisionGroupSetCollidable("Characters", "Police", false)
PhysicsService:CollisionGroupSetCollidable("Police", "Police", true)
PhysicsService:CollisionGroupSetCollidable("Cars", "Civilian", true)
PhysicsService:CollisionGroupSetCollidable("Police", "Civilian", true)
PhysicsService:CollisionGroupSetCollidable("Civilian", "Civilian", true)
PhysicsService:CollisionGroupSetCollidable("Characters", "Civilian", false)
for _, group in { "Cars", "Characters", "Traffic", "Police", "Civilian", "Suspension" } do
	PhysicsService:CollisionGroupSetCollidable("Suspension", group, false)
end
Course.build()
-- Preserve the isolated handling lab away from the geographic town origin.
local labOffset = Vector3.new(-6000, 0, 0)
workspace.HandlingCourse:PivotTo(workspace.HandlingCourse:GetPivot() + labOffset)
Course.Garage += labOffset
for i, pad in Course.Pads do
	Course.Pads[i] = pad + labOffset
end
for _, item in workspace.HandlingCourse:GetDescendants() do
	if item:IsA("SpawnLocation") then
		item.Enabled = false
	end
end
local folder = Instance.new("Folder")
folder.Name, folder.Parent = "Vehicles", workspace
local impactRay = RaycastParams.new()
impactRay.FilterDescendantsInstances = { folder }
impactRay.CollisionGroup = "Cars"
impactRay.RespectCanCollide = true
local remotes = Instance.new("Folder")
remotes.Name, remotes.Parent = "Remotes", ReplicatedStorage
local function remote(name: string): RemoteEvent
	local event = Instance.new("RemoteEvent")
	event.Name, event.Parent = name, remotes
	return event
end
local input, request, notice = remote("DriveInput"), remote("VehicleRequest"), remote("Notice")

type State = {
	car: Vehicle.Car?,
	throttle: number,
	steer: number,
	drift: boolean,
	driftScore: DriftRules.State,
	lastInput: number,
	lastOccupied: number,
	nextSpawn: number,
	nextReset: number,
	inputBucket: Rules.Bucket,
	requestBucket: Rules.Bucket,
	spawning: boolean,
	turboEnabled: boolean,
	trip: number,
	lastHighwayZ: number?,
	previousCF: CFrame?,
	previousVelocity: Vector3?,
	previousTime: number,
	crashUntil: number,
	crashKind: string,
	nextImpact: number,
	nextPursuit: number,
}
local states: { [Player]: State } = {}

local function tell(player: Player, message: string)
	player:SetAttribute("GarageMessage", message)
	notice:FireClient(player, message)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end

local function driving(player: Player, car: Vehicle.Car): boolean
	local occupant = car.Seat.Occupant
	return occupant ~= nil and occupant.Health > 0 and occupant.Parent == player.Character
end

local function clear(state: State)
	state.driftScore = DriftRules.new()
	if state.car then
		local owner = Players:GetPlayerByUserId(state.car.Model:GetAttribute("OwnerId") :: number)
		if owner then
			Getaway.cancel(owner, "JOB LOST · Vehicle removed. Choose a new contract at home.")
			Garage.hideDisplay(owner, false)
		end
		state.car.Model:Destroy()
		state.car = nil
	end
	state.throttle, state.steer, state.drift = 0, 0, false
	state.previousCF = nil
end

local function labPad(exclude: Model?): CFrame?
	local overlap = OverlapParams.new()
	local ignore: { Instance } = { workspace.HandlingCourse }
	if exclude then
		table.insert(ignore, exclude)
	end
	overlap.FilterDescendantsInstances = ignore
	-- Query includes non-colliding car trim and character roots, so occupied pads remain blocked.
	for _, pad in Course.Pads do
		if #workspace:GetPartBoundsInBox(pad, Vector3.new(18, 7, 25), overlap) == 0 then
			return pad
		end
	end
	return nil
end

local function hookEntry(player: Player, car: Vehicle.Car)
	local prompt = car.Model:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
	prompt.Triggered:Connect(function(who: Player)
		local root = rootOf(who)
		local humanoid = if who.Character then who.Character:FindFirstChildOfClass("Humanoid") else nil
		if
			who ~= player
			or car.Model:GetAttribute("Crashed")
			or not root
			or not humanoid
			or humanoid.Health <= 0
			or car.Seat.Occupant
			or humanoid.SeatPart
		then
			return
		end
		if
			(root.Position - car.Seat.Position).Magnitude > 14
			or car.Body.AssemblyLinearVelocity.Magnitude > 8
		then
			return
		end
		local ray = RaycastParams.new()
		ray.FilterDescendantsInstances = { who.Character :: Model, car.Model }
		ray.RespectCanCollide = true
		if workspace:Raycast(root.Position, car.Seat.Position - root.Position, ray) then
			tell(player, "Walk beside your car; something solid is between you and the driver's seat.")
			return
		end
		car.Seat:Sit(humanoid)
	end)
	car.Seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = car.Seat.Occupant
		if occupant and occupant.Parent ~= player.Character then
			occupant.Sit = false
		end
		prompt.Enabled = occupant == nil and not car.Model:GetAttribute("Crashed")
		-- Seat welds can change assemblies; reassert server ownership after seating.
		if car.Body.Parent and not car.Body.Anchored then
			car.Body:SetNetworkOwner(nil)
		end
	end)
end

local function spawnCar(player: Player, kind: string, initial: boolean?)
	if Getaway.active(player) then
		tell(player, "Finish or abandon your contract before changing cars.")
		return
	end
	local state, root = states[player], rootOf(player)
	if not state or not root or state.spawning then
		return
	end
	if not (Config.Cars :: any)[kind] then
		tell(player, "Unknown vehicle.")
		return
	end
	local now = os.clock()
	local old = state.car
	local speed = if old then old.Body.AssemblyLinearVelocity.Magnitude else 0
	local other = old ~= nil and old.Seat.Occupant ~= nil and not driving(player, old)
	if
		not (
			initial
			or GarageRules.canSelect(
				(root.Position - Garage.Center).Magnitude,
				speed,
				other,
				state.spawning,
				now,
				state.nextSpawn
			)
		)
	then
		tell(player, "Stop at the garage to change cars; spawn cooldown is 4 seconds.")
		return
	end
	if not old and #folder:GetChildren() >= Config.MaxVehicles then
		tell(player, "All 12 vehicles are in use. Try again shortly.")
		return
	end
	local pad = if initial then Highway.entry() else Garage.pad(player, if old then old.Model else nil)
	if not pad then
		tell(player, "Your bay is occupied, or all three home bays are assigned. Clear it and retry.")
		return
	end
	if initial then
		local entry = Highway.entry()
		local found = false
		for slot = 0, Config.MaxVehicles - 1 do
			local candidate = entry + Vector3.new(0, 0, slot * 24)
			local available = true
			for _, otherState in states do
				if otherState.car and (otherState.car.Body.Position - candidate.Position).Magnitude < 18 then
					available = false
					break
				end
			end
			if available then
				pad = candidate
				found = true
				break
			end
		end
		if not found then
			tell(player, "Highway starting bays occupied. Try again shortly.")
			return
		end
	end
	state.spawning = true
	state.nextSpawn = now + Config.SpawnCooldown
	clear(state)
	local car = Vehicle.create(folder, player, kind, pad)
	state.car, state.spawning = car, false
	Workshop.apply(player, car)
	Garage.hideDisplay(player, true)
	car.Model:SetAttribute("TownMode", not initial)
	state.turboEnabled = initial == true and kind ~= "Electric" and kind ~= "Pickup"
	state.lastOccupied = now
	state.trip, state.lastHighwayZ = 0, nil
	car.Model:SetAttribute("TurboEnabled", state.turboEnabled)
	if initial then
		car.Model:SetAttribute("Highway", true)
		car.Model:SetAttribute("TownMode", false)
		car.Model:SetAttribute("TripStuds", 0)
		state.lastHighwayZ = pad.Position.Z
		if player.Character then
			player.Character:PivotTo(pad * CFrame.new(8, 1, 0))
		end
	end
	hookEntry(player, car)
	tell(
		player,
		if initial
			then "SAFE ON-RAMP · Press E, accelerate, then merge left at the sign. Traffic impacts destroy your car."
			else kind
				.. " ready in bay "
				.. tostring(player:GetAttribute("HomeBay"))
				.. ". Open that bay's wall switch with E, then E beside your car to drive."
	)
end

local function resetCar(player: Player): boolean
	local state, root = states[player], rootOf(player)
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not state or not root or not character or not humanoid or humanoid.Health <= 0 then
		tell(player, "Wait for your character to respawn, then retry.")
		return false
	end
	local car, now = state.car, os.clock()
	local finished = Getaway.retryInfo(player) ~= nil
	if now < state.nextReset then
		tell(player, "Recovery cooling down. Try again in a few seconds.")
		return false
	end
	if humanoid.SeatPart and (not car or humanoid.SeatPart ~= car.Seat) then
		tell(player, "Leave the other vehicle before recovering.")
		return false
	end
	if car and car.Seat.Occupant and not driving(player, car) then
		tell(player, "Your car is occupied. Wait until its driver leaves.")
		return false
	end
	if
		car
		and not finished
		and not Rules.canReset(
			car.Body.AssemblyLinearVelocity.Magnitude,
			car.Body.CFrame.UpVector.Y,
			driving(player, car),
			(root.Position - car.Body.Position).Magnitude,
			Config.Lifecycle
		)
	then
		tell(player, "Stop first, or slow down while overturned. Stay beside your own car.")
		return false
	end
	local pad = Garage.pad(player, if car then car.Model else nil)
	if not pad then
		tell(player, "Garage bay occupied. Clear it and retry.")
		return false
	end
	Getaway.cancel(player, "Job abandoned for recovery. Choose a new contract at home.")
	-- Detach before teleporting: moving a still-welded rider can drag the car back out of its bay.
	humanoid.Sit = false
	if car then
		local weld = car.Seat:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
		car.Model:SetAttribute("Damage", 0)
		car.Model:SetAttribute("Highway", false)
		car.Model:SetAttribute("TownMode", true)
		car.Model:PivotTo(pad)
		car.Body.AssemblyLinearVelocity, car.Body.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		car.Align.CFrame = pad.Rotation
		car.Body:SetNetworkOwner(nil)
	end
	character:PivotTo(Garage.spawnPoint(player))
	root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	state.nextReset = now + Config.ResetCooldown
	state.throttle, state.steer, state.drift = 0, 0, false
	state.driftScore = DriftRules.new()
	state.lastHighwayZ, state.previousCF, state.previousVelocity = nil, nil, nil
	state.lastOccupied, state.nextImpact = now, now + 2
	state.nextPursuit = now + 5
	if not car then
		state.nextSpawn = 0
	end
	tell(player, "You and your car are back at the garage.")
	return true
end

local function enterHighway(player: Player)
	local state = states[player]
	if not state or not state.car then
		tell(player, "Spawn a car and sit in it first.")
		return
	end
	local car = state.car
	if not driving(player, car) or car.Body.AssemblyLinearVelocity.Magnitude > Config.Lifecycle.StopSpeed then
		tell(player, "Sit in your car and stop before entering the Autobahn.")
		return
	end
	if car.Model:GetAttribute("Highway") then
		tell(player, "Already on the Autobahn. Stop and use Recover to return.")
		return
	end
	if os.clock() < state.nextReset then
		tell(player, "Travel cooling down.")
		return
	end
	local pad = Highway.entry()
	-- Choose a clear launch point along the shoulder. Ghost cars still get distinct launch spaces.
	local found = false
	for slot = 0, Config.MaxVehicles - 1 do
		local candidate = pad + Vector3.new(0, 0, slot * 24)
		local entryClear = true
		for _, other in states do
			if
				other.car
				and other.car ~= car
				and (other.car.Body.Position - candidate.Position).Magnitude < 18
			then
				entryClear = false
				break
			end
		end
		if entryClear then
			pad = candidate
			found = true
			break
		end
	end
	if not found then
		tell(player, "Highway entry is occupied. Try again shortly.")
		return
	end
	state.nextReset = os.clock() + Config.ResetCooldown
	state.throttle, state.steer, state.drift = 0, 0, false
	state.trip, state.lastHighwayZ = 0, pad.Position.Z
	state.previousCF = nil
	car.Model:SetAttribute("Highway", true)
	car.Model:SetAttribute("TripStuds", 0)
	car.Model:SetAttribute("TownMode", false)
	car.Model:PivotTo(pad)
	car.Body.AssemblyLinearVelocity, car.Body.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	car.Align.CFrame, car.Steer = pad.Rotation, 0
	car.Body:SetNetworkOwner(nil)
	tell(player, "SAFE ON-RAMP · Follow the acceleration lane and merge left. Stop + R to return.")
end

local function crashCar(player: Player, state: State, contactTime: number)
	local car = state.car
	if not car or not CrashMath.canBegin(state.crashUntil > 0, true) then
		return
	end
	state.crashUntil = os.clock() + Config.Crash.RecoverySeconds
	state.nextSpawn, state.nextReset = state.crashUntil, state.crashUntil
	state.crashKind = car.Model:GetAttribute("Kind") :: string
	car.Model:SetAttribute("Crashed", true)
	state.throttle, state.steer, state.drift = 0, 0, false
	-- Stop at first swept contact, rather than leaving the wreck on the far side of traffic.
	if state.previousCF then
		car.Model:PivotTo(state.previousCF:Lerp(car.Body.CFrame, contactTime))
	end
	car.Body.AssemblyLinearVelocity, car.Body.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	car.Body.Anchored = true
	car.Drive.Force = Vector3.zero
	car.Align.Enabled = false
	for _, spring in car.Springs do
		spring.Force = Vector3.zero
	end
	local prompt = car.Model:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Enabled = false
	end
	CrashEffect.show(car.Model, car.Body)
	tell(player, "CRASH! Car destroyed. Replacement at the safe on-ramp in 3 seconds.")
end

input.OnServerEvent:Connect(function(player: Player, throttle: any, steer: any, drift: any)
	local state, now = states[player], os.clock()
	if not state or not Rules.consume(state.inputBucket, now, 35, 45) then
		return
	end
	if
		not Driving.validInput(throttle, steer, drift)
		or state.crashUntil > 0
		or not state.car
		or not driving(player, state.car)
	then
		return
	end
	state.throttle, state.steer, state.drift, state.lastInput = throttle, steer, drift, now
end)

request.OnServerEvent:Connect(function(player: Player, action: any, kind: any, option: any)
	local state, now = states[player], os.clock()
	if not state or not Rules.consume(state.requestBucket, now, 2, 3) then
		return
	end
	if state.crashUntil > 0 then
		tell(player, "Crash recovery in progress…")
		return
	end

	if action == "RetryMission" or action == "ReturnHome" then
		local contract, difficulty = Getaway.retryInfo(player)
		if not contract then
			tell(player, "Finish or abandon the current run before retrying.")
			return
		end
		if not resetCar(player) then
			return
		end
		if action == "ReturnHome" then
			Getaway.remove(player)
			player:SetAttribute("MissionPhase", "idle")
			notice:FireClient(
				player,
				"Ready for your next run.",
				if kind == "workshop" then "workshop" else "jobs"
			)
			return
		end
		-- Continue through the ordinary mission validation and seating path.
		action, kind, option = "Mission", contract, difficulty
	end

	if (action == "Upgrade" or action == "Cosmetic") and type(kind) == "string" and #kind < 20 then
		local car = state.car
		local root = rootOf(player)
		if not car or not root then
			tell(player, "Select a car at home before fitting upgrades.")
			return
		end
		local atHome = (root.Position - Garage.Center).Magnitude < 85
			and (car.Body.Position - Garage.Center).Magnitude < 85
			and car.Body.AssemblyLinearVelocity.Magnitude < 2
			and (not car.Seat.Occupant or driving(player, car))
		tell(
			player,
			if action == "Cosmetic"
				then Workshop.cosmetic(player, car, kind, atHome, Getaway.active(player))
				else Workshop.buy(player, car, kind, atHome, Getaway.active(player))
		)
		return
	end
	if action == "HeatChoice" then
		if type(kind) == "string" then
			Getaway.choose(player, kind)
		end
		return
	end
	if action == "CancelMission" then
		Getaway.cancel(player, "Job abandoned. Return home for another contract.")
		return
	end
	if
		Getaway.active(player)
		and (action == "Mission" or action == "Spawn" or action == "Lab" or action == "Highway")
	then
		tell(player, "Finish or abandon the current contract first. R abandons it and recovers your car.")
		return
	end
	if action == "Mission" then
		local root = rootOf(player)
		local humanoid = if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
		local known = Progression.difficulty(option or "light") ~= nil
		local knownContract = false
		for _, contract in require(ReplicatedStorage.Shared.Contracts) do
			if contract.Id == kind then
				knownContract = true
			end
		end
		if
			not known
			or not knownContract
			or not root
			or not humanoid
			or humanoid.Health <= 0
			or (root.Position - Garage.Center).Magnitude > 85
		then
			tell(player, "Return to the home garage to start a contract.")
			return
		end
		if not state.car then
			spawnCar(player, (player:GetAttribute("SelectedCar") :: string?) or "Electric")
		end
		local car = state.car
		if
			not car
			or car.Model:GetAttribute("Highway")
			or (car.Body.Position - Garage.Center).Magnitude > 85
			or car.Body.AssemblyLinearVelocity.Magnitude > 2
			or (car.Seat.Occupant and not driving(player, car))
			or (humanoid.SeatPart and humanoid.SeatPart ~= car.Seat)
		then
			tell(player, "Stop your car at home before starting a contract.")
			return
		end
		if Getaway.start(player, car, kind, option or "light") then
			Garage.openFor(player)
			car.Seat:Sit(humanoid)
			tell(player, "GETAWAY · Follow the cyan route. Gold marker = pickup. Green marker = home.")
		end
		return
	end
	if
		action == "Lab"
		and state.car
		and driving(player, state.car)
		and state.car.Body.AssemblyLinearVelocity.Magnitude < 2
	then
		local pad = labPad(state.car.Model)
		if pad then
			state.car.Model:SetAttribute("Highway", false)
			state.car.Model:SetAttribute("TownMode", true)
			state.car.Model:PivotTo(pad)
			state.car.Body.AssemblyLinearVelocity = Vector3.zero
			state.previousCF = nil
			tell(player, "ISOLATED HANDLING LAB · V camera, G diagnostics, R home.")
		end
	elseif action == "Spawn" and type(kind) == "string" and #kind <= 20 then
		spawnCar(player, kind)
	elseif action == "Reset" then
		if resetCar(player) then
			Getaway.remove(player)
			player:SetAttribute("MissionPhase", "idle")
		end
	elseif action == "Highway" then
		enterHighway(player)
	elseif action == "Turbo" and state.car and driving(player, state.car) then
		if
			state.car.Model:GetAttribute("Kind") == "Electric"
			or state.car.Model:GetAttribute("Kind") == "Pickup"
		then
			tell(player, "This collection vehicle has no turbo.")
			return
		end
		state.turboEnabled = not state.turboEnabled
		state.car.Model:SetAttribute("TurboEnabled", state.turboEnabled)
		tell(
			player,
			if state.turboEnabled then "Turbo armed: accelerate to build boost." else "Turbo switched off."
		)
	end
end)

local joining: { [Player]: boolean } = {}
local PlaytestMetrics = require(script.Parent.PlaytestMetrics)
local function joined(player: Player)
	if states[player] or joining[player] then
		return
	end
	joining[player] = true
	local now = os.clock()
	if not Garage.claim(player) then
		player:Kick("This three-driver garage is full. Please join another server.")
		return
	end
	if not Workshop.init(player) or not player.Parent then
		return
	end
	player:SetAttribute("MissionPhase", "idle")
	states[player] = {
		car = nil,
		throttle = 0,
		steer = 0,
		drift = false,
		driftScore = DriftRules.new(),
		lastInput = 0,
		lastOccupied = now,
		nextSpawn = 0,
		nextReset = 0,
		spawning = false,
		turboEnabled = true,
		trip = 0,
		lastHighwayZ = nil,
		previousCF = nil,
		previousTime = workspace:GetServerTimeNow(),
		crashUntil = 0,
		crashKind = "Compact",
		nextImpact = 0,
		nextPursuit = 0,
		inputBucket = { tokens = 45, updated = now },
		requestBucket = { tokens = 3, updated = now },
	}
	local function characterAdded(character: Model)
		local function collision(item: Instance)
			if item:IsA("BasePart") then
				item.CollisionGroup = "Characters"
			end
		end
		for _, item in character:GetDescendants() do
			collision(item)
		end
		character.DescendantAdded:Connect(collision)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		character:WaitForChild("HumanoidRootPart", 10)
		if humanoid then
			humanoid.Died:Connect(function()
				local state = states[player]
				if state then
					clear(state)
				end -- Timers are kept through character resets.
			end)
		end
		task.delay(1, function()
			if states[player] and player.Character == character and not states[player].car then
				local arrival = Garage.spawnPoint(player)
				character:PivotTo(arrival)
				character:SetAttribute("GarageArrival", arrival)
				tell(
					player,
					"HOPEDALE HOME · E beside a display to select, or click Pickup / Electric / Sport. Your car appears in bay "
						.. tostring(player:GetAttribute("HomeBay"))
						.. "."
				)
			end
		end)
	end
	player.CharacterAdded:Connect(characterAdded)
	if player.Character then
		task.spawn(characterAdded, player.Character)
	end
end
Garage.bind(spawnCar)
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player)
	joining[player] = nil
	PlaytestMetrics.remove(player)
	Getaway.remove(player)
	Workshop.remove(player)
	Circuit.remove(player)
	if states[player] then
		clear(states[player])
		states[player] = nil
	end
end)
for _, player in Players:GetPlayers() do
	joined(player)
end

RunService.PreSimulation:Connect(function(dt: number)
	local now = os.clock()
	Highway.update(dt, folder)
	Traffic.move()
	local trafficTime = workspace:GetServerTimeNow()
	for player, state in states do
		if state.crashUntil > 0 then
			local root = rootOf(player)
			local humanoid = if player.Character
				then player.Character:FindFirstChildOfClass("Humanoid")
				else nil
			if now >= state.crashUntil and root and humanoid and humanoid.Health > 0 then
				clear(state)
				humanoid.Sit = false
				(player.Character :: Model):PivotTo(CFrame.new(Course.Garage + Vector3.new(0, 6, 0)))
				root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				state.crashUntil, state.nextSpawn = 0, 0
				spawnCar(player, state.crashKind, true)
			end
			continue
		end
		local root = rootOf(player)
		if root and math.floor(now * 2) ~= (player:GetAttribute("DiscoveryTick") or -1) then
			player:SetAttribute("DiscoveryTick", math.floor(now * 2))
			for _, site in require(ReplicatedStorage.Shared.TownMap).Discoveries do
				if
					(root.Position - site.Position).Magnitude < 65 and Workshop.discover(player, site.Name)
				then
					tell(player, "DISCOVERED " .. site.Name .. " · +$150 for your next upgrade")
				end
			end
		end
		local car = state.car
		if car and car.Body.AssemblyLinearVelocity.Magnitude > 8 then
			player:SetAttribute("HasDriven", true)
			PlaytestMetrics.mark(player, "first_movement", nil, true)
		end
		if not car then
			state.driftScore = DriftRules.new()
			Circuit.step(player, nil, dt, false)
			continue
		end
		local occupied = driving(player, car)
		local lapMessage = Circuit.step(player, car, dt, occupied)
		if lapMessage then
			tell(player, lapMessage)
		end
		if
			occupied
			and not car.Model:GetAttribute("Highway")
			and not Getaway.active(player)
			and now >= state.nextPursuit
			and Units.kmh(car.Body.AssemblyLinearVelocity.Magnitude) > 80
		then
			local nearby = workspace:FindFirstChild("TownTraffic")
			if nearby then
				for _, patrol in nearby:GetChildren() do
					if
						patrol:IsA("Model")
						and patrol.PrimaryPart
						and patrol:GetAttribute("Police")
						and (patrol.PrimaryPart.Position - car.Body.Position).Magnitude < 180
					then
						local ray = RaycastParams.new()
						ray.FilterDescendantsInstances = { folder, nearby }
						ray.RespectCanCollide = true
						if
							not workspace:Raycast(
								patrol.PrimaryPart.Position,
								car.Body.Position - patrol.PrimaryPart.Position,
								ray
							)
						then
							Getaway.provoke(player, car)
							state.nextPursuit = now + 45
							break
						end
					end
				end
			end
		end
		if car.Model:GetAttribute("Highway") then
			local contact = Traffic.contact(
				car.Body,
				state.previousCF,
				if state.previousCF then state.previousTime else trafficTime,
				trafficTime
			)
			if contact then
				crashCar(player, state, contact)
				continue
			end
		end
		if car.Model:GetAttribute("TownMode") and state.previousCF and now >= state.nextImpact then
			local delta = car.Body.Position - state.previousCF.Position
			if delta.Magnitude > 0.01 and delta.Magnitude < 100 then
				local hit = workspace:Blockcast(state.previousCF, car.Body.Size, delta, impactRay)
				if hit and math.abs(hit.Normal.Y) < 0.7 then
					local impact = Units.kmh(
						math.abs((state.previousVelocity or car.Body.AssemblyLinearVelocity):Dot(hit.Normal))
					)
					local damage = GarageRules.damage(impact)
					if damage > 0 then
						local total =
							math.min(100, ((car.Model:GetAttribute("Damage") :: number?) or 0) + damage)
						car.Model:SetAttribute("Damage", total)
						state.nextImpact = now + 1
						tell(
							player,
							if total >= 100
								then "Vehicle disabled by repeated impacts. Stop + R to repair at home."
								else "Impact · damage " .. total .. "%. Slow down; R repairs at home."
						)
					end
				end
			end
		end
		if ((car.Model:GetAttribute("Damage") :: number?) or 0) >= 100 then
			state.throttle = 0
		end
		if occupied then
			state.lastOccupied = now
		end
		if not occupied or now - state.lastInput > Config.InputTimeout then
			state.throttle, state.steer, state.drift = 0, 0, false
		end
		if
			car.Body.Position.Y < -35
			or not Driving.finite(car.Body.Position.X)
			or car.Body.AssemblyLinearVelocity.Magnitude > Config.PhysicsSpeedLimit
		then
			clear(state)
			tell(
				player,
				"Vehicle removed after leaving the course or exceeding the physics limit. Return to the garage."
			)
		elseif not occupied and now - state.lastOccupied > Config.AbandonedSeconds then
			clear(state)
			tell(player, "Unused car returned to the garage. Spawn another when ready.")
		else
			if car.Model:GetAttribute("Highway") then
				Highway.wrapCar(car.Model, car.Body)
				local z = car.Body.Position.Z
				if state.lastHighwayZ then
					state.trip += HighwayMath.travel(
						state.lastHighwayZ,
						z,
						Config.Highway.HalfLength,
						Config.PhysicsSpeedLimit * math.min(dt, 0.25) + 5
					)
				end
				state.lastHighwayZ = z
			end
			Vehicle.step(
				car,
				math.min(dt, 1 / 20),
				state.throttle,
				state.steer,
				state.drift,
				state.turboEnabled and occupied
			)
			local velocity = car.Body.AssemblyLinearVelocity
			local bank, score = DriftRules.step(
				state.driftScore,
				dt,
				velocity:Dot(car.Body.CFrame.LookVector),
				velocity:Dot(car.Body.CFrame.RightVector),
				((car.Model:GetAttribute("GroundedWheels") :: number?) or 0) >= 3,
				((car.Model:GetAttribute("Damage") :: number?) or 0),
				occupied and car.Model:GetAttribute("TownMode") == true
			)
			if bank > 0 then
				Workshop.credit(player, bank)
				player:SetAttribute(
					"BestDrift",
					math.max(score, (player:GetAttribute("BestDrift") :: number?) or 0)
				)
				tell(player, "DRIFT BANKED · " .. score .. " points · +$" .. bank)
			end
			if car.TelemetryClock == 0 then
				car.Model:SetAttribute("DriftPoints", math.floor(state.driftScore.points))
			end
			state.previousCF, state.previousTime = car.Body.CFrame, trafficTime
			state.previousVelocity = car.Body.AssemblyLinearVelocity
			if car.TelemetryClock == 0 then
				car.Model:SetAttribute("TripStuds", math.floor(state.trip))
			end
		end
	end
	debug.profilebegin("Redline.Traffic")
	TownTraffic.step(dt)
	debug.profileend()
	debug.profilebegin("Redline.PoliceMissions")
	Getaway.step(dt)
	debug.profileend()
end)
print(
	"[REDLINE COUNTY] Getaway contracts + AI police ready. Saved garage with local practice fallback; Studio development build."
)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">PlaytestMetrics</string>
          <string name="Source"><![CDATA[--!strict
-- Aggregate session counters and anonymous run records in Studio Output only.
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Metrics = {}
local starts: { [Player]: number } = {}
local once: { [Player]: { [string]: boolean } } = {}
function Metrics.mark(player: Player, event: string, details: { [string]: any }?, unique: boolean?)
	if not RunService:IsStudio() then
		return
	end
	starts[player] = starts[player] or os.clock()
	once[player] = once[player] or {}
	if unique and once[player][event] then
		return
	end
	once[player][event] = true
	local key = "Funnel_" .. event
	workspace:SetAttribute(key, ((workspace:GetAttribute(key) :: number?) or 0) + 1)
	print("[REDLINE PLAYTEST] " .. HttpService:JSONEncode({
		event = event,
		seconds = math.floor(os.clock() - starts[player]),
		details = details or {},
	}))
end
function Metrics.remove(player: Player)
	starts[player] = nil
	once[player] = nil
end
return Metrics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Rules = require(game:GetService("ReplicatedStorage").Shared.ProfileRules)
local Store = {}
type Session = {
	data: Rules.Profile,
	token: string,
	persistent: boolean,
	busy: boolean,
	closing: boolean,
	lease: number,
}
local sessions: { [Player]: Session } = {}
local backend: GlobalDataStore? = nil
if game.GameId > 0 then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(
			if RunService:IsStudio() then "RedlineProfiles_Studio_v1" else "RedlineProfiles_v1"
		)
	end)
	if ok then
		backend = result
	end
end
local function copy(data: Rules.Profile): Rules.Profile
	return HttpService:JSONDecode(HttpService:JSONEncode(data)) :: Rules.Profile
end
function Store.get(player: Player): Rules.Profile?
	local session = sessions[player]
	if not session or session.closing then
		return nil
	end
	if session.persistent and os.time() >= session.lease then
		session.closing = true
		player:Kick("Your save connection expired. Rejoin to safely reload your garage.")
		return nil
	end
	return session.data
end
function Store.load(player: Player): boolean
	player:SetAttribute("SaveStatus", "Loading garage")
	local token = HttpService:GenerateGUID(false)
	local data: Rules.Profile? = nil
	local persistent = false
	if backend then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (backend :: GlobalDataStore):UpdateAsync("User_" .. player.UserId, function(old)
					return Rules.acquire(old, token, os.time())
				end)
			end)
			if ok and result and result.owner == token then
				data = result.data
				persistent = true
				break
			end
			if ok then
				break
			end -- locked/invalid profiles must never become a new empty save
			if attempt < 3 then
				task.wait(attempt + math.random())
			end
		end
	end
	if not data then
		if game.GameId > 0 then
			player:SetAttribute("SaveStatus", "Garage unavailable")
			player:Kick(
				"Your garage could not be safely loaded. Please retry. In Studio, enable API access for a published test experience."
			)
			return false
		end
		data = Rules.new() -- unpublished local files have no Roblox data store; never claim persistence
	end
	sessions[player] = {
		data = data :: Rules.Profile,
		token = token,
		persistent = persistent,
		busy = false,
		closing = false,
		lease = os.time() + 180,
	}
	player:SetAttribute(
		"SaveStatus",
		if persistent then "Saved garage" else "Local practice · saves unavailable"
	)
	if not player.Parent then
		task.defer(Store.save, player, true)
		return false
	end
	player:SetAttribute("ProfileReady", true)
	return true
end
function Store.save(player: Player, release: boolean?): boolean
	local s = sessions[player]
	if not s then
		return false
	end
	if release then
		s.closing = true
	end
	while s.busy do
		task.wait(0.05)
	end
	if not s.persistent then
		if release then
			sessions[player] = nil
		end
		return true
	end
	s.busy = true
	local snapshot = copy(s.data)
	local success = false
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return (backend :: GlobalDataStore):UpdateAsync("User_" .. player.UserId, function(old)
				return Rules.commit(old, s.token, os.time(), snapshot, release == true)
			end)
		end)
		if ok and result and (result.owner == s.token or release and result.owner == "") then
			success = true
			s.lease = os.time() + 180
			break
		end
		if ok then
			break
		end
		if attempt < 3 then
			task.wait(attempt + math.random())
		end
	end
	s.busy = false
	player:SetAttribute(
		"SaveStatus",
		if success then "Garage saved" else "Save pending · reconnect only after saved"
	)
	if release then
		sessions[player] = nil
	end
	return success
end
function Store.changed(player: Player)
	local s = sessions[player]
	if not s or s.closing then
		return
	end
	if s.persistent then
		player:SetAttribute("SaveStatus", "Saving garage")
	end
	-- Coalesce purchase/reward saves while serializing all writes to this profile.
	if player:GetAttribute("SaveQueued") then
		return
	end
	player:SetAttribute("SaveQueued", true)
	task.delay(2, function()
		player:SetAttribute("SaveQueued", false)
		if sessions[player] and not sessions[player].closing then
			Store.save(player)
		end
	end)
end
Players.PlayerRemoving:Connect(function(player)
	Store.save(player, true)
end)
task.spawn(function()
	while true do
		task.wait(40 + math.random() * 5)
		for player, s in sessions do
			if not s.closing then
				task.spawn(Store.save, player)
			end
		end
	end
end)
game:BindToClose(function()
	for player in sessions do
		task.spawn(Store.save, player, true)
	end
	local deadline = os.clock() + 25
	while next(sessions) and os.clock() < deadline do
		task.wait(0.1)
	end
end)
return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Roadblock</string>
          <string name="Source"><![CDATA[--!strict
-- One announced, half-width parkway barrier per heat run. No instant contact spawns.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Map = require(Shared.TownMap)
local Math = require(Shared.TownTrafficMath)
local points = {}
for _, p in Map.Course do
	table.insert(points, { x = p.X, z = p.Z })
end
local route = Math.route(points, false)
local Roadblock = {}
export type Block = { model: Model, position: Vector3, expires: number }
local function clearForAll(position: Vector3): boolean
	for _, player in Players:GetPlayers() do
		local root = if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
		if root and root:IsA("BasePart") and (root.Position - position).Magnitude < 500 then
			return false
		end
	end
	local params = OverlapParams.new()
	params.RespectCanCollide = true
	return #workspace:GetPartBoundsInBox(
		CFrame.new(position + Vector3.new(0, 3, 0)),
		Vector3.new(24, 4, 24),
		params
	) == 0
end
function Roadblock.deploy(owner: Player, last: Vector3, velocity: Vector3): Block?
	local progress = Math.project(route, { x = last.X, z = last.Z })
	local here = Math.sample(route, progress)
	if Vector2.new(last.X - here.x, last.Z - here.z).Magnitude > 65 then
		return nil
	end
	local q = Math.sample(route, progress + 20)
	local sign = if Vector3.new(q.x - here.x, 0, q.z - here.z):Dot(velocity) >= 0 then 1 else -1
	local along = progress + sign * math.max(800, math.min(1500, velocity.Magnitude * 6))
	local p, ahead = Math.sample(route, along), Math.sample(route, along + sign * 10)
	local position = Vector3.new(p.x, 32, p.z)
	if not clearForAll(position) then
		return nil
	end
	-- Stay in one lane. More than 5 m of the 12 m road remains open on the opposite side.
	local cf = CFrame.lookAt(position, Vector3.new(ahead.x, 32, ahead.z))
	local model = Instance.new("Model")
	model.Name = "AnnouncedRoadblock"
	local barrier = Instance.new("Part")
	barrier.Name = "Barrier"
	barrier.Anchored = true
	barrier.Size = Vector3.new(13, 3, 2)
	barrier.CFrame = cf * CFrame.new(0, 1.5, 0)
	barrier.Material = Enum.Material.Metal
	barrier.Color = Color3.fromRGB(224, 174, 53)
	barrier.Parent = model
	for _, x in { -5, 5 } do
		local lamp = Instance.new("Part")
		lamp.Name = "Beacon"
		lamp.Anchored = true
		lamp.CanCollide = false
		lamp.CanTouch = false
		lamp.CanQuery = false
		lamp.Material = Enum.Material.Neon
		lamp.Color = Color3.fromRGB(235, 142, 40)
		lamp.Size = Vector3.new(1, 1, 1)
		lamp.CFrame = cf * CFrame.new(x, 3.5, 0)
		lamp.Parent = model
	end
	model.Parent = workspace
	owner:SetAttribute("RoadblockPosition", position)
	owner:SetAttribute(
		"MissionMessage",
		"DISPATCH · Roadblock ahead on the parkway. Opposite lane or town exit remains open."
	)
	return { model = model, position = position, expires = os.clock() + 55 }
end
function Roadblock.clear(owner: Player, block: Block?)
	if block then
		block.model:Destroy()
	end
	owner:SetAttribute("RoadblockPosition", nil)
end
return Roadblock
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">TownGarage</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Map = require(ReplicatedStorage.Shared.TownMap)
local Rules = require(ReplicatedStorage.Shared.GarageRules)
local Finish = require(script.Parent.VehicleFinish)
local Garage = {}
Garage.Center = Map.Garage + Vector3.new(0, 0, 8 / 0.28)
local home = workspace:WaitForChild("HopedaleLandmarks"):WaitForChild("HomeBase")
local owners: { [number]: Player } = {}
local bays: { [Player]: number } = {}
local open: { [number]: boolean } = {}
local busy: { [number]: boolean } = {}
local selection: ((Player, string) -> ())? = nil
local openers: { [number]: (Player) -> () } = {}
function Garage.openFor(player: Player)
	local bay = bays[player]
	if bay and openers[bay] and not open[bay] and not busy[bay] then
		openers[bay](player)
	end
end
local offsets = { -27, 0, 27 }
local kinds = { "Pickup", "Electric", "Sport" }
for i, kind in kinds do
	local display = home:FindFirstChild("Display_" .. kind)
	if display and display:IsA("Model") then
		Finish.prepare(display, false)
		Finish.apply(
			display,
			"Paint",
			({ Color3.fromRGB(79, 100, 87), Color3.fromRGB(199, 201, 190), Color3.fromRGB(133, 44, 38) })[i]
		)
		for _, part in display:GetDescendants() do
			if part:IsA("BasePart") then
				part:SetAttribute("DisplayTransparency", part.Transparency)
			end
		end
	end
end
local function root(player: Player): BasePart?
	return if player.Character then player.Character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end
function Garage.claim(player: Player): number?
	if bays[player] then
		return bays[player]
	end
	for i = 1, 3 do
		if not owners[i] then
			owners[i], bays[player] = player, i
			player:SetAttribute("HomeBay", i)
			return i
		end
	end
	return nil
end
function Garage.spawnPoint(player: Player): CFrame
	local bay = Garage.claim(player) or 3
	return (home:WaitForChild("Arrival_" .. bay) :: BasePart).CFrame
end
function Garage.pad(player: Player, exclude: Model?): CFrame?
	local bay = Garage.claim(player)
	if not bay then
		return nil
	end
	local cf = CFrame.new(Garage.Center + Vector3.new(offsets[bay], 3, 2))
	local params = OverlapParams.new()
	local ignore: { Instance } = { home }
	if exclude then
		table.insert(ignore, exclude)
	end
	if player.Character then
		table.insert(ignore, player.Character)
	end
	params.FilterDescendantsInstances = ignore
	for _, part in workspace:GetPartBoundsInBox(cf, Vector3.new(12, 10, 24), params) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and (model:GetAttribute("OwnerId") ~= nil or Players:GetPlayerFromCharacter(model)) then
			return nil
		end
	end
	return cf
end
function Garage.hideDisplay(player: Player, hide: boolean)
	local bay = bays[player]
	if not bay then
		return
	end
	local display = home:FindFirstChild("Display_" .. kinds[bay])
	if display then
		for _, item in display:GetDescendants() do
			if item:IsA("BasePart") then
				item.Transparency = if hide
					then 1
					else (item:GetAttribute("DisplayTransparency") :: number?) or 0
				item.CanCollide = not hide and item.Name == "Body"
				item.CanQuery = item.CanCollide
			elseif item:IsA("SurfaceGui") then
				item.Enabled = not hide
			end
		end
	end
	local marker = home:FindFirstChild("Select_" .. kinds[bay])
	local prompt = if marker then marker:FindFirstChildOfClass("ProximityPrompt") else nil
	if prompt then
		prompt.Enabled = not hide
	end
end
function Garage.bind(callback: (Player, string) -> ())
	selection = callback
end
for i, x in offsets do
	local door = home:WaitForChild("Door_" .. x) :: BasePart
	local closed = door.CFrame
	local button = home:WaitForChild("DoorButton_" .. x) :: BasePart
	-- Decorative ribs follow the panel, not the stationary wall.
	local ribs: { { part: BasePart, rest: CFrame } } = {}
	for _, part in home:GetChildren() do
		if part:IsA("BasePart") and part.Name == "DoorWindow_" .. x then
			table.insert(ribs, { part = part, rest = part.CFrame })
		end
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText = "Open / close", "Garage door · bay " .. i
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 14
	prompt.Parent = button
	local function operate(player: Player, launch: boolean?)
		local r = root(player)
		if not r or busy[i] then
			return
		end
		local blocked = false
		if open[i] then
			local params = OverlapParams.new()
			params.FilterDescendantsInstances = { home }
			for _, part in workspace:GetPartBoundsInBox(closed, Vector3.new(25, 19, 7), params) do
				local ancestor = part:FindFirstAncestorOfClass("Model")
				if
					ancestor
					and (ancestor:GetAttribute("OwnerId") ~= nil or Players:GetPlayerFromCharacter(ancestor))
				then
					blocked = true
					break
				end
			end
		end
		local owner = owners[i]
		if
			not Rules.canUseDoor(
				if owner then owner.UserId else nil,
				player.UserId,
				if launch
						and bays[player] == i
						and (r.Position - Garage.Center).Magnitude < 85
					then 0
					else (r.Position - button.Position).Magnitude,
				blocked
			)
		then
			return
		end
		busy[i] = true
		open[i] = not open[i]
		-- Disable collision throughout motion to avoid pushing a car if it enters mid-close.
		door.CanCollide = false
		local target = if open[i] then closed + Vector3.new(0, 19, 0) else closed
		local tween = TweenService:Create(door, TweenInfo.new(1.5), { CFrame = target })
		for _, rib in ribs do
			TweenService:Create(
				rib.part,
				TweenInfo.new(1.5),
				{ CFrame = if open[i] then rib.rest + Vector3.new(0, 19, 0) else rib.rest }
			):Play()
		end
		tween:Play()
		tween.Completed:Once(function()
			if not open[i] then
				-- Recheck before making a closed door solid; reopen when anything entered during travel.
				local params = OverlapParams.new()
				params.FilterDescendantsInstances = { home }
				for _, part in workspace:GetPartBoundsInBox(closed, Vector3.new(25, 19, 7), params) do
					local a = part:FindFirstAncestorOfClass("Model")
					if a and (a:GetAttribute("OwnerId") ~= nil or Players:GetPlayerFromCharacter(a)) then
						open[i] = true
						door.CFrame = closed + Vector3.new(0, 19, 0)
						for _, rib in ribs do
							rib.part.CFrame = rib.rest + Vector3.new(0, 19, 0)
						end
						break
					end
				end
			end
			door.CanCollide = not open[i]
			busy[i] = false
		end)
	end
	openers[i] = function(player: Player)
		operate(player, true)
	end
	prompt.Triggered:Connect(function(player: Player)
		operate(player, false)
	end)
end
for _, kind in kinds do
	local marker = home:WaitForChild("Select_" .. kind) :: BasePart
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText = "Select vehicle", kind .. " · free starter"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 12, false
	prompt.Parent = marker
	prompt.Triggered:Connect(function(player: Player)
		local r = root(player)
		local callback = selection
		if r and callback and (r.Position - marker.Position).Magnitude <= 14 then
			callback(player, kind)
		end
	end)
end
Players.PlayerRemoving:Connect(function(player: Player)
	Garage.hideDisplay(player, false)
	local bay = bays[player]
	if bay then
		owners[bay] = nil
		bays[player] = nil
	end
end)
return Garage
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">TownTraffic</string>
          <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Vehicle = require(script.Parent.Vehicle)
local Players = game:GetService("Players")
local Graph = require(Shared.RoadGraph).Nodes
local Nav = require(Shared.RoadNavigation)
local Math = require(Shared.TownTrafficMath)
local Map = require(Shared.TownMap)
local Progression = require(Shared.Progression)
local TownTraffic = {}
local folder = Instance.new("Folder")
folder.Name = "TownTraffic"
folder.Parent = workspace
local routes: { Math.Route } = {}
for _, source in { Map.Course, Map.Route, Map.ServiceRoute } do
	local points: { Nav.Point } = {}
	for _, p in source do
		table.insert(points, { x = p.X, z = p.Z })
	end
	table.insert(routes, Math.route(points, false))
	table.insert(routes, Math.route(points, true))
end
-- Reserve conflict zones briefly, in arrival order, to prevent opposing queues
-- from both entering a junction and then waiting for one another forever.
local reservations: { [number]: { id: number, expires: number } } = {}
type Driver = {
	id: number,
	car: Vehicle.Car,
	route: number,
	progress: number,
	police: boolean,
	stalled: number,
	reverseUntil: number,
	rejoin: boolean,
	throttle: number,
	steer: number,
	immobile: number,
}
local drivers: { Driver } = {}
local demands: { [Player]: string? } = {}
local serial, spawnClock, thinkClock = 0, 0, 0
local function horizontal(a: Vector3, b: Vector3): number
	return ((a - b) * Vector3.new(1, 0, 1)).Magnitude
end
function TownTraffic.demand(player: Player, id: string?)
	demands[player] = id
end
function TownTraffic.population(): number
	local n = 0
	for _, d in drivers do
		if not d.police then
			n += 1
		end
	end
	return n
end
local function demandCount(): number
	local count = 6
	for _, id in demands do
		local d = Progression.difficulty(id)
		if d then
			count = math.max(count, d.Traffic)
		end
	end
	return count
end
local function policeStyle(car: Vehicle.Car)
	car.Model:SetAttribute("Police", true)
	car.Body.Color = Color3.fromRGB(24, 32, 43)
	if car.Model:GetAttribute("BundledVehicle") then
		return
	end
	for _, x in { -1.5, 1.5 } do
		local lamp = Instance.new("Part")
		lamp.Name = if x < 0 then "PoliceRed" else "PoliceBlue"
		lamp.Size = Vector3.new(2.6, 0.5, 1)
		lamp.CFrame = car.Body.CFrame * CFrame.new(x, 2.9, 0)
		lamp.Color = if x < 0 then Color3.fromRGB(255, 55, 65) else Color3.fromRGB(65, 140, 255)
		lamp.Material = Enum.Material.Neon
		lamp.Massless = true
		lamp.CanCollide = false
		lamp.CanQuery = false
		lamp.CanTouch = false
		lamp.Parent = car.Model
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = car.Body, lamp, lamp
	end
end
function TownTraffic.policeCount(): number
	local count = 0
	for _, d in drivers do
		if d.police then
			count += 1
		end
	end
	local active = workspace:FindFirstChild("PolicePatrols")
	return count + (if active then #active:GetChildren() else 0)
end
function TownTraffic.takePatrol(position: Vector3): Vehicle.Car?
	local best, dist = nil, if TownTraffic.policeCount() >= 8 then math.huge else 360
	for i, d in drivers do
		local gap = horizontal(d.car.Body.Position, position)
		if d.police and gap < dist then
			best, dist = i, gap
		end
	end
	if best then
		local driver = table.remove(drivers, best) :: Driver
		return driver.car
	end
	return nil
end
function TownTraffic.returnPatrol(car: Vehicle.Car)
	if not car.Model.Parent then
		return
	end
	serial += 1
	local p = { x = car.Body.Position.X, z = car.Body.Position.Z }
	local best, gap = 1, math.huge
	for i, route in routes do
		local distance = Nav.distance(p, Math.sample(route, Math.project(route, p)))
		if distance < gap then
			best, gap = i, distance
		end
	end
	car.Model.Parent = folder
	car.Model:SetAttribute("TargetUserId", nil)
	car.Model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	car.Tune.TopSpeed = 68
	car.Tune.Acceleration = 9
	car.Ray.FilterDescendantsInstances = { folder, workspace.Vehicles, workspace.PolicePatrols }
	table.insert(drivers, {
		id = serial,
		car = car,
		route = best,
		progress = Math.project(routes[best], p),
		police = true,
		stalled = 0,
		reverseUntil = 0,
		rejoin = gap > 14,
		throttle = 0,
		steer = 0,
		immobile = 0,
	})
end
local function spawn(police: boolean): boolean
	serial += 1
	local counts = { 0, 0, 0, 0, 0, 0 }
	for _, d in drivers do
		counts[d.route] += 1
	end
	local routeIndex = if police then 3 + serial % 2 else 1 + serial % #routes
	for i, count in counts do
		if not police and count < counts[routeIndex] then
			routeIndex = i
		end
	end
	local route = routes[routeIndex]
	for attempt = 1, 30 do
		local homeAlong = Math.project(route, { x = Map.Garage.X, z = Map.Garage.Z })
		local progress = (homeAlong + serial * 95 + attempt * 67) % route.length
		local p, q = Math.sample(route, progress), Math.sample(route, progress + 8)
		local v = Vector3.new(p.x, 34.25, p.z)
		local clear = horizontal(v, Map.Garage) > 120
		for _, model in workspace.Vehicles:GetChildren() do
			if
				model:IsA("Model")
				and model.PrimaryPart
				and horizontal(v, model.PrimaryPart.Position) < 100
			then
				clear = false
			end
		end
		for _, d in drivers do
			if horizontal(v, d.car.Body.Position) < 65 then
				clear = false
			end
		end
		local cf = CFrame.lookAt(v, Vector3.new(q.x, v.Y, q.z))
		local overlap = OverlapParams.new()
		overlap.RespectCanCollide = true
		if
			clear
			and #workspace:GetPartBoundsInBox(cf + Vector3.new(0, 1.5, 0), Vector3.new(8, 3, 21), overlap)
				== 0
		then
			local kind = if not police and serial % 4 == 0 then "Pickup" else "Electric"
			local car = Vehicle.create(folder, nil, kind, cf, if police then "Police" else kind)
			car.Model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
			car.Model:SetAttribute("Police", police)
			car.Model:SetAttribute("Civilian", not police)
			car.Model.Name = if police then "TownPatrol_" .. serial else "Civilian_" .. serial
			car.Tune = table.clone(car.Tune)
			car.Tune.TopSpeed = 68
			car.Tune.Acceleration = 9
			for _, part in car.Model:GetDescendants() do
				if part:IsA("BasePart") then
					part.CollisionGroup = if police then "Police" else "Civilian"
				end
			end
			car.Ray.FilterDescendantsInstances = { folder, workspace.Vehicles, workspace.PolicePatrols }
			if police then
				policeStyle(car)
			else
				local colors = {
					Color3.fromRGB(134, 155, 158),
					Color3.fromRGB(188, 179, 157),
					Color3.fromRGB(143, 64, 48),
					Color3.fromRGB(55, 63, 81),
				}
				car.Body.Color = colors[serial % 4 + 1]
			end
			table.insert(drivers, {
				id = serial,
				car = car,
				route = routeIndex,
				progress = progress,
				police = police,
				stalled = 0,
				reverseUntil = 0,
				rejoin = false,
				throttle = 0,
				steer = 0,
				immobile = 0,
			})
			return true
		end
	end
	return false
end
local function unseen(d: Driver): boolean
	for _, player in Players:GetPlayers() do
		local root = if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
		if root and root:IsA("BasePart") and horizontal(root.Position, d.car.Body.Position) < 800 then
			return false
		end
	end
	for _, model in workspace.Vehicles:GetChildren() do
		if
			model:IsA("Model")
			and model.PrimaryPart
			and horizontal(model.PrimaryPart.Position, d.car.Body.Position) < 220
		then
			return false
		end
	end
	return true
end
function TownTraffic.step(dt: number)
	local now = os.clock()
	spawnClock -= dt
	thinkClock -= dt
	local think = thinkClock <= 0
	if think then
		thinkClock = 0.1
	end
	local civilians, police = 0, 0
	for _, d in drivers do
		if d.police then
			police += 1
		else
			civilians += 1
		end
	end
	if spawnClock <= 0 then
		spawnClock = 0.35
		if police < 2 and TownTraffic.policeCount() < 8 then
			spawn(true)
		elseif civilians < demandCount() then
			spawn(false)
		end
	end
	for i = #drivers, 1, -1 do
		local d = drivers[i]
		local car = d.car
		local body = car.Body
		local route = routes[d.route]
		if
			(
				civilians > demandCount() and not d.police
				or d.police and police > 2
				or d.immobile > 60
				or body.Position.Y < 0
			) and unseen(d)
		then
			car.Model:Destroy()
			table.remove(drivers, i)
			if not d.police then
				civilians -= 1
			else
				police -= 1
			end
			continue
		end
		if think then
			d.progress = Math.project(route, { x = body.Position.X, z = body.Position.Z })
			local speed = body.AssemblyLinearVelocity:Dot(body.CFrame.LookVector)
			local path = Math.path(route, d.progress)
			local aim = Math.sample(route, d.progress + Math.lookahead(speed))
			local target = body.CFrame:PointToObjectSpace(Vector3.new(aim.x, body.Position.Y, aim.z))
			local cruise = if d.route <= 2 then 64 elseif d.route <= 4 then 42 else 32
			local limit = Math.cornerSpeed(path, cruise)
			for _, other in drivers do
				if other ~= d and other.route == d.route and not other.rejoin then
					limit = math.min(
						limit,
						Math.followSpeed((other.progress - d.progress) % route.length, cruise)
					)
				end
			end
			for junction, position in Map.Junctions do
				local delta = body.CFrame:PointToObjectSpace(position)
				if delta.Z < 8 and delta.Z > -75 and math.abs(delta.X) < 28 then
					local lock = reservations[junction]
					if lock and lock.expires > now and lock.id ~= d.id then
						limit = math.min(limit, Math.stopSpeed(-delta.Z))
					elseif delta.Z > -42 then
						reservations[junction] = { id = d.id, expires = now + 2.5 }
					end
				end
			end
			if d.rejoin then
				local here = { x = body.Position.X, z = body.Position.Z }
				local lane = Math.sample(route, d.progress)
				if Nav.distance(here, lane) < 14 then
					d.rejoin = false
				else
					local plan = Nav.route(Graph, here, lane)
					local join = Nav.ahead(plan, 18)
					if join then
						target = body.CFrame:PointToObjectSpace(Vector3.new(join.x, body.Position.Y, join.z))
						limit = math.min(limit, 20)
					else
						limit = 0
					end
				end
			end
			local throttle, steer = Nav.controls(target.X, -target.Z, speed, car.Wheelbase or 10.4, limit)
			local ray = RaycastParams.new()
			ray.FilterDescendantsInstances = { car.Model }
			ray.RespectCanCollide = true
			ray.CollisionGroup = if d.police then "Police" else "Civilian"
			local reach = math.clamp(math.abs(speed) * 1.2, 12, 55)
			local origin = body.Position
			local hit: RaycastResult? = nil
			for _, along in { 8, 18, reach } do
				if along > reach then
					continue
				end
				local p = Math.sample(route, d.progress + along)
				local destination = if d.rejoin
					then origin + body.CFrame.LookVector * along
					else Vector3.new(p.x, origin.Y, p.z)
				local delta = destination - origin
				if delta.Magnitude > 0.1 then
					hit = workspace:Blockcast(
						CFrame.lookAt(origin, destination),
						Vector3.new(body.Size.X * 0.85, 1, body.Size.Z * 0.65),
						delta,
						ray
					)
					if hit then
						break
					end
				end
				origin = destination
			end
			car.Model:SetAttribute("TrafficBlocked", hit ~= nil)
			if car.Model:GetAttribute("TrafficBlocked") or limit < 1 then
				throttle = if speed > 1 then -1 else 0
			end
			local staticBlock = hit ~= nil
				and not hit.Instance:IsDescendantOf(folder)
				and not hit.Instance:IsDescendantOf(workspace.Vehicles)
				and not hit.Instance:IsDescendantOf(workspace.PolicePatrols)
			-- A crossed or head-on stationary car is a blockage, not a normal queue.
			local crossedCar = hit ~= nil
				and hit.Instance.AssemblyLinearVelocity.Magnitude < 1
				and hit.Instance.CFrame.LookVector:Dot(body.CFrame.LookVector) < 0.65
			d.stalled = if math.abs(speed) < 1 and (throttle > 0 or staticBlock or crossedCar)
				then d.stalled + 0.1
				else 0
			d.immobile = if math.abs(speed) < 1 then d.immobile + 0.1 else 0
			if d.stalled > 4 then
				d.reverseUntil = now + 1.25
				d.stalled = 0
			end
			if now < d.reverseUntil then
				local rear = RaycastParams.new()
				rear.FilterDescendantsInstances = { car.Model }
				rear.RespectCanCollide = true
				local obstruction = workspace:Blockcast(
					body.CFrame,
					Vector3.new(body.Size.X, 1, body.Size.Z),
					-body.CFrame.LookVector * 14,
					rear
				)
				throttle = if obstruction then 0 else -0.4
				steer = -steer
			end
			d.throttle, d.steer = throttle, steer
		end
		Vehicle.step(car, math.min(dt, 0.05), d.throttle, d.steer, false, false)
	end
	if think then
		workspace:SetAttribute("TownTrafficCount", TownTraffic.population())
		workspace:SetAttribute("TownTrafficTarget", demandCount())
		workspace:SetAttribute("TownPatrolCount", police)
	end
end
return TownTraffic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Traffic</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local TrafficMath = require(ReplicatedStorage.Shared.TrafficMath)
local HighwayMath = require(ReplicatedStorage.Shared.HighwayMath)
local CrashMath = require(ReplicatedStorage.Shared.CrashMath)
local Traffic = {}
local folder = Instance.new("Folder")
folder.Name, folder.Parent = "HighwayTraffic", workspace
local epoch = workspace:GetServerTimeNow()
folder:SetAttribute("Epoch", epoch)
local models: { [number]: Model } = {}
local colors = {
	Color3.fromRGB(224, 170, 77),
	Color3.fromRGB(87, 150, 192),
	Color3.fromRGB(225, 229, 215),
	Color3.fromRGB(182, 72, 76),
}

local function build(id: number, lane: number, slot: number): Model
	local model = Instance.new("Model")
	model.Name = "Traffic_" .. id
	model:SetAttribute("Lane", lane)
	model:SetAttribute("Slot", slot)
	local function part(name: string, size: Vector3, cf: CFrame, color: Color3): Part
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local body = part("Body", Vector3.new(5.4, 1.4, 10), CFrame.new(), colors[id % #colors + 1])
	body.Size = Vector3.new(5.8, 3, 10)
	body.Transparency = 1
	body.CanCollide, body.CanQuery = true, true
	body.CollisionGroup = "Traffic"
	part("Paint", Vector3.new(5.4, 1.4, 10), CFrame.new(), colors[id % #colors + 1])
	model.PrimaryPart = body
	part("Cabin", Vector3.new(4.4, 1.6, 4.5), CFrame.new(0, 1.5, 0.5), Color3.fromRGB(42, 61, 77))
	for _, x in { -2.8, 2.8 } do
		for _, z in { -3.2, 3.2 } do
			part("Wheel", Vector3.new(0.7, 2, 2), CFrame.new(x, -0.7, z), Color3.fromRGB(21, 25, 31)).Shape =
				Enum.PartType.Cylinder
		end
	end
	for _, x in { -1.8, 1.8 } do
		local lens =
			part("Headlamp", Vector3.new(1, 0.4, 0.2), CFrame.new(x, 0, -5.1), Color3.fromRGB(255, 236, 189))
		lens.Material = Enum.Material.Neon
		if x < 0 then
			local beam = Instance.new("SpotLight")
			beam.Name, beam.Face = "TrafficHeadlight", Enum.NormalId.Front
			beam.Range, beam.Angle, beam.Brightness = 50, 65, 1.5
			beam.Color, beam.Shadows, beam.Enabled = lens.Color, false, false
			beam.Parent = lens
		end
		part("TailLamp", Vector3.new(1, 0.4, 0.2), CFrame.new(x, 0, 5.1), Color3.fromRGB(255, 73, 86)).Material =
			Enum.Material.Neon
	end
	return model
end

function Traffic.update(needed: { [number]: boolean })
	local H = Config.Highway
	local elapsed = workspace:GetServerTimeNow() - epoch
	for lane = 1, 6 do
		for slot = 0, Config.TrafficPerLane - 1 do
			local id = (lane - 1) * Config.TrafficPerLane + slot
			local x, z, direction =
				TrafficMath.position(lane, slot, elapsed, H.HalfLength, Config.TrafficPerLane)
			local model = models[id]
			if needed[math.floor(-z / H.ChunkLength)] then
				if not model then
					model = build(id, lane, slot)
					models[id] = model
				end
				model:PivotTo(
					CFrame.new(H.X + x, H.Y + 1.8, z)
						* CFrame.Angles(0, if direction > 0 then math.pi else 0, 0)
				)
				model.Parent = folder
			elseif model then
				model:Destroy()
				models[id] = nil
			end
		end
	end
	folder:SetAttribute("ActiveCars", #folder:GetChildren())
end

function Traffic.move()
	local H = Config.Highway
	local elapsed = workspace:GetServerTimeNow() - epoch
	for _, model in models do
		local lane, slot = model:GetAttribute("Lane") :: number, model:GetAttribute("Slot") :: number
		local x, z, direction = TrafficMath.position(lane, slot, elapsed, H.HalfLength, Config.TrafficPerLane)
		model:PivotTo(
			CFrame.new(H.X + x, H.Y + 1.8, z) * CFrame.Angles(0, if direction > 0 then math.pi else 0, 0)
		)
	end
end

function Traffic.contact(body: BasePart, previous: CFrame?, previousTime: number, now: number): number?
	local current = body.CFrame
	local before = previous or current
	if (current.Position - before.Position).Magnitude > 500 then
		return nil
	end
	local H = Config.Highway
	local axes = { Vector3.xAxis, Vector3.zAxis, current.RightVector, current.LookVector, Vector3.yAxis }
	local earliest: number? = nil
	for _, model in models do
		local lane, slot = model:GetAttribute("Lane") :: number, model:GetAttribute("Slot") :: number
		local x, z =
			TrafficMath.position(lane, slot, previousTime - epoch, H.HalfLength, Config.TrafficPerLane)
		local _, endZ = TrafficMath.position(lane, slot, now - epoch, H.HalfLength, Config.TrafficPerLane)
		-- Unwrap relative movement; the space-recycling teleport is not a collision sweep.
		local trafficStartZ = before.Position.Z + HighwayMath.wrap(z - before.Position.Z, H.HalfLength)
		local trafficEndZ = trafficStartZ + HighwayMath.wrap(endZ - z, H.HalfLength)
		local start = before.Position - Vector3.new(H.X + x, H.Y + 1.8, trafficStartZ)
		local finish = current.Position - Vector3.new(H.X + x, H.Y + 1.8, trafficEndZ)
		local a, b, extents = {}, {}, {}
		for _, axis in axes do
			table.insert(a, start:Dot(axis))
			table.insert(b, finish:Dot(axis))
			local carHalf = math.abs(axis:Dot(current.RightVector)) * body.Size.X / 2
				+ math.abs(axis:Dot(current.UpVector)) * body.Size.Y / 2
				+ math.abs(axis:Dot(current.LookVector)) * body.Size.Z / 2
			local trafficHalf = math.abs(axis.X) * 2.9 + math.abs(axis.Y) * 1.5 + math.abs(axis.Z) * 5
			table.insert(extents, carHalf + trafficHalf + Config.Crash.ContactMargin)
		end
		local hit = CrashMath.sweep(a, b, extents)
		if hit and (not earliest or hit < earliest) then
			earliest = hit
		end
	end
	return earliest
end

return Traffic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Vehicle</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Driving = require(ReplicatedStorage.Shared.Driving)
local Turbo = require(ReplicatedStorage.Shared.Turbo)
local Progression = require(ReplicatedStorage.Shared.Progression)
local HeadlightMath = require(ReplicatedStorage.Shared.HeadlightMath)

local Cockpit = require(script.Parent.Cockpit)
local TownDriving = require(ReplicatedStorage.Shared.TownDriving)
local Appearance = require(script.Parent.VehicleAppearance)

local Bundled = require(script.Parent.BundledVehicles)
local Style = require(script.Parent.VehicleStyle)
local Vehicle = {}
export type Car = {
	Model: Model,
	Body: Part,
	Seat: VehicleSeat,
	Springs: { VectorForce },
	Drive: VectorForce,
	Align: AlignOrientation,
	Ray: RaycastParams,
	Tune: Driving.Tuning,
	Steer: number,
	Turbo: Turbo.State,
	TelemetryClock: number,
	Wheels: { { motor: Motor6D, rest: CFrame, front: boolean } },
	WheelSpin: number,
	Wheelbase: number?,
	WheelRadius: number,
	Suspension: { Rest: number, Reach: number, Spring: number, Damping: number },
}

function Vehicle.create(
	parent: Instance,
	owner: Player?,
	kind: string,
	cf: CFrame,
	appearanceKind: string?
): Car
	local tune = (Config.Cars :: any)[kind]
	local town = kind == "Pickup" or kind == "Electric" or kind == "Sport"
	local dimensions = if town then tune.Dimensions else Vector3.new(5.4, 1.1, 9)
	local sx, sz = dimensions.X / 5.4, dimensions.Z / 9
	local wheels: { { motor: Motor6D, rest: CFrame, front: boolean } } = {}
	local model = Instance.new("Model")
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = if owner then "Car_" .. owner.UserId else "AI_Patrol"
	if owner then
		model:SetAttribute("OwnerId", owner.UserId)
	else
		model:SetAttribute("Police", true)
	end
	model:SetAttribute("Kind", kind)
	local body = Instance.new("Part")
	body.Name, body.Size, body.CFrame = "Chassis", dimensions, cf
	body.Color = tune.Color
	body.CustomPhysicalProperties =
		PhysicalProperties.new(if town then tune.Density else 1, 0.05, 0, 100, 100)
	body.RootPriority = 127
	body.CollisionGroup = "Cars"
	body.Parent = model
	model.PrimaryPart = body

	local function trim(
		name: string,
		size: Vector3,
		offset: CFrame,
		color: Color3,
		shape: Enum.PartType?
	): Part
		if town then
			offset = CFrame.new(offset.Position * Vector3.new(sx, 1, sz)) * offset.Rotation
			size = if shape then size * Vector3.new(1, 1.25, 1.25) else size * Vector3.new(sx, 1, sz)
		end
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color = name, size, cf * offset, color
		p.Shape = shape or Enum.PartType.Block
		p.CanCollide, p.Massless = false, true
		p.CollisionGroup = "Cars"
		p.Parent = model
		if name == "Wheel" or name == "Rim" then
			local motor = Instance.new("Motor6D")
			motor.Name = "RoadWheel"
			motor.Part0 = body
			motor.Part1 = p
			motor.C0 = offset
			motor.Parent = p
			table.insert(wheels, { motor = motor, rest = offset, front = offset.Position.Z < 0 })
		else
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = body, p, p
		end
		return p
	end
	if town then
		Style.build(model, body, dimensions, kind, owner ~= nil)
	else
		trim("Cabin", Vector3.new(4.4, 1.8, 3.6), CFrame.new(0, 1.3, 0.4), Color3.fromRGB(35, 53, 70))
		trim("Roof", Vector3.new(4.5, 0.3, 3.7), CFrame.new(0, 2.3, 0.4), tune.Color)
	end
	for _, x in { -1.8, 1.8 } do
		local lens = trim(
			"Headlamp",
			Vector3.new(1, 0.35, 0.2),
			CFrame.new(x, 0.2, -4.55),
			Color3.fromRGB(255, 243, 220)
		)
		lens.Material = Enum.Material.Neon
		local attachment = Instance.new("Attachment")
		attachment.Name = "HeadlightMount"
		-- Fixed directly to the chassis: no independently followed or smoothed light position.
		attachment.CFrame = CFrame.new(x * sx, 0.2, -dimensions.Z / 2 - 0.17)
			* CFrame.Angles(math.rad(-2), 0, 0)
		attachment.Parent = body
		local light = Instance.new("SpotLight")
		light.Enabled = false
		light.Name, light.Face = "AdaptiveHeadlight", Enum.NormalId.Front
		light.Color = lens.Color
		light.Range, light.Angle, light.Brightness = HeadlightMath.beam(0, Config.Headlights)
		light.Shadows = false
		light.Parent = attachment
		trim("TailLamp", Vector3.new(1, 0.35, 0.2), CFrame.new(x, 0.2, 4.55), Color3.fromRGB(255, 83, 102)).Material =
			Enum.Material.Neon
	end
	-- Original front-mounted intercooler geometry for the turbo-equipped prototype cars.
	trim(
		"Intercooler",
		Vector3.new(2.6, 0.65, 0.22),
		CFrame.new(0, -0.1, -4.65),
		Color3.fromRGB(130, 159, 171)
	)
	for y = -0.3, 0.15, 0.15 do
		trim("CoolingFin", Vector3.new(2.4, 0.04, 0.05), CFrame.new(0, y, -4.79), Color3.fromRGB(37, 50, 61))
	end
	if kind == "Interceptor" then
		for _, x in { -1, 1 } do
			trim(
				"Lightbar",
				Vector3.new(1.8, 0.35, 0.6),
				CFrame.new(x, 2.65, 0.4),
				if x < 0 then Color3.fromRGB(255, 90, 110) else Color3.fromRGB(83, 194, 255)
			).Material =
				Enum.Material.Neon
		end
	end
	local springs = {}
	for _, x in { -2.3, 2.3 } do
		for _, z in { -3.1, 3.1 } do
			trim(
				"Wheel",
				Vector3.new(0.8, 2, 2),
				CFrame.new(x * 1.22, -1, if town then math.sign(z) * tune.Wheelbase / 2 / sz else z),
				Color3.fromRGB(23, 27, 34),
				Enum.PartType.Cylinder
			)
			local rim = trim(
				"Rim",
				Vector3.new(0.85, 1.2, 1.2),
				CFrame.new(x * 1.22, -1, if town then math.sign(z) * tune.Wheelbase / 2 / sz else z),
				Color3.fromRGB(175, 193, 196),
				Enum.PartType.Cylinder
			)
			if town and owner then
				Style.rim(rim)
			end
			local attachment = Instance.new("Attachment")
			attachment.Position =
				Vector3.new(x * sx, 0, if town then math.sign(z) * tune.Wheelbase / 2 else z)
			attachment.Parent = body
			local spring = Instance.new("VectorForce")
			spring.Name = "Suspension"
			spring.Attachment0 = attachment
			spring.RelativeTo = Enum.ActuatorRelativeTo.World
			spring.ApplyAtCenterOfMass = true
			spring.Force = Vector3.zero
			spring.Parent = body
			table.insert(springs, spring)
		end
	end
	local center = Instance.new("Attachment")
	center.Parent = body
	local drive = Instance.new("VectorForce")
	drive.Name, drive.Attachment0 = "Drive", center
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.ApplyAtCenterOfMass = true
	drive.Force = Vector3.zero
	drive.Parent = body
	local align = Instance.new("AlignOrientation")
	align.Name = "Stability"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = center
	align.Responsiveness = 12
	align.MaxAngularVelocity = 4
	align.CFrame = cf.Rotation
	align.Parent = body
	local seat = Instance.new("VehicleSeat")
	seat.Name, seat.Size, seat.CFrame = "DriverSeat", Vector3.new(2, 0.5, 2), cf * CFrame.new(0, 1.5, 0.3)
	seat.Transparency, seat.CanCollide, seat.Massless = 1, false, true
	seat.Torque, seat.MaxSpeed, seat.TurnSpeed = 0, 0, 0
	seat.HeadsUpDisplay = false
	seat.Disabled = true -- Only the owner-authorized prompt can seat a driver.
	seat.CollisionGroup = "Cars"
	seat.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = body, seat, seat
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText =
		"Drive", kind .. " · " .. (if owner then owner.DisplayName else "Police")
	prompt.Enabled = owner ~= nil
	prompt.MaxActivationDistance = 12
	-- Validate character-to-seat clearance on the server; an indoor camera can be
	-- occluded even when the player is standing directly beside the driver's door.
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	-- Center the prompt on the car rather than a concealed interior seat.
	prompt.Parent = model
	model.Parent = parent
	Appearance.attach(model, body, kind)
	local imported = if town
		then Bundled.attach(
			model,
			body,
			appearanceKind or (if owner then kind else "Police"),
			wheels,
			owner ~= nil
		)
		else nil
	if town and owner and not imported then
		Cockpit.install(model, body, Vector3.new(-dimensions.X * 0.22, 0.2, 0.2))
		model:SetAttribute("ProvisionalAppearance", true)
	end
	body:SetNetworkOwner(nil)
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Exclude
	ray.FilterDescendantsInstances = { parent, workspace:WaitForChild("HighwayTraffic") }
	-- Use solid world geometry, including Terrain and parts outside the course.
	-- Cars/Characters do not collide with this query group.
	ray.CollisionGroup = "Suspension"
	ray.RespectCanCollide = true
	ray.IgnoreWater = true
	model:SetAttribute(
		"WheelRadius",
		if imported then imported:GetAttribute("WheelRadius") else (if town then 1.25 else 1)
	)
	for _, wheel in wheels do
		wheel.motor.Name = "RoadWheel"
		wheel.motor:SetAttribute("FrontWheel", wheel.front)
	end
	return {
		Model = model,
		Body = body,
		Seat = seat,
		Springs = springs,
		Drive = drive,
		Align = align,
		Ray = ray,
		Tune = tune,
		Steer = 0,
		Turbo = { boost = 0, heat = 0, overheated = false },
		TelemetryClock = 0,
		Wheels = wheels,
		WheelSpin = 0,
		Wheelbase = if imported
			then math.abs(
				(
					(imported:GetAttribute("Wheel_FL") :: Vector3)
					- imported:GetAttribute("Wheel_RL") :: Vector3
				).Z
			)
			elseif town then tune.Wheelbase
			else nil,
		WheelRadius = if imported
			then imported:GetAttribute("WheelRadius") :: number
			else (if town then 1.25 else 1),
		Suspension = table.clone(Config.Suspension),
	}
end

function Vehicle.step(
	car: Car,
	dt: number,
	throttle: number,
	steer: number,
	drift: boolean,
	turboEnabled: boolean
)
	local body = car.Body
	local mass = body.AssemblyMass
	local boost = Turbo.step(
		car.Turbo,
		dt,
		turboEnabled,
		throttle,
		body.AssemblyLinearVelocity:Dot(body.CFrame.LookVector),
		drift,
		Config.Turbo
	)
	car.TelemetryClock += dt
	if car.TelemetryClock >= 0.1 then
		car.TelemetryClock = 0
		car.Model:SetAttribute("Throttle", throttle)
		car.Model:SetAttribute("Boost", boost)
		car.Model:SetAttribute("TurboHeat", car.Turbo.heat)
		car.Model:SetAttribute("TurboOverheated", car.Turbo.overheated)
	end
	car.Steer = Driving.approach(car.Steer, steer, Config.SteeringResponse, dt)
	local speed = body.AssemblyLinearVelocity:Dot(body.CFrame.LookVector)
	-- Cosmetic motors animate locally. Never replicate every wheel transform every physics step.
	if car.TelemetryClock == 0 then
		car.Model:SetAttribute("VisualSteer", car.Steer)
	end
	local grounded, normal = 0, Vector3.zero
	-- Suspension applies through the assembly centre. AlignOrientation alone controls
	-- attitude: offset springs and the upright servo used to fight after a contact.
	for _, spring in car.Springs do
		local origin = (spring.Attachment0 :: Attachment).WorldPosition
		local hit = workspace:Raycast(origin, Vector3.new(0, -car.Suspension.Reach, 0), car.Ray)
		if hit and hit.Normal.Y > 0.45 then
			grounded += 1
			normal += hit.Normal
			local velocity = body:GetVelocityAtPosition(origin)
			local strength = Progression.spring(
				car.Suspension.Rest,
				hit.Distance,
				velocity.Y,
				workspace.Gravity,
				car.Suspension.Spring,
				car.Suspension.Damping,
				dt
			)
			spring.Force = Vector3.new(0, strength * mass, 0)
		else
			spring.Force = Vector3.zero
		end
	end
	if car.TelemetryClock == 0 then
		car.Model:SetAttribute("GroundedWheels", grounded)
		car.Model:SetAttribute("Drifting", drift and speed > car.Tune.DriftMinSpeed and grounded >= 2)
	end
	car.Align.Enabled = grounded >= 2
	if grounded < 2 then
		car.Drive.Force = Vector3.zero
		return
	end
	local up = normal.Unit
	local forward = body.CFrame.LookVector
	forward -= up * forward:Dot(up)
	if forward.Magnitude < 0.1 then
		car.Drive.Force = Vector3.zero
		return
	end
	forward = forward.Unit
	local right = forward:Cross(up).Unit
	local velocity = body.AssemblyLinearVelocity
	local acceleration, lateral, turn = Driving.forces(
		velocity:Dot(forward),
		velocity:Dot(right),
		throttle,
		car.Steer,
		drift,
		car.Tune,
		boost
	)
	if car.Wheelbase then
		turn = TownDriving.yaw(
			velocity:Dot(forward),
			car.Steer,
			car.Wheelbase,
			drift,
			car.Tune.DriftMinSpeed,
			car.Tune.DriftTurn
		)
	end
	if car.TelemetryClock == 0 then
		car.Model:SetAttribute("SteeringAngle", math.deg(TownDriving.steerAngle(speed, car.Steer)))
	end
	car.Drive.Force = (forward * acceleration + right * lateral) * mass
	local heading = CFrame.fromAxisAngle(up, turn * dt):VectorToWorldSpace(forward)
	-- Lead the orientation target slightly; otherwise responsiveness would attenuate yaw every frame.
	local target = CFrame.fromAxisAngle(up, turn * 0.16):VectorToWorldSpace(heading)
	car.Align.CFrame = CFrame.lookAt(Vector3.zero, target, up)
	car.Align.MaxTorque = mass * 6000
end

return Vehicle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">VehicleAppearance</string>
          <string name="Source"><![CDATA[--!strict
-- Import geometry only. Asset scripts, joints, seats and controllers never enter Workspace.
local AssetService = game:GetService("AssetService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local ModelFit = require(game:GetService("ReplicatedStorage").Shared.ModelFit)
local Cockpit = require(script.Parent.Cockpit)
local Appearance = {}
local template: Model? = nil
local pending: { [Model]: BasePart } = {}
local failure: string? = nil

local function prepare(source: Model): Model
	local visual = Instance.new("Model")
	visual.Name = "ImportedCarAppearance"
	local seat = source:FindFirstChildWhichIsA("VehicleSeat", true)
	-- Prefer the authored driver seat when a model contains multiple seats.
	for _, item in source:GetDescendants() do
		if item:IsA("VehicleSeat") and (item.Name == "DriveSeat" or item.Name == "DriverSeat") then
			seat = item
			break
		end
	end
	local bounds = source:GetBoundingBox()
	local orientation = if seat then seat.CFrame.Rotation else bounds.Rotation
	orientation *= CFrame.Angles(0, math.rad(Config.DefaultCarAppearance.YawDegrees), 0)
	for _, item in source:GetDescendants() do
		if
			item:IsA("BasePart")
			and not item:IsA("Seat")
			and not item:IsA("VehicleSeat")
			and item.Transparency < 1
		then
			local part = item:Clone() :: BasePart
			part:ClearAllChildren()
			for _, child in item:GetChildren() do
				if child:IsA("DataModelMesh") or child:IsA("Decal") or child:IsA("SurfaceAppearance") then
					local decoration: Instance = (child :: Instance):Clone()
					decoration:ClearAllChildren()
					decoration.Parent = part
				end
			end
			local partName = string.lower(item.Name)
			if
				item.Material == Enum.Material.Glass
				or string.find(partName, "windshield", 1, true)
				or string.find(partName, "windscreen", 1, true)
			then
				part.Transparency = math.max(part.Transparency, 0.65)
			end
			local ancestor: Instance? = item
			while ancestor and ancestor ~= source do
				local name = string.lower(ancestor.Name):gsub("[%s_]", "")
				if string.find(name, "steeringwheel", 1, true) or name == "steer" then
					part.Transparency = 1
				end
				ancestor = ancestor.Parent
			end
			part.CFrame = orientation:Inverse() * item.CFrame
			part.Anchored, part.Massless = true, true
			part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
			part.CollisionGroup = "Cars"
			part.Parent = visual
		end
	end
	assert(#visual:GetChildren() > 0, "Asset contains no visible car parts")
	local originalBox, size = visual:GetBoundingBox()
	-- Fix the pivot explicitly so the seat and all cloned geometry share one transform.
	local pivot = originalBox.Position
	visual.WorldPivot = CFrame.new(pivot)
	assert(size.X > 0 and size.Z > 0, "Asset has invalid bounds")
	local scale =
		math.min(Config.DefaultCarAppearance.Width / size.X, Config.DefaultCarAppearance.Length / size.Z)
	visual:ScaleTo(scale)
	local box, fitted = visual:GetBoundingBox()
	-- Centre on our chassis and align tyre bottoms to the existing suspension geometry.
	local offset = Vector3.new(box.Position.X, box.Position.Y - fitted.Y / 2 + 2, box.Position.Z)
	for _, item in visual:GetChildren() do
		local part = item :: BasePart
		part.CFrame = CFrame.new(-offset) * part.CFrame
	end
	local driver = Vector3.new(-fitted.X * 0.23, 0.4, 0.5)
	if seat then
		local authored = (orientation:Inverse() * seat.CFrame).Position
		driver = Vector3.new(
			ModelFit.coordinate(authored.X, pivot.X, scale, offset.X),
			ModelFit.coordinate(authored.Y, pivot.Y, scale, offset.Y),
			ModelFit.coordinate(authored.Z, pivot.Z, scale, offset.Z)
		)
	end
	visual:SetAttribute("DriverOffset", driver + Config.DefaultCarAppearance.SeatAdjustment)
	visual:SetAttribute("HullSize", Vector3.new(fitted.X * 0.92, 1.1, fitted.Z * 0.96))
	return visual
end

local function apply(model: Model, body: BasePart)
	local ready = template
	if not ready or not model.Parent or not body.Parent or model:GetAttribute("Crashed") then
		return
	end
	local visual = ready:Clone()
	for _, item in visual:GetChildren() do
		local part = item :: BasePart
		part.CFrame = body.CFrame * part.CFrame
		part.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = body, part
		weld.Parent = part
	end
	-- Preserve chassis, native headlight mounts and seat, but hide the placeholder shell.
	for _, item in model:GetChildren() do
		if item:IsA("BasePart") then
			item.Transparency = 1
		end
	end
	visual.Parent = model
	body.Size = visual:GetAttribute("HullSize") :: Vector3
	for _, item in body:GetChildren() do
		if item:IsA("VectorForce") and item.Name == "Suspension" and item.Attachment0 then
			local mount = item.Attachment0
			mount.Position = Vector3.new(
				math.sign(mount.Position.X) * body.Size.X * 0.42,
				0,
				math.sign(mount.Position.Z) * body.Size.Z * 0.34
			)
		end
		if item:IsA("Attachment") and item.Name == "HeadlightMount" then
			item.Position =
				Vector3.new(math.sign(item.Position.X) * body.Size.X * 0.33, 0.2, -body.Size.Z / 2 - 0.17)
		end
	end
	Cockpit.install(model, body, visual:GetAttribute("DriverOffset") :: Vector3)
	model:SetAttribute("AppearanceAssetId", Config.DefaultCarAppearance.AssetId)
	model:SetAttribute("AppearanceStatus", "Loaded")
end

function Appearance.attach(model: Model, body: BasePart, kind: string)
	if kind ~= "Compact" then
		return
	end
	model:SetAttribute("RequestedAppearanceAssetId", Config.DefaultCarAppearance.AssetId)
	if template then
		apply(model, body)
	elseif failure then
		model:SetAttribute("AppearanceStatus", "Failed: " .. failure)
	else
		model:SetAttribute("AppearanceStatus", "Loading")
		pending[model] = body
	end
end

-- One request per server, independent of spawning and driving. A failed load keeps the starter usable.
task.spawn(function()
	local loaded: Instance? = nil
	local ok, result = pcall(function()
		loaded = AssetService:LoadAssetAsync(Config.DefaultCarAppearance.AssetId)
		assert(loaded and loaded:IsA("Model"), "Asset is not a Model")
		return prepare(loaded :: Model)
	end)
	if loaded then
		loaded:Destroy()
	end
	if ok then
		template = result :: Model
	else
		failure = tostring(result)
		warn(
			"Default car asset "
				.. Config.DefaultCarAppearance.AssetId
				.. " could not load: "
				.. tostring(failure)
		)
	end
	for model, body in pending do
		if ok then
			apply(model, body)
		elseif model.Parent then
			model:SetAttribute("AppearanceStatus", "Failed: " .. tostring(failure))
		end
	end
	table.clear(pending)
end)

return Appearance
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">VehicleFinish</string>
          <string name="Source"><![CDATA[--!strict
local Materials = require(game:GetService("ReplicatedStorage").Shared.VehicleMaterials)
local Finish = {}
function Finish.prepare(visual: Model, police: boolean)
	for _, part in visual:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		local slot = Materials.slot(part.Name)
		if slot and not (police and slot == "Paint") then
			part:SetAttribute("FinishSlot", slot)
			if part:IsA("MeshPart") then
				part.TextureID = ""
			end
			for _, child in part:GetChildren() do
				if child:IsA("SurfaceAppearance") or child:IsA("Decal") then
					-- Imported livery must not mask the selected finish. Map setters are plugin-only.
					child:Destroy()
				end
			end
			part.Material = if slot == "Interior" then Enum.Material.Fabric else Enum.Material.SmoothPlastic
			part.Reflectance = if slot == "Paint" then 0.12 elseif slot == "Wheels" then 0.2 else 0
		end
	end
end
function Finish.apply(model: Model, slot: string, color: Color3)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("FinishSlot") == slot then
			part.Color = color
		end
	end
	model:SetAttribute("Finish_" .. slot, color)
end
return Finish
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">VehicleStyle</string>
          <string name="Source"><![CDATA[--!strict
-- Original procedural coachwork: believable proportions, no external mesh dependency.
local Style = {}
function Style.build(model: Model, body: Part, dimensions: Vector3, kind: string, detailed: boolean)
	local w, l = dimensions.X, dimensions.Z
	local pickup = kind == "Pickup"
	local roof = if pickup then 3.3 elseif kind == "Electric" then 2.75 else 2.35
	local rear = if pickup then l * 0.08 else l * 0.20
	local dark = Color3.fromRGB(26, 30, 34)
	local paint: { BasePart } = {}
	local function part(
		name: string,
		size: Vector3,
		offset: CFrame,
		color: Color3?,
		wedge: boolean?
	): BasePart
		local p: BasePart = if wedge then Instance.new("WedgePart") else Instance.new("Part")
		p.Name, p.Size, p.CFrame = name, size, body.CFrame * offset
		p.Color = color or body.Color
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, true
		p.Parent = model
		if not color then
			p.Reflectance = 0.08
			table.insert(paint, p)
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = body, p, p
		return p
	end
	local function glass(name: string, size: Vector3, cf: CFrame): BasePart
		local p = part(name, size, cf, Color3.fromRGB(91, 123, 132))
		p.Material = Enum.Material.Glass
		p.Transparency = if detailed then 0.68 else 0.28
		p.Reflectance = 0.12
		return p
	end
	body.Material = Enum.Material.SmoothPlastic
	body.Reflectance = 0.08
	part("SculptedHood", Vector3.new(w * 0.94, 1.1, l * 0.27), CFrame.new(0, 0.62, -l * 0.335), nil, true)
	part(
		"RearDeck",
		Vector3.new(w * 0.95, 0.9, l * 0.24),
		CFrame.new(0, 0.52, l * 0.35) * CFrame.Angles(0, math.pi, 0),
		nil,
		true
	)
	part(
		"CabinRoof",
		Vector3.new(w * 0.78, 0.18, if pickup then l * 0.31 else l * 0.37),
		CFrame.new(0, roof, -l * 0.005)
	)
	glass(
		"RakedWindshield",
		Vector3.new(w * 0.79, roof - 1, 0.1),
		CFrame.new(0, (roof + 1) / 2, -l * 0.19) * CFrame.Angles(math.rad(24), 0, 0)
	)
	glass(
		"RearGlass",
		Vector3.new(w * 0.77, roof - 1, 0.1),
		CFrame.new(0, (roof + 1) / 2, rear) * CFrame.Angles(math.rad(-22), 0, 0)
	)
	for _, side in { -1, 1 } do
		part("Sill", Vector3.new(0.2, 0.5, l * 0.88), CFrame.new(side * w * 0.48, -0.25, 0), dark)
		part("DoorSkin", Vector3.new(0.15, 0.85, l * 0.46), CFrame.new(side * w * 0.485, 0.75, -0.1))
		glass(
			"SideGlass",
			Vector3.new(0.09, roof - 1.3, l * 0.32),
			CFrame.new(side * w * 0.414, (roof + 1.1) / 2, 0)
		)
		part(
			"DoorPillar",
			Vector3.new(0.17, roof - 1, 0.17),
			CFrame.new(side * w * 0.42, (roof + 1) / 2, l * 0.01),
			dark
		)
		part(
			"FrontPillar",
			Vector3.new(0.16, roof - 1, 0.16),
			CFrame.new(side * w * 0.42, (roof + 1) / 2, -l * 0.19) * CFrame.Angles(math.rad(24), 0, 0)
		)
		part(
			"RearPillar",
			Vector3.new(0.18, roof - 1, 0.18),
			CFrame.new(side * w * 0.42, (roof + 1) / 2, rear) * CFrame.Angles(math.rad(-22), 0, 0)
		)
		part("Mirror", Vector3.new(0.65, 0.38, 0.9), CFrame.new(side * (w / 2 + 0.23), 1.55, -l * 0.16), dark)
		part(
			"Handle",
			Vector3.new(0.13, 0.12, 0.62),
			CFrame.new(side * (w / 2 + 0.04), 1.03, l * 0.04),
			Color3.fromRGB(185, 191, 194)
		)
		if pickup then
			part("BedRail", Vector3.new(0.26, 1.15, l * 0.35), CFrame.new(side * w * 0.46, 0.7, l * 0.30))
		end
	end
	if pickup then
		part("OpenBed", Vector3.new(w * 0.84, 0.12, l * 0.31), CFrame.new(0, 0.9, l * 0.31), dark)
		part("Tailgate", Vector3.new(w * 0.96, 1.15, 0.25), CFrame.new(0, 0.6, l * 0.48))
	end
	part("FrontBumper", Vector3.new(w * 0.97, 0.4, 0.5), CFrame.new(0, -0.05, -l * 0.5), dark)
	part("RearBumper", Vector3.new(w * 0.95, 0.35, 0.4), CFrame.new(0, -0.1, l * 0.5), dark)
	part("LowerGrille", Vector3.new(w * 0.55, 0.45, 0.12), CFrame.new(0, 0.35, -l * 0.5 - 0.27), dark)
	part(
		"FrontPlate",
		Vector3.new(1.4, 0.34, 0.06),
		CFrame.new(0, -0.08, -l * 0.5 - 0.29),
		Color3.fromRGB(221, 225, 212)
	)
	part(
		"RearPlate",
		Vector3.new(1.4, 0.34, 0.06),
		CFrame.new(0, 0.12, l * 0.5 + 0.24),
		Color3.fromRGB(221, 225, 212)
	)
	if detailed then
		part("Dashboard", Vector3.new(w * 0.78, 0.4, 1.4), CFrame.new(0, 0.95, -l * 0.12), dark)
		part("Console", Vector3.new(0.7, 0.6, 2.3), CFrame.new(0, 0.6, l * 0.04), dark)
		for _, x in { -w * 0.22, w * 0.22 } do
			part("SeatCushion", Vector3.new(w * 0.29, 0.25, 1.8), CFrame.new(x, 0.4, l * 0.055), dark)
			part(
				"SeatBack",
				Vector3.new(w * 0.29, 1.7, 0.3),
				CFrame.new(x, 1.25, l * 0.12) * CFrame.Angles(math.rad(-10), 0, 0),
				dark
			)
			part("Headrest", Vector3.new(w * 0.2, 0.55, 0.35), CFrame.new(x, 2.25, l * 0.14), dark)
		end
	end
	body:GetPropertyChangedSignal("Color"):Connect(function()
		for _, p in paint do
			if p.Parent then
				p.Color = body.Color
			end
		end
	end)
end
function Style.rim(rim: Part)
	for i = 0, 4 do
		local spoke = Instance.new("Part")
		spoke.Name = "AlloySpoke"
		spoke.Size = Vector3.new(0.035, 0.13, 1.05)
		spoke.CFrame = rim.CFrame * CFrame.Angles(i * math.pi * 2 / 5, 0, 0) * CFrame.new(0, 0.35, 0)
		spoke.Color = Color3.fromRGB(58, 63, 67)
		spoke.Material = Enum.Material.Metal
		spoke.CanCollide, spoke.CanQuery, spoke.CanTouch, spoke.Massless = false, false, false, true
		spoke.Parent = rim
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = rim, spoke, spoke
	end
end
return Style
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Workshop</string>
          <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Progression = require(Shared.Progression)
local Config = require(Shared.Config)
local Vehicle = require(script.Parent.Vehicle)
local Metrics = require(script.Parent.PlaytestMetrics)
local Workshop = {}
local Store = require(script.Parent.ProfileStore)
local Finish = require(script.Parent.VehicleFinish)
local Cosmetics = require(Shared.Cosmetics)
function Workshop.init(player: Player): boolean
	if not Store.load(player) then
		return false
	end
	local p = Store.get(player)
	if not p then
		return false
	end
	player:SetAttribute("GetawayCash", p.cash)
	Metrics.mark(player, "join", nil, true)
	if p.wins > 0 then
		Metrics.mark(player, "returning", nil, true)
	end
	player:SetAttribute("GetawayWins", p.wins)
	player:SetAttribute("SelectedCar", p.selected)
	player:SetAttribute("CircuitLaps", p.laps)
	if p.bestLap > 0 then
		player:SetAttribute("BestLapSeconds", p.bestLap)
	end
	for id, owned in p.cosmetics do
		player:SetAttribute("Owned_" .. id, owned)
	end
	return true
end
function Workshop.remove(_player: Player) end -- ProfileStore owns serialized leave/shutdown saves.
function Workshop.win(player: Player)
	local p = Store.get(player)
	if p then
		p.wins += 1
		player:SetAttribute("GetawayWins", p.wins)
		Store.changed(player)
	end
end
function Workshop.lap(player: Player, seconds: number)
	local p = Store.get(player)
	if p then
		p.laps += 1
		p.bestLap = if p.bestLap == 0 then seconds else math.min(p.bestLap, seconds)
		player:SetAttribute("CircuitLaps", p.laps)
		player:SetAttribute("BestLapSeconds", p.bestLap)
		Store.changed(player)
	end
end
function Workshop.credit(player: Player, amount: number)
	local p = Store.get(player)
	if p and amount > 0 and amount == amount and amount < 100000 then
		p.cash = math.min(100000000, p.cash + math.floor(amount))
		player:SetAttribute("GetawayCash", p.cash)
		Store.changed(player)
	end
end
function Workshop.discover(player: Player, id: string): boolean
	local p = Store.get(player)
	if not p or p.discoveries[id] then
		return false
	end
	p.discoveries[id] = true
	Workshop.credit(player, 150)
	return true
end
function Workshop.apply(player: Player, car: Vehicle.Car)
	local p = Store.get(player)
	if not p then
		return
	end
	local kind = car.Model:GetAttribute("Kind") :: string
	local levels = (p.upgrades[kind] or Progression.levels()) :: Progression.Levels
	local factors = Progression.factors(levels)
	local base = (Config.Cars :: any)[kind]
	car.Tune = table.clone(base)
	car.Tune.Acceleration = base.Acceleration * factors.Acceleration
	car.Tune.TopSpeed = base.TopSpeed * factors.TopSpeed
	car.Tune.Brake = base.Brake * factors.Brake
	car.Tune.Grip = base.Grip * factors.Grip
	car.Tune.DriftGrip = base.DriftGrip * factors.DriftGrip
	car.Suspension = table.clone(Config.Suspension)
	car.Suspension.Spring *= factors.Spring
	car.Suspension.Damping *= factors.Damping
	for _, u in Progression.Catalog do
		local level = (levels :: any)[u.Id]
		player:SetAttribute("Upgrade_" .. kind .. "_" .. u.Id, level)
		car.Model:SetAttribute("Upgrade_" .. u.Id, level)
	end
	if p.selected ~= kind then
		Store.changed(player)
	end
	p.selected = kind
	player:SetAttribute("SelectedCar", kind)
	for _, item in Cosmetics do
		if p.equipped[kind] and p.equipped[kind][item.Slot] == item.Id then
			Finish.apply(car.Model, item.Slot, Color3.fromRGB(item.RGB[1], item.RGB[2], item.RGB[3]))
		end
	end
	player:SetAttribute("WorkshopCar", kind)
	car.Model:SetAttribute("TunedTopSpeed", car.Tune.TopSpeed)
	car.Model:SetAttribute("TunedBrake", car.Tune.Brake)
	car.Model:SetAttribute("TunedGrip", car.Tune.Grip)
end
function Workshop.buy(player: Player, car: Vehicle.Car, id: string, atHome: boolean, onJob: boolean): string
	local p = Store.get(player)
	if not p then
		return "Profile unavailable."
	end
	local kind = car.Model:GetAttribute("Kind") :: string
	if car.Model:GetAttribute("OwnerId") ~= player.UserId then
		return "Choose your own car."
	end
	local levels = (p.upgrades[kind] or Progression.levels()) :: Progression.Levels
	local newCash, message = Progression.buy(p.cash, levels, id, atHome, onJob)
	if newCash < p.cash then
		Metrics.mark(player, "purchase", { id = id, kind = kind, amount = p.cash - newCash })
		p.cash = newCash
		p.upgrades[kind] = levels :: any
		player:SetAttribute("GetawayCash", p.cash)
		Workshop.apply(player, car)
		Store.changed(player)
	end
	return message
end
function Workshop.cosmetic(
	player: Player,
	car: Vehicle.Car,
	id: string,
	atHome: boolean,
	onJob: boolean
): string
	local p = Store.get(player)
	if not p or not atHome or onJob or car.Model:GetAttribute("OwnerId") ~= player.UserId then
		return "Park your car at home after the job."
	end
	for _, item in Cosmetics do
		if item.Id ~= id then
			continue
		end
		if not p.cosmetics[id] and p.cash < item.Price then
			return "Need $" .. (item.Price - p.cash) .. " more."
		end
		if not p.cosmetics[id] then
			Metrics.mark(player, "cosmetic", { id = id, amount = item.Price })
			p.cash -= item.Price
			p.cosmetics[id] = true
		end
		local kind = car.Model:GetAttribute("Kind") :: string
		p.equipped[kind] = p.equipped[kind] or {}
		p.equipped[kind][item.Slot] = id
		Finish.apply(car.Model, item.Slot, Color3.fromRGB(item.RGB[1], item.RGB[2], item.RGB[3]))
		player:SetAttribute("GetawayCash", p.cash)
		player:SetAttribute("Owned_" .. id, true)
		Store.changed(player)
		return "Fitted " .. item.Name .. "."
	end
	return "Unknown finish."
end
return Workshop
]]></string>
        </Properties>
      </Item>
    </Item>
