          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="267">
          <Properties>
            <string name="Name">DriftEffects</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local tracked: { [Model]: { Trail } } = {}
RunService.Heartbeat:Connect(function()
	local folder = workspace:FindFirstChild("Vehicles")
	if not folder then
		return
	end
	for _, model in folder:GetChildren() do
		if
			not model:IsA("Model")
			or model:GetAttribute("OwnerId") ~= player.UserId
			or not model.PrimaryPart
		then
			continue
		end
		local body = model.PrimaryPart
		if not tracked[model] then
			local trails: { Trail } = {}
			local visual = model:FindFirstChild("ImportedCarAppearance")
			for _, side in { "RL", "RR" } do
				local offset = if visual then visual:GetAttribute("Wheel_" .. side) else nil
				local point = if typeof(offset) == "Vector3"
					then Vector3.new(offset.X, -2.2, offset.Z)
					else Vector3.new(
						(if side == "RL" then -1 else 1) * body.Size.X * 0.42,
						-2.2,
						body.Size.Z * 0.34
					)
				local a = Instance.new("Attachment")
				a.Position = point + Vector3.new(-0.25, 0, 0)
				a.Parent = body
				local b = Instance.new("Attachment")
				b.Position = point + Vector3.new(0.25, 0, 0)
				b.Parent = body
				local trail = Instance.new("Trail")
				trail.Attachment0 = a
				trail.Attachment1 = b
				trail.Lifetime = 3
				trail.MinLength = 0.05
				trail.Color = ColorSequence.new(Color3.fromRGB(28, 29, 29))
				trail.Transparency = NumberSequence.new(0.25, 1)
				trail.FaceCamera = false
				trail.Enabled = false
				trail.Parent = body
				table.insert(trails, trail)
			end
			tracked[model] = trails
		end
		local slip = math.abs(body.AssemblyLinearVelocity:Dot(body.CFrame.RightVector)) > 6
		for _, trail in tracked[model] do
			trail.Enabled = model:GetAttribute("Drifting") == true and slip
		end
	end
	for model in tracked do
		if not model.Parent then
			tracked[model] = nil
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="268">
          <Properties>
            <string name="Name">Getaway</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local UI = require(script.Parent.Interface)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Nav = require(Shared.RoadNavigation)
local RoadGraph = require(Shared.RoadGraph)
local Graph = RoadGraph.Nodes
local Contracts = require(Shared.Contracts)
local Progression = require(Shared.Progression)
local player = Players.LocalPlayer
local request = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("VehicleRequest") :: RemoteEvent
local content = UI.modal("jobs", "GETAWAY JOBS")
local difficulty = "light"
local difficultyRow = UI.row(content, 46)
local difficultyButtons: { TextButton } = {}
for i, option in Progression.Difficulties do
	local b = UI.button(
		difficultyRow,
		option.Name .. " " .. option.Multiplier .. "×",
		UDim2.new(1 / 3, -6, 1, 0),
		UDim2.fromScale((i - 1) / 3, 0),
		function()
			difficulty = option.Id
		end
	)
	table.insert(difficultyButtons, b)
end
UI.label(
	UI.row(content, 48),
	"Denser traffic earns more. Bank the haul, then improve your car.",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	14
)
for _, contract in Contracts do
	local row = UI.row(content, 108)
	UI.label(
		row,
		contract.Name .. " · $" .. contract.Reward .. "+",
		UDim2.new(1, -100, 0, 32),
		UDim2.new(),
		17
	).TextColor3 =
		UI.Gold
	UI.label(row, contract.Brief, UDim2.new(1, -100, 0, 68), UDim2.fromOffset(0, 34), 13)
	UI.button(row, "START", UDim2.fromOffset(90, 48), UDim2.new(1, -90, 0, 28), function()
		request:FireServer("Mission", contract.Id, difficulty)
	end)
end
local welcome = UI.modal("welcome", "WELCOME TO REDLINE COUNTY")
UI.label(
	UI.row(welcome, 120),
	"Your car. Your route. Your getaway.\n\nCollect a package, lose the police, and bring the money home.",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	20
)
UI.button(UI.row(welcome, 56), "START FIRST GETAWAY", UDim2.fromScale(1, 1), UDim2.new(), function()
	request:FireServer("Mission", "first", "light")
end)
UI.button(UI.row(welcome, 48), "Explore my garage", UDim2.fromScale(1, 1), UDim2.new(), function()
	UI.open("cars")
end)
UI.label(
	UI.row(welcome, 70),
	"Your bay opens and you are seated automatically. Follow the gold pickup and cyan road guidance.",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	14
)
local results = UI.modal("results", "RUN RESULTS")
local resultTitle = UI.label(UI.row(results, 60), "", UDim2.fromScale(1, 1), UDim2.new(), 26)
local resultDetail = UI.label(UI.row(results, 140), "", UDim2.fromScale(1, 1), UDim2.new(), 17)
UI.button(UI.row(results, 54), "RETRY THIS JOB", UDim2.fromScale(1, 1), UDim2.new(), function()
	request:FireServer("RetryMission")
end)
UI.button(UI.row(results, 50), "FIT YOUR NEXT UPGRADE", UDim2.fromScale(1, 1), UDim2.new(), function()
	request:FireServer("ReturnHome", "workshop")
end)
UI.button(UI.row(results, 50), "CHOOSE ANOTHER JOB", UDim2.fromScale(1, 1), UDim2.new(), function()
	request:FireServer("ReturnHome", "jobs")
end)
UI.button(UI.row(results, 46), "Return to driving", UDim2.fromScale(1, 1), UDim2.new(), function()
	UI.open("")
end)
local decisions = UI.frame(UI.Gui, UDim2.fromOffset(290, 60), UDim2.new(0.5, -145, 0, 98))
decisions.Visible = false
UI.button(decisions, "BANK [B]", UDim2.new(0.5, -8, 1, -12), UDim2.fromOffset(6, 6), function()
	request:FireServer("HeatChoice", "bank")
end)
UI.button(decisions, "CONTINUE [C]", UDim2.new(0.5, -8, 1, -12), UDim2.new(0.5, 2, 0, 6), function()
	request:FireServer("HeatChoice", "continue")
end)
Input.InputBegan:Connect(function(input, processed)
	if processed or UI.Name ~= "" or not player:GetAttribute("MissionChoice") then
		return
	end
	if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.ButtonB then
		request:FireServer("HeatChoice", "bank")
	end
	if input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.ButtonA then
		request:FireServer("HeatChoice", "continue")
	end
end)
game:GetService("ContextActionService")
	:BindActionAtPriority(
		"RedlineHeatChoice",
		function(_: string, state: Enum.UserInputState, input: InputObject)
			if UI.Name ~= "" then
				return Enum.ContextActionResult.Pass
			end
			local humanoid = if player.Character
				then player.Character:FindFirstChildOfClass("Humanoid")
				else nil
			if not humanoid or not humanoid.SeatPart then
				return Enum.ContextActionResult.Pass
			end
			if state == Enum.UserInputState.Begin and player:GetAttribute("MissionChoice") then
				request:FireServer(
					"HeatChoice",
					if input.KeyCode == Enum.KeyCode.ButtonA then "continue" else "bank"
				)
			end
			return Enum.ContextActionResult.Sink -- A must not also jump out of the driver's seat.
		end,
		false,
		4000,
		Enum.KeyCode.ButtonA,
		Enum.KeyCode.ButtonB
	)
local overviewContent = UI.modal("map", "HOPEDALE · DISTRICT MAP")
local overview = UI.frame(UI.row(overviewContent, 390), UDim2.fromScale(1, 1), UDim2.new())
overview.ClipsDescendants = true
UI.label(
	UI.row(overviewContent, 60),
	"Green: route · Gold: pickup · Red: police\nTown blocks · Parkway · Mill roads\nMap © OpenStreetMap contributors · ODbL 1.0",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	14
)
local small = UI.frame(UI.Map, UDim2.new(1, 0, 1, -32), UDim2.new())
small.ClipsDescendants = true
small.BackgroundTransparency = 1
local minX, minZ, maxX, maxZ = math.huge, math.huge, -math.huge, -math.huge
local edges: { { Nav.Point } } = {}
for i, node in Graph do
	minX = math.min(minX, node.x)
	minZ = math.min(minZ, node.z)
	maxX = math.max(maxX, node.x)
	maxZ = math.max(maxZ, node.z)
	for _, j in node.links do
		if i < j or not table.find(Graph[j].links, i) then
			table.insert(edges, { { x = node.x, z = node.z }, { x = Graph[j].x, z = Graph[j].z } })
		end
	end
end
type View = { frame: Frame, lines: { Frame }, dots: { TextLabel } }
local views: { View } =
	{ { frame = small, lines = {}, dots = {} }, { frame = overview, lines = {}, dots = {} } }
local path: { Nav.Point } = {}
local function line(view: View, index: number, a: Vector2, b: Vector2, color: Color3, width: number)
	if not view.lines[index] then
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0, 0.5)
		f.BorderSizePixel = 0
		f.Parent = view.frame
		view.lines[index] = f
	end
	local f = view.lines[index]
	f.Position = UDim2.fromOffset(a.X, a.Y)
	f.Size = UDim2.fromOffset((b - a).Magnitude, width)
	f.Rotation = math.deg(math.atan2(b.Y - a.Y, b.X - a.X))
	f.BackgroundColor3 = color
	f.Visible = true
end
local function dot(view: View, index: number, p: Vector2, text: string, color: Color3)
	if not view.dots[index] then
		local label = UI.label(view.frame, text, UDim2.fromOffset(18, 18), UDim2.new(), 17)
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.ZIndex = 3
		view.dots[index] = label
	end
	local label = view.dots[index]
	label.Position = UDim2.fromOffset(p.X, p.Y)
	label.Text = text
	label.TextColor3 = color
	label.Visible = true
end
local function draw(view: View, root: BasePart, full: boolean)
	local w, h = view.frame.AbsoluteSize.X, view.frame.AbsoluteSize.Y
	if w < 10 or h < 10 then
		return
	end
	local scale = if full then math.min((w - 24) / (maxX - minX), (h - 24) / (maxZ - minZ)) else 0.2
	local function project(p: Nav.Point): Vector2
		if full then
			return Vector2.new(12 + (p.x - minX) * scale, 12 + (p.z - minZ) * scale)
		end
		local localPoint = root.CFrame:PointToObjectSpace(Vector3.new(p.x, root.Position.Y, p.z))
		return Vector2.new(w / 2 + localPoint.X * scale, h * 0.62 + localPoint.Z * scale)
	end
	local count = 0
	local function segment(a: Nav.Point, b: Nav.Point, color: Color3, width: number)
		local aa, bb = project(a), project(b)
		if
			not full
			and (
				math.max(aa.X, bb.X) < 0
				or math.min(aa.X, bb.X) > w
				or math.max(aa.Y, bb.Y) < 0
				or math.min(aa.Y, bb.Y) > h
			)
		then
			return
		end
		count += 1
		line(view, count, aa, bb, color, width)
	end
	for _, edge in edges do
		segment(edge[1], edge[2], Color3.fromRGB(74, 95, 105), 3)
	end
	for i = 1, #path - 1 do
		segment(path[i], path[i + 1], UI.Accent, 4)
	end
	for i = count + 1, #view.lines do
		view.lines[i].Visible = false
	end
	local dots = 1
	dot(view, dots, project({ x = root.Position.X, z = root.Position.Z }), "▲", UI.Text)
	dots += 1
	dot(view, dots, project(Graph[RoadGraph.Home]), "H", UI.Accent)
	local block = player:GetAttribute("RoadblockPosition")
	if typeof(block) == "Vector3" then
		dots += 1
		dot(view, dots, project({ x = block.X, z = block.Z }), "×", Color3.fromRGB(245, 104, 88))
	end
	local target = player:GetAttribute("MissionTarget")
	if typeof(target) == "Vector3" then
		dots += 1
		dot(view, dots, project({ x = target.X, z = target.Z }), "●", UI.Gold)
	end
	for _, name in { "PolicePatrols", "TownTraffic" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			for _, car in folder:GetChildren() do
				if
					car:IsA("Model")
					and car.PrimaryPart
					and car:GetAttribute("Police")
					and (car.PrimaryPart.Position - root.Position).Magnitude < 500
				then
					dots += 1
					dot(
						view,
						dots,
						project({ x = car.PrimaryPart.Position.X, z = car.PrimaryPart.Position.Z }),
						"●",
						Color3.fromRGB(245, 104, 88)
					)
				end
			end
		end
	end
	for i = dots + 1, #view.dots do
		view.dots[i].Visible = false
	end
end
local visuals = Instance.new("Folder")
visuals.Name = "LocalMissionGuidance"
visuals.Parent = workspace
local function visual(name: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Material = Enum.Material.Neon
	p.Color = UI.Accent
	p.Parent = visuals
	return p
end
local marker = visual("Pickup")
marker.Shape = Enum.PartType.Cylinder
marker.Size = Vector3.new(0.16, 32, 32)
local markerLabel = Instance.new("BillboardGui")
markerLabel.Size = UDim2.fromOffset(200, 45)
markerLabel.StudsOffset = Vector3.new(0, 10, 0)
markerLabel.MaxDistance = 350
markerLabel.AlwaysOnTop = true
markerLabel.Parent = marker
local markerText = UI.label(markerLabel, "PICKUP", UDim2.fromScale(1, 1), UDim2.new(), 16)
markerText.TextXAlignment = Enum.TextXAlignment.Center
markerText.TextColor3 = UI.Gold
local crumbs: { Part } = {}
for i = 1, 18 do
	local part = visual("Route" .. i)
	part.Size = Vector3.new(0.45, 0.08, 4)
	table.insert(crumbs, part)
end
local clock, routeClock = 0, 0
local priorPhase = ""
local initialized = false
local resultSequence = 0
RunService.Heartbeat:Connect(function(dt)
	clock += dt
	routeClock += dt
	if clock < 0.15 then
		return
	end
	clock = 0
	if not initialized and player:GetAttribute("ProfileReady") then
		initialized = true
		UI.open(if (player:GetAttribute("GetawayWins") :: number? or 0) == 0 then "welcome" else "jobs")
	end
	local phase = (player:GetAttribute("MissionPhase") :: string?) or "idle"
	local active = phase == "pickup" or phase == "run" or phase == "escape" or phase == "deliver"
	if
		active
		and priorPhase ~= phase
		and (UI.Name == "jobs" or UI.Name == "welcome" or UI.Name == "results")
	then
		UI.open("")
	end
	priorPhase = phase
	local sequence = (player:GetAttribute("ResultSequence") :: number?) or 0
	if sequence ~= resultSequence then
		resultSequence = sequence
		resultTitle.Text = if phase == "complete"
			then (if (player:GetAttribute("LastReward") :: number? or 0) > 0
				then "ESCAPED & BANKED"
				else "ESCAPED")
			else "NEXT TIME, A DIFFERENT ROUTE"
		local kind = tostring(player:GetAttribute("SelectedCar") or "Electric")
		local level = (player:GetAttribute("Upgrade_" .. kind .. "_Brakes") :: number?) or 0
		local nextPrice = Progression.Catalog[2].Prices[level + 1]
		local goal = if nextPrice
			then "Next brakes: $" .. nextPrice .. " · need $" .. math.max(
				0,
				nextPrice - ((player:GetAttribute("GetawayCash") :: number?) or 0)
			)
			else "Brakes complete · try another workshop part."
		resultDetail.Text = tostring(player:GetAttribute("MissionMessage") or "")
			.. "\nHaul: $"
			.. tostring(player:GetAttribute("LastReward") or 0)
			.. " (clean bonus $"
			.. tostring(player:GetAttribute("LastCleanBonus") or 0)
			.. ")"
			.. " · "
			.. tostring(player:GetAttribute("LastRunSeconds") or 0)
			.. " s\nBank: $"
			.. tostring(player:GetAttribute("GetawayCash") or 0)
			.. "\n"
			.. goal
		UI.open("results")
	end
	for i, b in difficultyButtons do
		b.BackgroundColor3 = if Progression.Difficulties[i].Id == difficulty then UI.Gold else UI.Accent
	end
	decisions.Visible = player:GetAttribute("MissionChoice") == true and UI.Name == ""
	local remaining = (player:GetAttribute("MissionRemaining") :: number?) or 0
	UI.Title.Text = if active
		then tostring(player:GetAttribute("MissionName")) .. string.format(
			" · %d:%02d",
			remaining // 60,
			remaining % 60
		)
		else "REDLINE COUNTY"
	local cargo = player:GetAttribute("CargoQuality")
	UI.Objective.Text = if decisions.Visible
		then "Haul $" .. tostring(player:GetAttribute("UnbankedHaul") or 0) .. " · Bank or continue? [B / C]"
		elseif phase == "pickup" and not player:GetAttribute("HasDriven") then (if Input.TouchEnabled
			then "GAS: accelerate · arrows: steer · BRAKE: slow"
			elseif Input.GamepadEnabled then "RT: gas · LT: brake · left stick: steer"
			else "W / S: gas / brake · A / D: steer")
		elseif phase == "escape" then (if player:GetAttribute("PoliceSeeing")
			then "Break police sight: use corners and cover."
			else "SEARCHING · Escape " .. tostring(player:GetAttribute("MissionEscape") or 0) .. " / 10 s")
		elseif phase == "deliver" then "Return home and stop to bank your haul."
		elseif active and typeof(cargo) == "number" then "FRAGILE · Cargo " .. cargo .. "% · Avoid impacts."
		elseif active then "Follow the cyan route to the gold package."
		else "J: jobs · U: upgrades · E: enter car"
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if
		humanoid
		and humanoid.SeatPart
		and humanoid.SeatPart.Parent
		and humanoid.SeatPart.Parent:IsA("Model")
	then
		root = humanoid.SeatPart.Parent.PrimaryPart or root
	end
	local target = player:GetAttribute("MissionTarget")
	local hasTarget = active and typeof(target) == "Vector3"
	marker.Transparency = if hasTarget then 0.45 else 1
	markerLabel.Enabled = hasTarget
	if hasTarget and typeof(target) == "Vector3" then
		marker.CFrame = CFrame.new(target + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		markerText.Text = if phase == "deliver" then "SAFEHOUSE · STOP" else "PICKUP"
	end
	if routeClock >= 0.5 then
		routeClock = 0
		path = if root
				and hasTarget
				and typeof(target) == "Vector3"
			then Nav.route(
				Graph,
				{ x = root.Position.X, z = root.Position.Z },
				{ x = target.X, z = target.Z }
			)
			else {}
		for i, crumb in crumbs do
			local a, b = Nav.ahead(path, i * 14), Nav.ahead(path, i * 14 + 4)
			local usable = a ~= nil and b ~= nil and Nav.distance(a, b) > 0.1
			crumb.Transparency = if usable then 0.25 else 1
			if usable and a and b then
				crumb.CFrame = CFrame.lookAt(Vector3.new(a.x, 32.35, a.z), Vector3.new(b.x, 32.35, b.z))
			end
		end
	end
	if root then
		if UI.Name == "" then
			draw(views[1], root, false)
		elseif UI.Name == "map" then
			draw(views[2], root, true)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="269">
          <Properties>
            <string name="Name">Interface</string>
            <string name="Source"><![CDATA[--!strict
-- One owner for HUD layout, modals and local accessibility settings.
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local player = Players.LocalPlayer
local UI = {
	Name = "",
	Ink = Color3.fromRGB(17, 27, 35),
	Text = Color3.fromRGB(235, 237, 228),
	Accent = Color3.fromRGB(118, 215, 182),
	Gold = Color3.fromRGB(235, 189, 112),
}
local gui = Instance.new("ScreenGui")
gui.Name = "RedlineInterface"
gui.ResetOnSpawn = false
gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
gui.DisplayOrder = 5
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
UI.Gui = gui
function UI.frame(parent: Instance, size: UDim2, pos: UDim2): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = UI.Ink
	f.BackgroundTransparency = 0.06
	f.BorderSizePixel = 0
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 9)
	c.Parent = f
	return f
end
function UI.label(parent: Instance, text: string, size: UDim2, pos: UDim2, fontSize: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = fontSize
	l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Font = Enum.Font.GothamMedium
	l.TextColor3 = UI.Text
	l.Parent = parent
	return l
end
function UI.button(parent: Instance, text: string, size: UDim2, pos: UDim2, callback: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.Text = text
	b.TextSize = 15
	b.TextWrapped = true
	b.Font = Enum.Font.GothamBold
	b.TextColor3 = UI.Ink
	b.BackgroundColor3 = UI.Accent
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Parent = parent
	b.Activated:Connect(callback)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 7)
	c.Parent = b
	return b
end
local modals: { [string]: Frame } = {}
local shade = UI.frame(gui, UDim2.fromScale(1, 1), UDim2.new())
shade.BackgroundTransparency = 0.2
shade.Visible = false
shade.ZIndex = 10
UI.Changed = Instance.new("BindableEvent")
function UI.open(name: string)
	UI.Name = name
	player:SetAttribute("UIOpen", name ~= "")
	shade.Visible = name ~= ""
	for key, panel in modals do
		panel.Visible = key == name
	end
	GuiService.SelectedObject = nil
	if Input.GamepadEnabled and modals[name] then
		local content = modals[name]:FindFirstChild("Content")
		if content then
			for _, item in content:GetDescendants() do
				if item:IsA("TextButton") then
					GuiService.SelectedObject = item
					break
				end
			end
		end
	end
	UI.Changed:Fire(name)
end
function UI.toggle(name: string)
	UI.open(if UI.Name == name then "" else name)
end
function UI.modal(name: string, title: string): ScrollingFrame
	local panel = UI.frame(shade, UDim2.new(0, 590, 1, -32), UDim2.fromScale(0.5, 0.5))
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Visible = false
	panel.ZIndex = 11
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(620, 660)
	constraint.Parent = panel
	UI.label(panel, title, UDim2.new(1, -76, 0, 48), UDim2.fromOffset(18, 8), 22).ZIndex = 12
	UI.button(panel, "×", UDim2.fromOffset(44, 44), UDim2.new(1, -54, 0, 10), function()
		UI.open("")
	end).ZIndex =
		12
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Content"
	scroll.Size = UDim2.new(1, -32, 1, -78)
	scroll.Position = UDim2.fromOffset(16, 65)
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollBarThickness = 4
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ZIndex = 12
	scroll.Parent = panel
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 12)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = scroll
	modals[name] = panel
	return scroll
end
function UI.row(parent: Instance, height: number): Frame
	local row = UI.frame(parent, UDim2.new(1, -6, 0, height), UDim2.new())
	row.BackgroundTransparency = 1
	row.ZIndex = 12
	return row
end
local objective = UI.frame(gui, UDim2.fromOffset(340, 80), UDim2.fromOffset(12, 12))
UI.Title = UI.label(objective, "REDLINE COUNTY", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 5), 16)
UI.Title.TextColor3 = UI.Accent
UI.Objective = UI.label(objective, "Start a getaway", UDim2.new(1, -24, 0, 42), UDim2.fromOffset(12, 30), 14)
UI.Alert = UI.label(gui, "", UDim2.new(0.7, 0, 0, 44), UDim2.new(0.15, 0, 0, 98), 14)
UI.Alert.TextXAlignment = Enum.TextXAlignment.Center
UI.Alert.BackgroundColor3 = UI.Ink
UI.Alert.BackgroundTransparency = 0.05
UI.Alert.Visible = false
UI.Wallet = UI.label(gui, "$0", UDim2.fromOffset(138, 28), UDim2.new(1, -150, 0, 12), 18)
UI.Wallet.TextXAlignment = Enum.TextXAlignment.Right
local menu = UI.button(gui, "MENU [M]", UDim2.fromOffset(118, 40), UDim2.new(1, -130, 0, 48), function()
	UI.toggle("menu")
end)
UI.Speed = UI.label(gui, "", UDim2.fromOffset(205, 80), UDim2.new(1, -220, 1, -106), 17)
UI.Speed.TextXAlignment = Enum.TextXAlignment.Right
UI.Diagnostic = UI.label(gui, "", UDim2.new(0.7, 0, 0, 80), UDim2.new(0.15, 0, 0, 145), 13)
UI.Diagnostic.BackgroundColor3 = UI.Ink
UI.Diagnostic.BackgroundTransparency = 0.05
UI.Diagnostic.Visible = false
UI.Toast = UI.label(gui, "", UDim2.new(0.7, 0, 0, 42), UDim2.new(0.15, 0, 1, -58), 14)
UI.Toast.TextXAlignment = Enum.TextXAlignment.Center
UI.Toast.ZIndex = 30
UI.Toast.BackgroundColor3 = UI.Ink
UI.Toast.BackgroundTransparency = 0.05
local toastUntil = 0
function UI.notify(text: string)
	UI.Toast.Text = text
	toastUntil = os.clock() + 5
end
UI.Map = UI.frame(gui, UDim2.fromOffset(192, 192), UDim2.new(0, 12, 1, -216))
UI.Map.ClipsDescendants = true
local mapButton = UI.button(UI.Map, "MAP [P]", UDim2.new(1, 0, 0, 32), UDim2.new(0, 0, 1, -32), function()
	UI.toggle("map")
end)
mapButton.ZIndex = 4
local menuContent = UI.modal("menu", "REDLINE COUNTY")
for _, entry in
	{
		{ "jobs", "Getaway jobs [J]" },
		{ "cars", "Your garage" },
		{ "workshop", "Workshop [U]" },
		{ "settings", "Driving & accessibility" },
		{ "map", "District map [P]" },
	}
do
	local name = entry[1]
	UI.button(UI.row(menuContent, 48), entry[2], UDim2.fromScale(1, 1), UDim2.new(), function()
		UI.open(name)
	end).ZIndex =
		13
end
local request =
	game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("VehicleRequest") :: RemoteEvent
UI.button(UI.row(menuContent, 48), "Recover / repair at home", UDim2.fromScale(1, 1), UDim2.new(), function()
	request:FireServer("Reset")
	UI.open("")
end)
UI.button(UI.row(menuContent, 48), "Abandon current job", UDim2.fromScale(1, 1), UDim2.new(), function()
	request:FireServer("CancelMission")
	UI.open("")
end)
UI.button(UI.row(menuContent, 48), "Toggle turbo [T]", UDim2.fromScale(1, 1), UDim2.new(), function()
	request:FireServer("Turbo")
	UI.open("")
end)
local settings = UI.modal("settings", "DRIVING SETTINGS")
local function toggleSetting(attribute: string, title: string, default: boolean)
	if player:GetAttribute(attribute) == nil then
		player:SetAttribute(attribute, default)
	end
	local button: TextButton
	local function refresh()
		button.Text = title .. ": " .. (if player:GetAttribute(attribute) then "ON" else "OFF")
	end
	button = UI.button(UI.row(settings, 46), title, UDim2.fromScale(1, 1), UDim2.new(), function()
		player:SetAttribute(attribute, not player:GetAttribute(attribute))
		refresh()
	end)
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
	refresh()
end
toggleSetting("NightPreference", "Night driving [N]", true)
toggleSetting("CockpitView", "Interior camera [V]", false)
player:SetAttribute("CockpitHeight", 0)
local heightButton: TextButton
heightButton = UI.button(
	UI.row(settings, 46),
	"Interior eye height: NORMAL",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	function()
		local current = (player:GetAttribute("CockpitHeight") :: number?) or 0
		local nextHeight = if current == 0 then 0.2 elseif current > 0 then -0.2 else 0
		player:SetAttribute("CockpitHeight", nextHeight)
		heightButton.Text = "Interior eye height: "
			.. (if nextHeight == 0 then "NORMAL" elseif nextHeight > 0 then "HIGH" else "LOW")
	end
)
toggleSetting("ReducedFlashing", "Reduced flashing", true)
toggleSetting("ReducedMotion", "Steady camera", false)
toggleSetting("HeadlightsEnabled", "Headlights [H]", true)
player:SetAttribute("NativeHeadlights", false) -- Studio-only A/B diagnostic attribute; H always controls ON/OFF.
toggleSetting("WideTouchControls", "Wider touch controls", false)
player:SetAttribute("SirenVolume", 0.5)
local siren: TextButton
siren = UI.button(UI.row(settings, 46), "Siren volume: 50%", UDim2.fromScale(1, 1), UDim2.new(), function()
	local current = (player:GetAttribute("SirenVolume") :: number?) or 0.5
	current = (math.floor(current * 4 + 1) % 5) / 4
	player:SetAttribute("SirenVolume", current)
	siren.Text = "Siren volume: " .. math.floor(current * 100) .. "%"
end)
local save = UI.label(UI.row(settings, 60), "", UDim2.fromScale(1, 1), UDim2.new(), 13)
UI.label(
	UI.row(settings, 35),
	"Map © OpenStreetMap contributors · ODbL 1.0",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	12
)
if RunService:IsStudio() then
	UI.button(UI.row(menuContent, 46), "Developer tools", UDim2.fromScale(1, 1), UDim2.new(), function()
		UI.open("developer")
	end)
	local dev = UI.modal("developer", "DEVELOPER TOOLS")
	for _, entry in
		{
			{ "Lab", "Handling lab" },
			{ "Highway", "Autobahn" },
			{ "Diagnostics", "Driving diagnostics" },
			{ "Profile", "Performance capture" },
		}
	do
		local action = entry[1]
		UI.button(UI.row(dev, 46), entry[2], UDim2.fromScale(1, 1), UDim2.new(), function()
			if action == "Diagnostics" or action == "Profile" then
				player:SetAttribute(action, not player:GetAttribute(action))
			else
				request:FireServer(action)
			end
			UI.open("")
		end)
	end
end
Input.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.M or key == Enum.KeyCode.ButtonStart then
		UI.toggle("menu")
	elseif key == Enum.KeyCode.J then
		UI.toggle("jobs")
	elseif key == Enum.KeyCode.U then
		UI.toggle("workshop")
	elseif key == Enum.KeyCode.P then
		UI.toggle("map")
	elseif key == Enum.KeyCode.ButtonB and UI.Name ~= "" then
		UI.open("")
	end
end)
local clock = 0
RunService.Heartbeat:Connect(function(dt)
	clock += dt
	if clock < 0.1 then
		return
	end
	clock = 0
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local w, h = shade.AbsoluteSize.X, shade.AbsoluteSize.Y
	for _, panel in modals do
		panel.Size = UDim2.fromOffset(math.min(590, w - 24), math.min(660, h - 24))
	end
	objective.Size = UDim2.fromOffset(math.min(340, math.max(144, w - 176)), 80)
	local touch = Input.TouchEnabled
	local compact = touch and h < 540
	local mapSize = if compact then 80 elseif w < 600 then 155 else 192
	UI.Map.Position = if compact
		then UDim2.fromOffset(12, 102)
		else UDim2.new(0, 12, 1, if touch then -365 else -216)
	UI.Map.Size = UDim2.fromOffset(mapSize, mapSize)
	UI.Speed.Position = if compact
		then UDim2.new(0.5, -85, 1, -80)
		else UDim2.new(1, if touch and w < 600 then -190 else -220, 1, if touch then -260 else -106)
	UI.Speed.Size =
		UDim2.fromOffset(if compact or (touch and w < 600) then 175 else 205, if compact then 65 else 80)
	UI.Speed.TextSize = if compact then 12 else 15
	UI.Speed.Visible = UI.Name == ""
	UI.Map.Visible = UI.Name == ""
	objective.Visible = UI.Name == ""
	UI.Alert.Visible = UI.Name == "" and UI.Alert.Text ~= ""
	UI.Alert.Position = UDim2.new(0.15, 0, 0, if player:GetAttribute("MissionChoice") then 162 else 98)
	UI.Toast.Visible = os.clock() < toastUntil
	UI.Wallet.Text = "$" .. tostring(player:GetAttribute("GetawayCash") or 0)
	save.Text = tostring(player:GetAttribute("SaveStatus") or "Loading garage")
	menu.Visible = UI.Name == ""
end)
return UI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="270">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Units = require(ReplicatedStorage.Shared.Units)
local Metrics = require(ReplicatedStorage.Shared.DrivingMetrics)
local CockpitFit = require(ReplicatedStorage.Shared.CockpitFit)
local TownMap = require(ReplicatedStorage.Shared.TownMap)
local metric = Metrics.new()
local cockpit = false
local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local driveInput = remotes:WaitForChild("DriveInput") :: RemoteEvent
local request = remotes:WaitForChild("VehicleRequest") :: RemoteEvent
local notice = remotes:WaitForChild("Notice") :: RemoteEvent

local UI = require(script.Parent.Interface)
local diagnosticLabel = UI.Diagnostic
local speed = UI.Speed
notice.OnClientEvent:Connect(function(message: string, destination: string?)
	UI.notify(message)
	if destination == "jobs" or destination == "workshop" then
		UI.open(destination)
	end
end)
local held: { [string]: boolean } = {}
local active: BasePart? = nil
local elapsed = 0
local cameraPosition: Vector3? = nil
local previousBodyPosition: Vector3? = nil
local previousType: Enum.CameraType? = nil
local previousFov = 70
local arrivalCharacter: Model? = nil
local controls = {
	{
		name = "Forward",
		title = "GAS",
		keys = { Enum.KeyCode.W, Enum.KeyCode.Up, Enum.KeyCode.ButtonR2 },
		position = UDim2.new(1, -90, 1, -195),
	},
	{
		name = "Reverse",
		title = "BRAKE",
		keys = { Enum.KeyCode.S, Enum.KeyCode.Down, Enum.KeyCode.ButtonL2 },
		position = UDim2.new(1, -90, 1, -115),
	},
	{
		name = "Left",
		title = "◀",
		keys = { Enum.KeyCode.A, Enum.KeyCode.Left },
		position = UDim2.new(0, 22, 1, -115),
	},
	{
		name = "Right",
		title = "▶",
		keys = { Enum.KeyCode.D, Enum.KeyCode.Right },
		position = UDim2.new(0, 102, 1, -115),
	},
	{
		name = "Drift",
		title = "DRIFT",
		keys = { Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonX },
		position = UDim2.new(0.5, -32, 1, -195),
	},
	{
		name = "Exit",
		title = "EXIT",
		keys = { Enum.KeyCode.F, Enum.KeyCode.ButtonY },
		position = UDim2.new(0, 22, 1, -195),
	},
}

local function ownBody(): BasePart?
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local seat = if humanoid then humanoid.SeatPart else nil
	if not seat or not seat:IsA("VehicleSeat") then
		return nil
	end
	local model = seat.Parent
	if not model or not model:IsA("Model") or model:GetAttribute("OwnerId") ~= player.UserId then
		return nil
	end
	return model.PrimaryPart
end

local gamepadSteer = 0
UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then
		gamepadSteer = if math.abs(input.Position.X) > 0.12 then input.Position.X else 0
	end
end)
local hiddenParts: { [BasePart]: number } = {}
local windows: { [BasePart]: number } = {}
local avatarConnection: RBXScriptConnection? = nil
local windowConnection: RBXScriptConnection? = nil
local function hideAvatar(part: Instance)
	if part:IsA("BasePart") then
		if hiddenParts[part] == nil then
			hiddenParts[part] = part.LocalTransparencyModifier
		end
		part.LocalTransparencyModifier = 1
	end
end
local function cacheWindow(part: Instance)
	local name = part.Name:lower()
	if
		part:IsA("BasePart")
		and (name == "glass" or name:find("door_glass", 1, true) or name:find("windshield", 1, true))
	then
		windows[part] = part.LocalTransparencyModifier
	end
end
local function stopControls()
	if avatarConnection then
		avatarConnection:Disconnect()
		avatarConnection = nil
	end
	if windowConnection then
		windowConnection:Disconnect()
		windowConnection = nil
	end
	for part, transparency in windows do
		if part.Parent then
			part.LocalTransparencyModifier = transparency
		end
	end
	table.clear(windows)
	for part, transparency in hiddenParts do
		if part.Parent then
			part.LocalTransparencyModifier = transparency
		end
	end
	table.clear(hiddenParts)
	for _, control in controls do
		ContextActionService:UnbindAction("Redline" .. control.name)
	end
	table.clear(held)
	driveInput:FireServer(0, 0, false)
	local camera = workspace.CurrentCamera
	if camera and previousType then
		camera.CameraType = previousType
		camera.FieldOfView = previousFov
		local humanoid = if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
	previousType, cameraPosition, previousBodyPosition = nil, nil, nil
end

local function startControls()
	local character = player.Character
	if character then
		for _, part in character:GetDescendants() do
			hideAvatar(part)
		end
		avatarConnection = character.DescendantAdded:Connect(hideAvatar)
	end
	if active and active.Parent then
		for _, part in active.Parent:GetDescendants() do
			cacheWindow(part)
		end
		windowConnection = active.Parent.DescendantAdded:Connect(cacheWindow)
	end
	metric = Metrics.new()
	local camera = workspace.CurrentCamera
	if camera then
		previousType, previousFov = camera.CameraType, camera.FieldOfView
	end
	for _, control in controls do
		ContextActionService:BindActionAtPriority(
			"Redline" .. control.name,
			function(_: string, state: Enum.UserInputState)
				if UI.Name ~= "" then
					held[control.name] = false
					return Enum.ContextActionResult.Pass
				end
				if state == Enum.UserInputState.Begin then
					held[control.name] = true
					if control.name == "Exit" then
						local humanoid = if player.Character
							then player.Character:FindFirstChildOfClass("Humanoid")
							else nil
						if humanoid then
							humanoid.Sit = false
						end
					end
				elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
					held[control.name] = false
				end
				return Enum.ContextActionResult.Sink
			end,
			true,
			3000,
			table.unpack(control.keys)
		)
		ContextActionService:SetTitle("Redline" .. control.name, control.title)
		ContextActionService:SetPosition("Redline" .. control.name, control.position)
	end
end

local function layoutControls()
	local wide = player:GetAttribute("WideTouchControls") == true
	for _, control in controls do
		local button = ContextActionService:GetButton("Redline" .. control.name)
		if button then
			button.Visible = UI.Name == ""
			button.Size = UDim2.fromOffset(if wide then 76 else 64, if wide then 76 else 64)
			local pos = control.position
			ContextActionService:SetPosition(
				"Redline" .. control.name,
				UDim2.new(
					pos.X.Scale,
					pos.X.Offset + (if wide and pos.X.Scale == 0 then 16 else 0),
					pos.Y.Scale,
					pos.Y.Offset
				)
			)
		end
	end
end
UI.Changed.Event:Connect(function()
	table.clear(held)
	gamepadSteer = 0
	layoutControls()
end)
player:GetAttributeChangedSignal("WideTouchControls"):Connect(layoutControls)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.V then
		player:SetAttribute("CockpitView", not player:GetAttribute("CockpitView"))
	elseif input.KeyCode == Enum.KeyCode.G then
		player:SetAttribute("Diagnostics", not player:GetAttribute("Diagnostics"))
		metric = Metrics.new()
	end
end)
ContextActionService:BindAction("RedlineTurbo", function(_: string, state: Enum.UserInputState)
	if UI.Name ~= "" then
		return Enum.ContextActionResult.Pass
	end
	if state == Enum.UserInputState.Begin and ownBody() then
		request:FireServer("Turbo")
	end
	return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.T)

ContextActionService:BindAction("RedlineRecover", function(_: string, state: Enum.UserInputState)
	if UI.Name ~= "" and UI.Name ~= "results" then
		return Enum.ContextActionResult.Pass
	end
	if state == Enum.UserInputState.Begin then
		request:FireServer(if UI.Name == "results" then "ReturnHome" else "Reset")
	end
	return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.R)
UserInputService.WindowFocusReleased:Connect(function()
	table.clear(held)
	driveInput:FireServer(0, 0, false)
end)
UserInputService.TextBoxFocused:Connect(function()
	table.clear(held)
	driveInput:FireServer(0, 0, false)
end)

RunService:BindToRenderStep("RedlineCamera", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	local body = ownBody()
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	cockpit = player:GetAttribute("CockpitView") == true
	diagnosticLabel.Visible = player:GetAttribute("Diagnostics") == true and body ~= nil and UI.Name == ""
	if body ~= active then
		if active then
			stopControls()
		end
		active = body
		if active then
			startControls()
			layoutControls()
		end
	end
	if not body then
		speed.Text = "GARAGE"
		local camera = workspace.CurrentCamera
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if camera and character and humanoid and root then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
			player.CameraMinZoomDistance = 0.5
			local homeCenter = TownMap.Garage + Vector3.new(0, 0, 8 / 0.28)
			player.CameraMaxZoomDistance = if (root.Position - homeCenter).Magnitude < 85 then 8 else 24
			local arrival = character:GetAttribute("GarageArrival")
			-- Wait for the server's relocation to reach this client before setting the
			-- initial view. Do this once per character, leaving mouse orbit/zoom free.
			if
				arrivalCharacter ~= character
				and typeof(arrival) == "CFrame"
				and (root.Position - arrival.Position).Magnitude < 5
			then
				local focus = root.Position + Vector3.new(0, 1.5, 0)
				camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 3, 6), focus)
				camera.Focus = CFrame.new(focus)
				camera.FieldOfView = 70
				arrivalCharacter = character
			end
		end
		return
	end
	local typing = UserInputService:GetFocusedTextBox() ~= nil or UI.Name ~= ""
	local throttle = if typing then 0 else (if held.Forward then 1 else 0) - (if held.Reverse then 1 else 0)
	local steer = if typing
		then 0
		else math.clamp(
			(if held.Right then 1 else 0) - (if held.Left then 1 else 0) + gamepadSteer,
			-1,
			1
		)
	elapsed += dt
	if elapsed >= 1 / Config.InputHz then
		elapsed = 0
		driveInput:FireServer(throttle, steer, not typing and held.Drift == true)
	end
	local velocity = body.AssemblyLinearVelocity
	local model = body.Parent :: Model
	local horizontalKmh = Units.kmh((velocity * Vector3.new(1, 0, 1)).Magnitude)
	Metrics.step(metric, horizontalKmh, throttle, dt)
	diagnosticLabel.Text = string.format(
		"Steer %.1f° · ground %d/4 · damage %d%%\n0–50: %s s · last stop: %s m from %s km/h",
		(model:GetAttribute("SteeringAngle") :: number?) or 0,
		(model:GetAttribute("GroundedWheels") :: number?) or 0,
		(model:GetAttribute("Damage") :: number?) or 0,
		if metric.zeroTo50 then string.format("%.1f", metric.zeroTo50) else "—",
		if metric.lastStop then string.format("%.1f", metric.lastStop) else "—",
		if metric.lastFrom then string.format("%.0f", metric.lastFrom) else "—"
	)
	local boost = (model:GetAttribute("Boost") :: number?) or 0
	local heat = (model:GetAttribute("TurboHeat") :: number?) or 0
	local turboState = if model:GetAttribute("TurboOverheated")
		then "COOLING"
		elseif model:GetAttribute("TurboEnabled") then "TURBO"
		else "TURBO OFF"
	speed.Text = string.format(
		"%03d km/h · %03d mph\n%s %02d%% · TEMP %02d%%\nDAMAGE %02d%% · %s",
		math.floor(horizontalKmh),
		math.floor(Units.mph((velocity * Vector3.new(1, 0, 1)).Magnitude)),
		turboState,
		boost * 100,
		heat * 100,
		(model:GetAttribute("Damage") :: number?) or 0,
		if model:GetAttribute("Drifting")
			then "DRIFT " .. tostring(model:GetAttribute("DriftPoints") or 0)
			else "GRIP"
	)
	-- Translate the chase camera with recycled highway space to preserve the view.
	if previousBodyPosition and cameraPosition then
		local delta = body.Position - previousBodyPosition
		if delta.Magnitude > 1000 then
			cameraPosition += delta
		end
	end
	previousBodyPosition = body.Position
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	for part in hiddenParts do
		if part.Parent then
			part.LocalTransparencyModifier = 1
		end
	end
	for part, transparency in windows do
		if part.Parent then
			part.LocalTransparencyModifier = if cockpit then 0.9 else transparency
		end
	end
	local eye = body:FindFirstChild("CockpitEye")
	if cockpit and eye and eye:IsA("Attachment") and not model:GetAttribute("Crashed") then
		local height = CockpitFit.adjust(
			eye.Position.Y,
			(player:GetAttribute("CockpitHeight") :: number?) or 0,
			(eye:GetAttribute("MinHeight") :: number?) or eye.Position.Y,
			(eye:GetAttribute("MaxHeight") :: number?) or eye.Position.Y
		)
		local position = body.CFrame:PointToWorldSpace(Vector3.new(eye.Position.X, height, eye.Position.Z))
		local forward = body.CFrame.LookVector
		-- No delayed position following, and no chassis roll on the horizon.
		local up = if math.abs(forward.Y) < 0.98 then Vector3.yAxis else body.CFrame.UpVector
		camera.CFrame = CFrame.lookAt(position, position + forward * 40, up)
		camera.Focus = camera.CFrame * CFrame.new(0, 0, -40)
		camera.FieldOfView = 72
		cameraPosition = nil
		return
	end
	local facing = body.CFrame.LookVector * Vector3.new(1, 0, 1)
	if facing.Magnitude < 0.1 then
		facing = Vector3.new(0, 0, -1)
	end
	facing = facing.Unit
	local focus = body.Position + Vector3.new(0, 2, 0) + facing * math.min(velocity.Magnitude * 0.07, 7)
	local desired = body.Position - facing * Config.CameraDistance + Vector3.new(0, Config.CameraHeight, 0)
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Exclude
	ray.FilterDescendantsInstances = { body.Parent :: Instance }
	ray.CollisionGroup = "Cars"
	ray.RespectCanCollide = true
	ray.IgnoreWater = true
	local hit = workspace:Raycast(focus, desired - focus, ray)
	if hit then
		desired = hit.Position + hit.Normal * 1.2
	end
	local alpha = 1 - math.exp(-Config.CameraResponse * dt)
	local prior = cameraPosition
	cameraPosition = if prior and (prior - desired).Magnitude < 80
		then prior:Lerp(desired, alpha)
		else desired
	-- Check the interpolated position too, so smoothing cannot cut through a barrier.
	local obstruction = workspace:Raycast(focus, (cameraPosition :: Vector3) - focus, ray)
	if obstruction then
		cameraPosition = obstruction.Position + obstruction.Normal * 1.2
	end
	camera.CFrame = CFrame.lookAt(cameraPosition :: Vector3, focus)
	camera.Focus = CFrame.new(focus)
	camera.FieldOfView += ((if player:GetAttribute("ReducedMotion")
		then 70
		else 70 + math.min(velocity.Magnitude / 10, 10)) - camera.FieldOfView) * alpha
end)
print("[REDLINE COUNTY] Driving HUD, keyboard/touch controls and chase camera ready.")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="271">
          <Properties>
            <string name="Name">NightLights</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Units = require(Shared.Units)
local HeadlightMath = require(Shared.HeadlightMath)
local RoadBeam = require(script.Parent.RoadBeam)
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local UI = require(script.Parent.Interface)
local function toggle()
	player:SetAttribute("HeadlightsEnabled", not player:GetAttribute("HeadlightsEnabled"))
end
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.H then
		toggle()
	end
end)
player:GetAttributeChangedSignal("HeadlightsEnabled"):Connect(function()
	UI.notify(
		if player:GetAttribute("HeadlightsEnabled")
			then "Headlights ON · speed-adaptive road visibility"
			else "Headlights OFF · press H to turn on"
	)
end)
local elapsed = 0
type CarLights = { model: Model, body: BasePart, lights: { SpotLight } }
local carLights: { CarLights } = {}

-- Nearby traffic gets real light sources; distant cars retain visible neon lenses.
-- These local visual changes never move traffic or alter collision state.
RunService.Heartbeat:Connect(function(dt: number)
	elapsed += dt
	if elapsed < 0.2 then
		return
	end
	elapsed = 0
	local camera = workspace.CurrentCamera
	local position = if camera then camera.CFrame.Position else Vector3.zero
	local candidates: { { light: SpotLight, distance: number } } = {}
	local traffic = workspace:FindFirstChild("HighwayTraffic")
	for _, model in if traffic then traffic:GetChildren() else {} do
		local lamp = model:FindFirstChild("TrafficHeadlight", true)
		if model:IsA("Model") and model.PrimaryPart and lamp and lamp:IsA("SpotLight") then
			table.insert(
				candidates,
				{ light = lamp, distance = (model.PrimaryPart.Position - position).Magnitude }
			)
		end
	end
	table.sort(candidates, function(a, b)
		return a.distance < b.distance
	end)
	for i, candidate in candidates do
		candidate.light.Enabled = player:GetAttribute("NightDriving") == true
			and i <= 6
			and candidate.distance < 300
	end
	-- Refresh references separately from per-frame updates; never interpolate a light transform.
	table.clear(carLights)
	for _, folderName in { "Vehicles", "TownTraffic", "PolicePatrols" } do
		local vehicles = workspace:FindFirstChild(folderName)
		if vehicles then
			for _, model in vehicles:GetChildren() do
				if model:IsA("Model") and model.PrimaryPart then
					local lights: { SpotLight } = {}
					for _, lamp in model.PrimaryPart:GetDescendants() do
						if lamp:IsA("SpotLight") and lamp.Name == "AdaptiveHeadlight" then
							table.insert(lights, lamp)
						end
					end
					table.insert(carLights, { model = model, body = model.PrimaryPart, lights = lights })
				end
			end
		end
	end
	table.sort(carLights, function(a, b)
		return (a.body.Position - position).Magnitude < (b.body.Position - position).Magnitude
	end)
end)

RunService:BindToRenderStep("RedlineHeadlightRange", Enum.RenderPriority.Camera.Value + 2, function()
	local projected = player:GetAttribute("NativeHeadlights") ~= true
	RoadBeam.hide()
	for i, car in carLights do
		if not car.model.Parent or not car.body.Parent then
			continue
		end
		local speed = (car.body.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude
		local range, angle, brightness = HeadlightMath.beam(Units.kmh(speed), Config.Headlights)
		local owned = car.model:GetAttribute("OwnerId") == player.UserId
		local alive = car.model:GetAttribute("Crashed") ~= true
			and (if owned
				then player:GetAttribute("HeadlightsEnabled") == true
				else player:GetAttribute("NightDriving") == true)
			and (
				owned
				or (
					i <= 5
					and workspace.CurrentCamera ~= nil
					and (car.body.Position - (workspace.CurrentCamera :: Camera).CFrame.Position).Magnitude
						< 220
				)
			)
		if
			owned
			and alive
			and projected
			and workspace.CurrentCamera
			and (car.body.Position - workspace.CurrentCamera.CFrame.Position).Magnitude < 250
		then
			RoadBeam.update(car.body, HeadlightMath.roadReach(speed, Config.Headlights), player.Character)
		end
		for _, light in car.lights do
			if light.Parent then
				light.Enabled = alive -- Native lights illuminate nearby vehicles; the overlay extends road visibility.
				light.Range, light.Angle, light.Brightness = range, angle, brightness
				light.Shadows = false
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="272">
          <Properties>
            <string name="Name">NightMode</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local player = Players.LocalPlayer
local night = true
local highwayLocked = false
local UI = require(script.Parent.Interface)
local function toggle()
	if not highwayLocked then
		player:SetAttribute("NightPreference", not player:GetAttribute("NightPreference"))
		UI.notify(if player:GetAttribute("NightPreference") then "Night driving ON" else "Day driving ON")
	else
		UI.notify("The Autobahn uses night driving. Return to town to switch to daylight.")
	end
end
Input.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.N then
		toggle()
	end
end)
local elapsed = 0
local previous: boolean? = nil
RunService.Heartbeat:Connect(function(dt)
	elapsed += dt
	if elapsed < 0.2 then
		return
	end
	elapsed = 0
	local root = if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
	local highway = root and root:IsA("BasePart") and math.abs(root.Position.X - Config.Highway.X) < 300
	highwayLocked = highway == true
	night = player:GetAttribute("NightPreference") == true
	local enabled = night or highwayLocked
	if previous == enabled then
		return
	end
	previous = enabled
	player:SetAttribute("NightDriving", enabled)
	Lighting.ClockTime = if enabled then 0.5 else 16
	Lighting.Ambient = if enabled then Color3.fromRGB(36, 43, 61) else Color3.fromRGB(90, 92, 94)
	Lighting.OutdoorAmbient = if enabled then Color3.fromRGB(53, 62, 80) else Color3.fromRGB(127, 130, 132)
	Lighting.ExposureCompensation = if enabled then 0.05 else 0.1
end)

local lamps: { [PointLight]: boolean } = {}
local function inspect(item: Instance)
	if item:IsA("PointLight") and item.Name == "MapLamp" then
		lamps[item] = true
	end
end
local map = workspace:WaitForChild("HopedaleGenerated")
for _, item in map:GetDescendants() do
	inspect(item)
end
map.DescendantAdded:Connect(inspect)
local lampClock = 0
RunService.Heartbeat:Connect(function(dt)
	lampClock += dt
	if lampClock < 0.5 then
		return
	end
	lampClock = 0
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local ranked: { { lamp: PointLight, distance: number } } = {}
	for lamp in lamps do
		local parent = lamp.Parent
		if not parent then
			lamps[lamp] = nil
		elseif parent:IsA("BasePart") then
			table.insert(
				ranked,
				{ lamp = lamp, distance = (parent.Position - camera.CFrame.Position).Magnitude }
			)
		end
	end
	table.sort(ranked, function(a, b)
		return a.distance < b.distance
	end)
	for i, entry in ranked do
		entry.lamp.Enabled = player:GetAttribute("NightDriving") == true and i <= 6 and entry.distance < 230
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="273">
          <Properties>
            <string name="Name">Performance</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end
local Players = game:GetService("Players")
local Stats = game:GetService("Stats")
local HttpService = game:GetService("HttpService")
local Samples = require(game:GetService("ReplicatedStorage").Shared.PerformanceSamples)
local UI = require(script.Parent.Interface)
local player = Players.LocalPlayer
local values: { number } = {}
local started = 0
local function report()
	if #values == 0 then
		return
	end
	local data = {
		seconds = math.floor(os.clock() - started),
		samples = #values,
		p50ms = Samples.percentile(values, 0.5),
		p95ms = Samples.percentile(values, 0.95),
		p99ms = Samples.percentile(values, 0.99),
		memoryMB = Stats:GetTotalMemoryUsageMb(),
		traffic = workspace:GetAttribute("TownTrafficCount"),
		night = player:GetAttribute("NightPreference"),
		touch = game:GetService("UserInputService").TouchEnabled,
		players = #Players:GetPlayers(),
	}
	print("[REDLINE PERFORMANCE] " .. HttpService:JSONEncode(data))
	UI.notify(string.format("Captured %d frames · p95 %.1f ms. Details in Output.", #values, data.p95ms))
	table.clear(values)
end
player:GetAttributeChangedSignal("Profile"):Connect(function()
	if player:GetAttribute("Profile") then
		table.clear(values)
		started = os.clock()
		UI.notify("Frame capture started. Toggle again to print the report.")
	else
		report()
	end
end)
RunService.RenderStepped:Connect(function(dt: number)
	if player:GetAttribute("Profile") then
		table.insert(values, dt * 1000)
		if #values >= 72000 then
			player:SetAttribute("Profile", false)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="274">
          <Properties>
            <string name="Name">PoliceAlert</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Units = require(game:GetService("ReplicatedStorage").Shared.Units)
local player = Players.LocalPlayer
local UI = require(script.Parent.Interface)
local alert = UI.Alert
local elapsed = 0
local previousDistance = math.huge
local previousCar: Model? = nil
RunService.Heartbeat:Connect(function(dt)
	elapsed += dt
	if elapsed < 0.2 then
		return
	end
	elapsed = 0
	local root = if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") then
		alert.Text = ""
		return
	end
	local nearest: Model? = nil
	local distance = 350
	local pursuit = false
	for _, name in { "TownTraffic", "PolicePatrols" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			for _, model in folder:GetChildren() do
				if model:IsA("Model") and model.PrimaryPart and model:GetAttribute("Police") then
					local gap = (root.Position - model.PrimaryPart.Position).Magnitude
					local chasing = model:GetAttribute("TargetUserId") == player.UserId
					if
						gap < 350 and ((chasing and not pursuit) or (chasing == pursuit and gap < distance))
					then
						pursuit = chasing
						distance = gap
						nearest = model
					end
				end
			end
		end
	end
	if not nearest then
		alert.Text = ""
	end
	if nearest and nearest.PrimaryPart then
		local localPoint = root.CFrame:PointToObjectSpace(nearest.PrimaryPart.Position)
		local direction = if math.abs(localPoint.X) > math.abs(localPoint.Z)
			then (if localPoint.X < 0 then "LEFT" else "RIGHT")
			else (if localPoint.Z < 0 then "AHEAD" else "BEHIND")
		local chasing = nearest:GetAttribute("TargetUserId") == player.UserId
		local closing = nearest == previousCar and distance < previousDistance - 1
		alert.BackgroundColor3 = if chasing and distance < 90
			then Color3.fromRGB(163, 35, 43)
			elseif chasing then Color3.fromRGB(155, 86, 28)
			else Color3.fromRGB(27, 54, 81)
		alert.BackgroundTransparency = if chasing
				and distance < 90
				and not player:GetAttribute("ReducedFlashing")
			then (if math.floor(os.clock() * 4) % 2 == 0 then 0.05 else 0.3)
			else 0.12
		alert.Text = string.format(
			"%s · %d m · %s%s",
			if chasing
				then "HEAT " .. tostring(player:GetAttribute("Wanted") or 1) .. " · POLICE"
				else "PATROL NEARBY",
			math.floor(Units.kilometres(distance) * 1000),
			direction,
			if closing then " · CLOSING" else ""
		)
		local bust = (player:GetAttribute("MissionBusted") :: number?) or 0
		if chasing and bust > 0 then
			alert.Text ..= string.format(" · BUST IN %.1f s", math.max(0, 5 - bust))
		end
	end
	previousDistance = distance
	previousCar = nearest
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="275">
          <Properties>
            <string name="Name">RoadBeam</string>
            <string name="Source"><![CDATA[--!strict
-- Client-only road illumination approximation, independent of the light-grid refresh.
-- Raycasts place a small, reusable beam mesh on the road each rendered frame.
local RoadBeam = {}
local Math = require(game:GetService("ReplicatedStorage").Shared.HeadlightMath)
local STEPS = 16

type Strip = { a: Attachment, b: Attachment, beam: Beam, side: number, step: number }
local strips: { Strip } = {}
local holder = Instance.new("Part")
holder.Name = "LocalRoadBeams"
holder.Anchored = true
holder.Transparency = 1
holder.Size = Vector3.one
holder.CanCollide, holder.CanTouch, holder.CanQuery = false, false, false
holder.Parent = workspace
for _, side in { -1, 1 } do
	for step = 1, STEPS do
		local a, b = Instance.new("Attachment"), Instance.new("Attachment")
		a.Parent, b.Parent = holder, holder
		local beam = Instance.new("Beam")
		beam.Name = "RoadLight"
		beam.Attachment0, beam.Attachment1 = a, b
		beam.FaceCamera = false
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 241, 205))
		beam.Segments = 1
		local t0, t1 = (step - 1) / STEPS, step / STEPS
		beam.Transparency = NumberSequence.new(0.48 + 0.52 * t0, 0.48 + 0.52 * t1)
		beam.Enabled = false
		beam.Parent = holder
		table.insert(strips, { a = a, b = b, beam = beam, side = side, step = step })
	end
end
local params = RaycastParams.new()
params.RespectCanCollide = true
params.FilterType = Enum.RaycastFilterType.Exclude

function RoadBeam.hide()
	for _, strip in strips do
		strip.beam.Enabled = false
	end
end

function RoadBeam.update(body: BasePart, range: number, character: Model?)
	local forward = body.CFrame.LookVector * Vector3.new(1, 0, 1)
	if forward.Magnitude < 0.1 or body.CFrame.UpVector.Y < 0.5 then
		RoadBeam.hide()
		return
	end
	forward = forward.Unit
	local right = forward:Cross(Vector3.yAxis)
	local exclude: { Instance } = { body.Parent :: Instance, holder }
	if character then
		table.insert(exclude, character)
	end
	params.FilterDescendantsInstances = exclude
	-- Origin follows this frame's chassis transform, including turns and highway wraps.
	for _, side in { -1, 1 } do
		local origin = body.Position + forward * (body.Size.Z / 2 + 0.2) + right * (side * body.Size.X * 0.33)
		local obstacle = workspace:Raycast(origin, forward * range, params)
		local reach = if obstacle then math.max(0, obstacle.Distance - 1) else range
		local points: { RaycastResult? } = {}
		for i = 0, STEPS do
			local distance = Math.sampleDistance(reach, i, STEPS)
			local sample = origin + forward * distance
			points[i + 1] = workspace:Raycast(sample + Vector3.yAxis * 2, -Vector3.yAxis * 10, params)
		end
		for _, strip in strips do
			if strip.side ~= side then
				continue
			end
			local a, b = points[strip.step], points[strip.step + 1]
			local d0, d1 =
				Math.sampleDistance(reach, strip.step - 1, STEPS),
				Math.sampleDistance(reach, strip.step, STEPS)
			local valid = a ~= nil and b ~= nil and reach > 0.5
			if a and b then
				valid = valid
					and a.Normal.Y > 0.85
					and b.Normal.Y > 0.85
					and math.abs(a.Position.Y - b.Position.Y) < 1
				-- Attachment Y axes define the beam's width across the road.
				strip.a.WorldCFrame =
					CFrame.fromMatrix(a.Position + a.Normal * Math.SurfaceLift, forward, right)
				strip.b.WorldCFrame =
					CFrame.fromMatrix(b.Position + b.Normal * Math.SurfaceLift, forward, right)
				strip.beam.Width0, strip.beam.Width1 =
					math.min(4 + d0 * 0.08, 30), math.min(4 + d1 * 0.08, 30)
			end
			strip.beam.Enabled = valid
		end
	end
end

return RoadBeam
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="276">
          <Properties>
            <string name="Name">VehicleAudio</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Audio = require(game:GetService("ReplicatedStorage").Shared.AudioCatalog)
local UI = require(script.Parent.Interface)
local player = Players.LocalPlayer
local function sound(parent: Instance, name: string, id: string, loop: boolean, distance: number): Sound
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id
	s.Looped = loop
	s.Volume = 0
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 12
	s.RollOffMaxDistance = distance
	s.Parent = parent
	return s
end
type Voice = {
	body: BasePart,
	engine: Sound,
	high: Sound,
	skid: Sound,
	impact: Sound,
	siren: Sound,
	damage: number,
	lamps: { BasePart },
}
local voices: { [Model]: Voice } = {}
local dispatch = sound(SoundService, "RedlineDispatch", Audio.Dispatch, false, 0)
local lastCue = 0
player:GetAttributeChangedSignal("MissionMessage"):Connect(function()
	local message = tostring(player:GetAttribute("MissionMessage") or "")
	if
		player:GetAttribute("Wanted")
		and (player:GetAttribute("Wanted") :: number) > 0
		and os.clock() - lastCue > 3
	then
		lastCue = os.clock()
		dispatch.Volume = 0.25 * ((player:GetAttribute("SirenVolume") :: number?) or 0.5)
		dispatch:Play()
		UI.notify(message)
	end
end)
local function destroy(v: Voice)
	for _, s in { v.engine, v.high, v.skid, v.impact, v.siren } do
		s:Destroy()
	end
end
player:GetAttributeChangedSignal("Wanted"):Connect(function()
	if ((player:GetAttribute("Wanted") :: number?) or 0) > 0 and os.clock() - lastCue > 3 then
		lastCue = os.clock()
		dispatch.Volume = 0.25 * ((player:GetAttribute("SirenVolume") :: number?) or 0.5)
		dispatch:Play()
		UI.notify("POLICE ALERTED · Use corners and buildings to break sight.")
	end
end)
local scan, clock = 0, 0
RunService.Heartbeat:Connect(function(dt)
	scan += dt
	clock += dt
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if scan >= 0.5 then
		scan = 0
		local near: { { model: Model, distance: number } } = {}
		for _, name in { "Vehicles", "TownTraffic", "PolicePatrols" } do
			local folder = workspace:FindFirstChild(name)
			if folder then
				for _, m in folder:GetChildren() do
					if m:IsA("Model") and m.PrimaryPart then
						local distance = (m.PrimaryPart.Position - camera.CFrame.Position).Magnitude
						if distance < 550 then
							table.insert(near, { model = m, distance = distance })
						end
					end
				end
			end
		end
		table.sort(near, function(a, b)
			return a.distance < b.distance
		end)
		local keep: { [Model]: boolean } = {}
		for i = 1, math.min(8, #near) do
			keep[near[i].model] = true
		end
		for model, v in voices do
			if not keep[model] then
				destroy(v)
				voices[model] = nil
			end
		end
		for model in keep do
			if not voices[model] and model.PrimaryPart then
				local body = model.PrimaryPart
				local v: Voice = {
					body = body,
					engine = sound(body, "EngineLow", Audio.Engine, true, 200),
					high = sound(body, "EngineHigh", Audio.EngineHigh, true, 200),
					skid = sound(body, "TyreSlip", Audio.Skid, true, 130),
					impact = sound(body, "Impact", Audio.Impact, false, 220),
					siren = sound(body, "Siren", Audio.Siren, true, 550),
					damage = (model:GetAttribute("Damage") :: number?) or 0,
					lamps = {},
				}
				if model:GetAttribute("Police") then
					for _, part in model:GetDescendants() do
						if
							part:IsA("BasePart") and (part.Name == "PoliceRed" or part.Name == "PoliceBlue")
						then
							table.insert(v.lamps, part)
						end
					end
				end
				voices[model] = v
				v.engine:Play()
				v.high:Play()
				v.skid:Play()
			end
		end
	end
	if clock < 0.05 then
		return
	end
	clock = 0
	for model, v in voices do
		if not model.Parent then
			continue
		end
		local speed = math.abs(v.body.AssemblyLinearVelocity:Dot(v.body.CFrame.LookVector))
		local load = math.max(0, (model:GetAttribute("Throttle") :: number?) or 0)
		local localVelocity = v.body.CFrame:VectorToObjectSpace(v.body.AssemblyLinearVelocity)
		local slip = math.abs(math.deg(math.atan2(localVelocity.X, math.max(2, math.abs(localVelocity.Z)))))
		local moving = speed > 1 or model:GetAttribute("OwnerId") == player.UserId
		local rpm = 0.75 + math.min(1.5, speed / 90) + load * 0.16
		v.engine.PlaybackSpeed = rpm
		v.high.PlaybackSpeed = 0.8 + speed / 150
		v.engine.Volume = if moving then 0.12 + 0.14 * load else 0.06
		v.high.Volume = if moving then math.clamp((speed - 25) / 150, 0, 0.23) * (0.4 + 0.6 * load) else 0
		v.skid.Volume = if speed > 16
				and ((model:GetAttribute("GroundedWheels") :: number?) or 0) >= 2
			then math.clamp((slip - 8) / 45, 0, 0.35)
			else 0
		local damage = (model:GetAttribute("Damage") :: number?) or 0
		if damage > v.damage + 1 then
			v.impact.Volume = math.clamp((damage - v.damage) / 50, 0.12, 0.65)
			v.impact:Play()
		end
		v.damage = damage
		local chasing = model:GetAttribute("TargetUserId") ~= nil
		v.siren.Volume = if chasing
			then 0.65 * ((player:GetAttribute("SirenVolume") :: number?) or 0.5)
			else 0
		if chasing and not v.siren.IsPlaying then
			v.siren:Play()
		elseif not chasing and v.siren.IsPlaying then
			v.siren:Stop()
		end
		for _, lamp in v.lamps do
			lamp.Transparency = if not chasing
				then 0.5
				elseif player:GetAttribute("ReducedFlashing") then 0
				elseif (math.floor(os.clock() * 3) % 2 == 0) == (lamp.Name == "PoliceRed") then 0
				else 0.8
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="277">
          <Properties>
            <string name="Name">VehicleVisuals</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local TownDriving = require(Shared.TownDriving)
local Driving = require(Shared.Driving)
type Visual = {
	body: BasePart,
	motors: { Motor6D },
	spin: number,
	steer: number,
	connection: RBXScriptConnection,
}
local visuals: { [Model]: Visual } = {}
local scan = 0
RunService.PreSimulation:Connect(function(dt: number)
	scan += dt
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if scan >= 0.5 then
		scan = 0
		local near: { { model: Model, distance: number } } = {}
		for _, name in { "Vehicles", "TownTraffic", "PolicePatrols" } do
			local folder = workspace:FindFirstChild(name)
			if folder then
				for _, m in folder:GetChildren() do
					if m:IsA("Model") and m.PrimaryPart then
						local distance = (m.PrimaryPart.Position - camera.CFrame.Position).Magnitude
						if distance < 650 then
							table.insert(near, { model = m, distance = distance })
						end
					end
				end
			end
		end
		table.sort(near, function(a, b)
			return a.distance < b.distance
		end)
		local keep: { [Model]: boolean } = {}
		for i = 1, math.min(20, #near) do
			keep[near[i].model] = true
		end
		for m, v in visuals do
			if not keep[m] then
				v.connection:Disconnect()
				visuals[m] = nil
			end
		end
		for m in keep do
			if not visuals[m] and m.PrimaryPart then
				local motors: { Motor6D } = {}
				local function add(part: Instance)
					if part:IsA("Motor6D") and (part.Name == "RoadWheel" or part.Name == "SteeringMotor") then
						table.insert(motors, part)
					end
				end
				for _, part in m:GetDescendants() do
					add(part)
				end
				visuals[m] = {
					body = m.PrimaryPart,
					motors = motors,
					spin = 0,
					steer = 0,
					connection = m.DescendantAdded:Connect(add),
				}
			end
		end
	end
	for m, v in visuals do
		if not m.Parent then
			continue
		end
		local speed = v.body.AssemblyLinearVelocity:Dot(v.body.CFrame.LookVector)
		v.spin = (
			v.spin
			+ TownDriving.wheelRotation(
				speed,
				math.min(dt, 0.1),
				(m:GetAttribute("WheelRadius") :: number?) or 1.25
			)
		) % (math.pi * 2)
		v.steer = Driving.approach(v.steer, (m:GetAttribute("VisualSteer") :: number?) or 0, 12, dt)
		for _, motor in v.motors do
			if not motor.Parent then
				continue
			end
			if motor.Name == "SteeringMotor" then
				motor.Transform = CFrame.Angles(0, 0, -v.steer * math.rad(120))
			else
				motor.Transform = CFrame.Angles(
					0,
					if motor:GetAttribute("FrontWheel") then -TownDriving.steerAngle(speed, v.steer) else 0,
					0
				) * CFrame.Angles(v.spin, 0, 0)
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="278">
          <Properties>
            <string name="Name">Workshop</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UI = require(script.Parent.Interface)
local Progression = require(Shared.Progression)
local Cosmetics = require(Shared.Cosmetics)
local player = Players.LocalPlayer
local request = Shared.Parent:WaitForChild("Remotes"):WaitForChild("VehicleRequest") :: RemoteEvent
local content = UI.modal("workshop", "YOUR WORKSHOP")
local balance = UI.label(UI.row(content, 58), "", UDim2.fromScale(1, 1), UDim2.new(), 16)
local feedback = UI.label(
	UI.row(content, 48),
	"Park at home to fit parts. Your three starter cars are free.",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	13
)
local rows: { { label: TextLabel, button: TextButton, id: string, prices: { number }, name: string } } = {}
for _, upgrade in Progression.Catalog do
	local row = UI.row(content, 90)
	local label = UI.label(row, upgrade.Name, UDim2.new(1, -110, 0, 28), UDim2.new(), 16)
	UI.label(row, upgrade.Effect, UDim2.new(1, -110, 0, 56), UDim2.fromOffset(0, 29), 13)
	local button = UI.button(row, "BUY", UDim2.fromOffset(98, 46), UDim2.new(1, -98, 0, 18), function()
		request:FireServer("Upgrade", upgrade.Id)
	end)
	table.insert(
		rows,
		{ label = label, button = button, id = upgrade.Id, prices = upgrade.Prices, name = upgrade.Name }
	)
end
UI.label(UI.row(content, 38), "PAINT · WHEELS · INTERIOR", UDim2.fromScale(1, 1), UDim2.new(), 17).TextColor3 =
	UI.Gold
local finishes: { { button: TextButton, id: string, price: number } } = {}
for _, item in Cosmetics do
	local row = UI.row(content, 64)
	local swatch = UI.frame(row, UDim2.fromOffset(24, 24), UDim2.fromOffset(0, 16))
	swatch.BackgroundColor3 = Color3.fromRGB(item.RGB[1], item.RGB[2], item.RGB[3])
	swatch.BackgroundTransparency = 0
	UI.label(row, item.Name, UDim2.new(1, -152, 1, 0), UDim2.fromOffset(34, 0), 14)
	local b = UI.button(
		row,
		"$" .. item.Price,
		UDim2.fromOffset(108, 44),
		UDim2.new(1, -108, 0, 10),
		function()
			request:FireServer("Cosmetic", item.Id)
		end
	)
	table.insert(finishes, { button = b, id = item.Id, price = item.Price })
end
local cars = UI.modal("cars", "YOUR GARAGE")
for _, entry in
	{
		{ "Electric", "Everyday sedan", "Predictable grip · 180 km/h · electric" },
		{ "Sport", "Sport coupe", "Agile handling · 210 km/h · turbo available" },
		{ "Pickup", "Utility pickup", "Long wheelbase · stable platform · 150 km/h" },
	}
do
	local kind = entry[1]
	local row = UI.row(cars, 108)
	UI.label(row, entry[2], UDim2.new(1, -110, 0, 32), UDim2.new(), 18)
	UI.label(row, entry[3], UDim2.new(1, -110, 0, 64), UDim2.fromOffset(0, 34), 13)
	UI.button(row, "SELECT", UDim2.fromOffset(102, 46), UDim2.new(1, -102, 0, 24), function()
		request:FireServer("Spawn", kind)
	end)
end
UI.label(
	UI.row(cars, 60),
	"Select at home, open your bay door, then press E beside the car. Starting a job seats you automatically.",
	UDim2.fromScale(1, 1),
	UDim2.new(),
	14
)
local notice = Shared.Parent.Remotes:WaitForChild("Notice") :: RemoteEvent
notice.OnClientEvent:Connect(function(text: string)
	feedback.Text = text
end)
local clock = 0
RunService.Heartbeat:Connect(function(dt)
	clock += dt
	if clock < 0.2 or UI.Name ~= "workshop" then
		return
	end
	clock = 0
	local kind = (player:GetAttribute("WorkshopCar") :: string?) or "Select a car"
	local cash = (player:GetAttribute("GetawayCash") :: number?) or 0
	balance.Text = kind .. " · $" .. cash .. "\n" .. tostring(player:GetAttribute("SaveStatus") or "Loading")
	for _, row in rows do
		local level = (player:GetAttribute("Upgrade_" .. kind .. "_" .. row.id) :: number?) or 0
		local price = row.prices[level + 1]
		row.label.Text = row.name .. " · " .. level .. "/3"
		row.button.Text = if price then "$" .. price else "FITTED"
		row.button.BackgroundColor3 = if price and cash >= price
			then UI.Accent
			else Color3.fromRGB(132, 144, 146)
	end
	for _, item in finishes do
		item.button.Text = if player:GetAttribute("Owned_" .. item.id) then "FIT OWNED" else "$" .. item.price
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
