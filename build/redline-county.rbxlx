      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CrashMath</string>
          <string name="Source"><![CDATA[--!strict
local CrashMath = {}

-- Intersect entry/exit times on separating axes. Used for a moving oriented car
-- against axis-aligned lane traffic, including vertical separation.
function CrashMath.sweep(start: { number }, finish: { number }, halfExtents: { number }): number?
	local first, last = 0, 1
	for axis, extent in halfExtents do
		local origin, delta = start[axis], finish[axis] - start[axis]
		if math.abs(delta) < 1e-8 then
			if math.abs(origin) > extent then
				return nil
			end
		else
			local a, b = (-extent - origin) / delta, (extent - origin) / delta
			if a > b then
				a, b = b, a
			end
			first, last = math.max(first, a), math.min(last, b)
			if first > last then
				return nil
			end
		end
	end
	return first
end

function CrashMath.canBegin(crashed: boolean, contact: boolean): boolean
	return contact and not crashed
end

return CrashMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DriftRules</string>
          <string name="Source"><![CDATA[--!strict
local Drift = {}
export type State = { points: number, seconds: number, gap: number, damage: number }
function Drift.new(): State
	return { points = 0, seconds = 0, gap = 0, damage = 0 }
end
function Drift.step(
	s: State,
	dt: number,
	speed: number,
	lateral: number,
	grounded: boolean,
	damage: number,
	valid: boolean
): (number, number)
	dt = math.clamp(dt, 0, 0.1)
	if not valid or damage > s.damage then
		s.points = 0
		s.seconds = 0
		s.gap = 0
	end
	s.damage = damage
	if not valid then
		return 0, 0
	end
	local angle = math.deg(math.atan2(math.abs(lateral), math.abs(speed)))
	if grounded and speed > 25 and angle >= 10 and angle <= 65 then
		s.seconds += dt
		s.gap = 0
		s.points += dt * math.min(60, angle) * math.min(2, 1 + s.seconds / 6)
	elseif s.points > 0 then
		s.gap += dt
	end
	if s.gap >= 1.25 then
		local bank = if s.seconds >= 1.5 then math.min(100, math.floor(s.points / 10)) else 0
		local score = if bank > 0 then math.floor(s.points) else 0
		s.points = 0
		s.seconds = 0
		s.gap = 0
		return bank, score
	end
	return 0, 0
end
return Drift
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Driving</string>
          <string name="Source"><![CDATA[--!strict
-- Engine-independent handling math: tested in the standalone Luau runtime.
local Driving = {}
export type Tuning = {
	TopSpeed: number,
	BoostSpeed: number,
	BoostAcceleration: number,
	ReverseSpeed: number,
	Acceleration: number,
	Brake: number,
	Grip: number,
	DriftGrip: number,
	DriftTurn: number,
	DriftMinSpeed: number,
	DriftDrag: number,
	Turn: number,
}

function Driving.finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Driving.validInput(throttle: any, steer: any, drift: any): boolean
	return Driving.finite(throttle)
		and Driving.finite(steer)
		and math.abs(throttle) <= 1
		and math.abs(steer) <= 1
		and type(drift) == "boolean"
end

function Driving.forces(
	speed: number,
	lateral: number,
	throttle: number,
	steer: number,
	drift: boolean,
	tune: Tuning,
	boost: number?
): (number, number, number)
	local pressure = math.clamp(boost or 0, 0, 1)
	local acceleration: number
	if throttle * speed < -3 then
		acceleration = throttle * tune.Brake
	elseif math.abs(throttle) < 0.01 then
		acceleration = -speed * 0.65
	else
		local limit = if throttle > 0 then tune.TopSpeed + pressure * tune.BoostSpeed else tune.ReverseSpeed
		local powerFade = if throttle > 0 then 1 / (1 + (math.abs(speed) / (limit * 0.55)) ^ 2) else 1
		acceleration = throttle
			* powerFade
			* tune.Acceleration
			* (1 + pressure * (tune.BoostAcceleration - 1))
			* math.clamp((limit - math.abs(speed)) / 15, 0, 1)
		-- Aerodynamic slowdown above the available power limit, including turbo cooldown.
		acceleration -= math.sign(speed) * math.max(0, math.abs(speed) - limit) * 0.65
	end
	-- Blend in only while moving forward: parking and reversing stay predictable.
	local slide = if drift then math.clamp((speed - tune.DriftMinSpeed) / 15, 0, 1) else 0
	acceleration -= speed * tune.DriftDrag * slide
	-- Steering tapers at speed, and reverses while backing up. No pivoting at rest.
	local turn = -steer * tune.Turn * math.clamp(speed / 18, -1, 1) / (1 + math.abs(speed) / 130)
	turn *= 1 + (tune.DriftTurn - 1) * slide
	local grip = tune.Grip + (tune.DriftGrip - tune.Grip) * slide
	return acceleration, -lateral * grip, turn
end

function Driving.approach(current: number, target: number, response: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-response * dt))
end

return Driving
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DrivingMetrics</string>
          <string name="Source"><![CDATA[--!strict
local Metrics = {}
export type State = {
	previous: number,
	accelerating: number?,
	zeroTo50: number?,
	brakeFrom: number?,
	brakeDistance: number,
	lastStop: number?,
	lastFrom: number?,
}
function Metrics.new(): State
	return {
		previous = 0,
		accelerating = nil,
		zeroTo50 = nil,
		brakeFrom = nil,
		brakeDistance = 0,
		lastStop = nil,
		lastFrom = nil,
	}
end
function Metrics.step(s: State, kmh: number, throttle: number, dt: number)
	if dt <= 0 or dt > 0.25 then
		s.previous = kmh
		return
	end
	if kmh < 1 and throttle <= 0 then
		s.accelerating = nil
	end
	if s.previous < 1 and throttle > 0 and not s.accelerating then
		s.accelerating = 0
	end
	if s.accelerating then
		s.accelerating += dt
		if kmh >= 50 then
			s.zeroTo50 = s.accelerating
			s.accelerating = nil
		end
	end
	if throttle < 0 and s.previous >= 10 and not s.brakeFrom then
		s.brakeFrom = s.previous
		s.brakeDistance = 0
	end
	if s.brakeFrom then
		s.brakeDistance += (s.previous + kmh) / 2 / 3.6 * dt
		if kmh < 1 then
			s.lastStop = s.brakeDistance
			s.lastFrom = s.brakeFrom
			s.brakeFrom = nil
		elseif throttle >= 0 then
			s.brakeFrom = nil
		end
	end
	s.previous = kmh
end
return Metrics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">GarageRules</string>
          <string name="Source"><![CDATA[--!strict
local GarageRules = {}
function GarageRules.canSelect(
	distance: number,
	speed: number,
	occupiedByOther: boolean,
	busy: boolean,
	now: number,
	nextAllowed: number
): boolean
	return distance <= 85 and speed <= 2 and not occupiedByOther and not busy and now >= nextAllowed
end
function GarageRules.canUseDoor(
	ownerId: number?,
	userId: number,
	distance: number,
	obstructed: boolean
): boolean
	return (ownerId == nil or ownerId == userId) and distance <= 16 and not obstructed
end
function GarageRules.damage(impactKmh: number): number
	return if impactKmh < 12 then 0 elseif impactKmh < 35 then 10 elseif impactKmh < 65 then 30 else 60
end
return GarageRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">GetawayRules</string>
          <string name="Source"><![CDATA[--!strict
-- Mission progression is decided by server samples, never client-reported results.
local Rules = {}
export type State = {
	phase: string,
	checkpoint: number,
	checkpoints: number,
	remaining: number,
	escape: number,
	busted: number,
	delivery: number,
	heat: number,
}
export type Sample = {
	valid: boolean,
	atCheckpoint: boolean,
	atHome: boolean,
	seen: boolean,
	nearCop: boolean,
	slow: boolean,
	stopped: boolean,
	policeReady: boolean,
}
function Rules.new(checkpoints: number, seconds: number, heat: number): State
	return {
		phase = "pickup",
		checkpoint = 1,
		checkpoints = checkpoints,
		remaining = seconds,
		escape = 0,
		busted = 0,
		delivery = 0,
		heat = heat,
	}
end
function Rules.active(s: State): boolean
	return s.phase == "pickup" or s.phase == "run" or s.phase == "escape" or s.phase == "deliver"
end
function Rules.recoverable(s: State): boolean
	return s.phase == "busted" or s.phase == "failed" or s.phase == "complete"
end
function Rules.step(s: State, dt: number, sample: Sample): string?
	if not Rules.active(s) then
		return nil
	end
	dt = math.clamp(dt, 0, 0.25)
	s.remaining = math.max(0, s.remaining - dt)
	if not sample.valid then
		s.phase = "failed"
		return "vehicle_lost"
	end
	if s.remaining <= 0 then
		s.phase = "failed"
		return "timeout"
	end
	if s.phase == "pickup" then
		if sample.atCheckpoint then
			s.checkpoint = 2
			s.phase = if s.checkpoints >= 2 then "run" else "escape"
			return "alarm"
		end
		return nil
	end
	s.busted = if sample.nearCop and sample.slow then s.busted + dt else math.max(0, s.busted - dt * 2)
	if s.busted >= 5 then
		s.phase = "busted"
		return "busted"
	end
	if s.phase == "run" then
		if sample.atCheckpoint then
			s.checkpoint += 1
			if s.checkpoint > s.checkpoints then
				s.phase = "escape"
			end
			return "checkpoint"
		end
	elseif s.phase == "escape" then
		s.escape = if sample.seen or not sample.policeReady then 0 else s.escape + dt
		if s.escape >= 10 then
			s.phase = "deliver"
			return "escaped"
		end
	elseif s.phase == "deliver" then
		if sample.seen then
			s.phase = "escape"
			s.escape = 0
			s.delivery = 0
			return "spotted"
		end
		s.delivery = if sample.atHome and sample.stopped then s.delivery + dt else 0
		if s.delivery >= 2 then
			s.phase = "complete"
			return "reward"
		end
	end
	return nil
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">HeadlightMath</string>
          <string name="Source"><![CDATA[--!strict
local HeadlightMath = {}
export type Tuning = {
	LowRange: number,
	HighRange: number,
	Angle: number,
	Brightness: number,
	FullBeamKmh: number,
}

function HeadlightMath.beam(kmh: number, tune: Tuning): (number, number, number)
	local blend = math.clamp(kmh / tune.FullBeamKmh, 0, 1)
	-- Smoothstep avoids sudden visible changes near the endpoints.
	blend = blend * blend * (3 - 2 * blend)
	return tune.LowRange + (tune.HighRange - tune.LowRange) * blend, tune.Angle, tune.Brightness
end

-- The native light has a short engine range. The road overlay provides a separate,
-- bounded driving preview; never smooth its position or delay its speed response.
export type RoadTuning = { RoadMinRange: number, RoadMaxRange: number, PreviewSeconds: number }
function HeadlightMath.roadReach(studsPerSecond: number, tune: RoadTuning): number
	return math.clamp(
		tune.RoadMinRange + math.abs(studsPerSecond) * tune.PreviewSeconds,
		tune.RoadMinRange,
		tune.RoadMaxRange
	)
end
function HeadlightMath.sampleDistance(reach: number, step: number, steps: number): number
	-- Concentrate samples near the bumper, including when an obstacle shortens the beam.
	return math.max(0, reach) * (math.clamp(step / steps, 0, 1) ^ 2)
end
-- Rendered asphalt/paint is above the collidable terrain on this authored flat map.
HeadlightMath.SurfaceLift = 0.4
return HeadlightMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">HighwayMath</string>
          <string name="Source"><![CDATA[--!strict
local HighwayMath = {}

function HighwayMath.wrap(z: number, halfLength: number): number
	return (z + halfLength) % (2 * halfLength) - halfLength
end

function HighwayMath.needed(
	positions: { number },
	length: number,
	radius: number,
	halfLength: number
): { [number]: boolean }
	local result: { [number]: boolean } = {}
	local function add(z: number)
		local center = math.floor(-z / length)
		for index = center - radius, center + radius do
			result[index] = true
		end
	end
	for _, z in positions do
		z = HighwayMath.wrap(z, halfLength)
		add(z)
		-- Prefetch the other side of the recycle point BEFORE a car reaches it.
		if z < -halfLength + length * radius then
			add(z + 2 * halfLength)
		end
		if z > halfLength - length * radius then
			add(z - 2 * halfLength)
		end
	end
	return result
end

function HighwayMath.travel(previousZ: number, nextZ: number, halfLength: number, maxTravel: number): number
	local delta = math.abs(HighwayMath.wrap(nextZ - previousZ, halfLength))
	return if delta <= maxTravel then delta else 0
end

return HighwayMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">LapRules</string>
          <string name="Source"><![CDATA[--!strict
local Lap = {}
export type State = { previous: number?, travel: number, time: number, direction: number }
function Lap.new(): State
	return { previous = nil, travel = 0, time = 0, direction = 0 }
end
function Lap.step(s: State, progress: number, length: number, dt: number, valid: boolean): (boolean, number)
	if not valid then
		s.previous = nil
		s.travel = 0
		s.time = 0
		s.direction = 0
		return false, 0
	end
	local before = s.previous
	s.previous = progress
	if not before then
		return false, 0
	end
	local delta = (progress - before + length / 2) % length - length / 2
	if math.abs(delta) > 500 * math.clamp(dt, 0, 0.25) + 3 then
		s.previous = nil
		s.travel = 0
		s.time = 0
		s.direction = 0
		return false, 0
	end
	if s.direction == 0 and math.abs(delta) > 0.1 then
		s.direction = math.sign(delta)
	end
	s.time += math.clamp(dt, 0, 0.25)
	s.travel = math.max(0, s.travel + delta * s.direction)
	if s.travel >= length then
		local seconds = s.time
		s.travel = 0
		s.time = 0
		s.direction = 0
		return true, seconds
	end
	return false, 0
end
return Lap
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MissionVariants</string>
          <string name="Source"><![CDATA[--!strict
-- Extra mission rules consume server-observed damage and checkpoint events only.
local Variants = {}
export type State = {
	mode: string,
	quality: number,
	damage: number,
	collected: number,
	choice: boolean,
	deadline: number,
	heat: number,
}
function Variants.new(mode: string, damage: number, heat: number): State
	return {
		mode = mode,
		quality = 100,
		damage = damage,
		collected = 0,
		choice = false,
		deadline = 0,
		heat = heat,
	}
end
function Variants.damage(s: State, damage: number)
	if damage ~= damage then
		return
	end
	local delta = math.max(0, damage - s.damage)
	s.damage = math.max(s.damage, damage)
	if s.mode == "cargo" and s.collected > 0 then
		s.quality = math.max(0, s.quality - delta * 2)
	end
end
function Variants.pickup(s: State, more: boolean, now: number)
	s.collected += 1
	if s.mode == "heat" then
		s.choice = more
		s.deadline = now + 12
	end
end
function Variants.choose(s: State, choice: string): boolean
	if not s.choice or (choice ~= "bank" and choice ~= "continue") then
		return false
	end
	s.choice = false
	if choice == "continue" then
		s.heat = math.min(3, s.heat + 1)
	end
	return true
end
function Variants.base(s: State, base: number): number
	return if s.mode == "heat" then base * math.max(1, s.collected) else base
end
function Variants.payout(s: State, amount: number): number
	return math.floor(math.max(0, amount) * (if s.mode == "cargo" then s.quality / 100 else 1))
end
return Variants
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ModelFit</string>
          <string name="Source"><![CDATA[--!strict
local ModelFit = {}

-- ScaleTo scales positions about the model pivot, not about the world origin.
-- Apply exactly that transform before the final chassis-centering translation.
function ModelFit.coordinate(position: number, pivot: number, scale: number, offset: number): number
	return pivot + (position - pivot) * scale - offset
end

return ModelFit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PerformanceSamples</string>
          <string name="Source"><![CDATA[--!strict
local Samples = {}
function Samples.percentile(values: { number }, fraction: number): number
	if #values == 0 then
		return 0
	end
	local sorted = table.clone(values)
	table.sort(sorted)
	return sorted[math.clamp(math.ceil(#sorted * fraction), 1, #sorted)]
end
return Samples
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">PoliceTactics</string>
          <string name="Source"><![CDATA[--!strict
local Nav = require("./RoadNavigation")
local Tactics = {}
function Tactics.target(graph: Nav.Graph, last: Nav.Point, velocity: Nav.Point, role: string): Nav.Point
	local lead = if role == "intercept" then 3 else 0
	local speed = math.sqrt(velocity.x ^ 2 + velocity.z ^ 2)
	local scale = if speed > 0 then math.min(lead, 180 / speed) else 0
	local projected = Nav.project(graph, { x = last.x + velocity.x * scale, z = last.z + velocity.z * scale })
	return projected
end
function Tactics.spawnSafe(distance: number, visible: boolean, occupied: boolean): boolean
	return distance >= 180 and not visible and not occupied
end
return Tactics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ProfileRules</string>
          <string name="Source"><![CDATA[--!strict
-- Serializable player data and lease rules, also exercised without Roblox services.
local Rules = {}
export type Profile = {
	version: number,
	cash: number,
	wins: number,
	selected: string,
	upgrades: { [string]: { [string]: number } },
	discoveries: { [string]: boolean },
	cosmetics: { [string]: boolean },
	equipped: { [string]: { [string]: string } },
	laps: number,
	bestLap: number,
}
export type Record = { data: Profile, owner: string, expires: number, revision: number }
local kinds =
	{ Sport = true, Pickup = true, Electric = true, Compact = true, Coupe = true, Interceptor = true }
function Rules.new(): Profile
	return {
		version = 1,
		cash = 0,
		wins = 0,
		selected = "Electric",
		upgrades = {},
		discoveries = {},
		cosmetics = {},
		equipped = {},
		laps = 0,
		bestLap = 0,
	}
end
local function number(value: any, maximum: number): boolean
	return type(value) == "number" and value == value and value >= 0 and value <= maximum
end
function Rules.decode(value: any): Profile?
	if
		type(value) ~= "table"
		or value.version ~= 1
		or not number(value.cash, 100000000)
		or not number(value.wins, 1000000)
		or not kinds[value.selected]
	then
		return nil
	end
	if
		type(value.upgrades) ~= "table"
		or type(value.discoveries) ~= "table"
		or type(value.cosmetics) ~= "table"
		or type(value.equipped) ~= "table"
	then
		return nil
	end
	for kind, levels in value.upgrades do
		if not kinds[kind] or type(levels) ~= "table" then
			return nil
		end
		for key, level in levels do
			if
				not table.find({ "Power", "Brakes", "Tyres", "Suspension" }, key)
				or not number(level, 3)
				or level % 1 ~= 0
			then
				return nil
			end
		end
	end
	for key, flag in value.discoveries do
		if type(key) ~= "string" or type(flag) ~= "boolean" then
			return nil
		end
	end
	for key, flag in value.cosmetics do
		if type(key) ~= "string" or type(flag) ~= "boolean" then
			return nil
		end
	end
	for kind, items in value.equipped do
		if not kinds[kind] or type(items) ~= "table" then
			return nil
		end
		for key, item in items do
			if
				not table.find({ "Paint", "Wheels", "Interior" }, key)
				or type(item) ~= "string"
				or #item > 40
			then
				return nil
			end
		end
	end
	if not number(value.laps, 1000000) or not number(value.bestLap, 86400) then
		return nil
	end
	return value :: Profile
end
function Rules.acquire(old: any, token: string, now: number): Record?
	if old == nil then
		return { data = Rules.new(), owner = token, expires = now + 180, revision = 0 }
	end
	if
		type(old) ~= "table"
		or not Rules.decode(old.data)
		or type(old.owner) ~= "string"
		or not number(old.expires, 1e12)
		or not number(old.revision, 1e12)
	then
		return nil
	end
	if old.owner ~= "" and old.owner ~= token and old.expires > now then
		return nil
	end
	return { data = old.data, owner = token, expires = now + 180, revision = old.revision }
end
function Rules.commit(old: any, token: string, now: number, data: Profile, release: boolean): Record?
	if
		type(old) ~= "table"
		or old.owner ~= token
		or not number(old.revision, 1e12)
		or not Rules.decode(data)
	then
		return nil
	end
	return {
		data = data,
		owner = if release then "" else token,
		expires = if release then 0 else now + 180,
		revision = old.revision + 1,
	}
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
local Progression = {}
export type Levels = { Power: number, Brakes: number, Tyres: number, Suspension: number }
Progression.Catalog = {
	{
		Id = "Power",
		Name = "Powertrain",
		Prices = { 500, 1100, 2200 },
		Effect = "Each level: +12% acceleration, +5% top speed",
	},
	{
		Id = "Brakes",
		Name = "Brakes",
		Prices = { 350, 800, 1600 },
		Effect = "Each level: +18% braking force",
	},
	{
		Id = "Tyres",
		Name = "Performance tyres",
		Prices = { 450, 950, 1900 },
		Effect = "Each level: +12% corner grip, +8% sliding grip",
	},
	{
		Id = "Suspension",
		Name = "Suspension",
		Prices = { 400, 900, 1800 },
		Effect = "Each level: +8% spring rate, +16% damping",
	},
}
Progression.Difficulties = {
	{ Id = "light", Name = "Light", Traffic = 6, Multiplier = 1 },
	{ Id = "busy", Name = "Busy", Traffic = 12, Multiplier = 1.5 },
	{ Id = "rush", Name = "Rush hour", Traffic = 18, Multiplier = 2.2 },
}
function Progression.levels(): Levels
	return { Power = 0, Brakes = 0, Tyres = 0, Suspension = 0 }
end
function Progression.difficulty(id: any): typeof(Progression.Difficulties[1])?
	for _, d in Progression.Difficulties do
		if d.Id == id then
			return d
		end
	end
	return nil
end
function Progression.price(levels: Levels, id: string): number?
	for _, upgrade in Progression.Catalog do
		if upgrade.Id == id then
			return upgrade.Prices[(levels :: any)[id] + 1]
		end
	end
	return nil
end
function Progression.buy(
	cash: number,
	levels: Levels,
	id: string,
	atWorkshop: boolean,
	onJob: boolean
): (number, string)
	if not atWorkshop or onJob then
		return cash, "Stop at home after your job to fit upgrades."
	end
	local price = Progression.price(levels, id)
	if not price then
		return cash, "Upgrade unavailable or already at level 3."
	end
	if cash < price then
		return cash, "Need $" .. (price - cash) .. " more."
	end
	(levels :: any)[id] += 1
	return cash - price, "Installed " .. id .. " level " .. (levels :: any)[id] .. "."
end
function Progression.factors(levels: Levels)
	return {
		Acceleration = 1 + 0.12 * levels.Power,
		TopSpeed = 1 + 0.05 * levels.Power,
		Brake = 1 + 0.18 * levels.Brakes,
		Grip = 1 + 0.12 * levels.Tyres,
		DriftGrip = 1 + 0.08 * levels.Tyres,
		Spring = 1 + 0.08 * levels.Suspension,
		Damping = 1 + 0.16 * levels.Suspension,
	}
end
function Progression.payout(base: number, seconds: number, difficulty: string, damage: number): number
	local d = Progression.difficulty(difficulty)
	if not d then
		return 0
	end
	return math.floor(
		(base + math.max(0, math.floor(seconds)) * 2) * d.Multiplier * (if damage == 0 then 1.2 else 1)
	)
end
function Progression.spring(
	rest: number,
	distance: number,
	verticalSpeed: number,
	gravity: number,
	rate: number,
	damping: number,
	dt: number?
): number
	local step = math.clamp(dt or 0, 0, 0.1)
	-- Implicit spring/damper response keeps four supports stable at low update rates.
	local response = ((rest - distance) * rate - verticalSpeed * damping)
		/ (1 + 4 * damping * step + 4 * rate * step * step)
	return math.clamp(gravity / 4 + response, 0, gravity)
end
return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
